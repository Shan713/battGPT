  <rdf:Description rdf:about="https://w3id.org/emmo#Mole">
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4607"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e501069c_34d3_4dc7_ac87_c90c7342192b"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45"/>
