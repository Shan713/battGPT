    <rdfs:label xml:lang="en">Determiner</rdfs:label>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An 'interpreter' that perceives another 'entity' (the 'object') through a specific perception mechanism and produces a 'property' (the 'sign') that stands for the result of that particular perception.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
