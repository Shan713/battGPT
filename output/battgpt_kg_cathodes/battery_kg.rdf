    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4073"/>
    <skos:prefLabel xml:lang="en">MeasurementResult</skos:prefLabel>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A measurement result generally contains “relevant information” about the set of measured quantity properties, such that some may be more representative of the measured quantity than others. This may be expressed in the form of a probability density function (pdf).</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A measurement result has the measured quantity, measurement uncertainty and other relevant attributes as holistic parts.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:comment xml:lang="en">Result of a measurement.

A set of quantity values being attributed to a measurand (quantity) together with any other available relevant information, like measurement uncertainty.

-- VIM</rdfs:comment>
    <rdfs:label xml:lang="en">MeasurementResult</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6 xml:lang="en">measurement result</emmo:EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6>
