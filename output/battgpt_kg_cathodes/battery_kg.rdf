    <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae"/>
    <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf"/>
  </rdf:Description>
