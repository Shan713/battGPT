    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An 'equation' that stands for a physical assumption specific to a material, and provides an expression for a 'physics_quantity' (the dependent variable) as function of other variables, physics_quantity or data (independent variables).</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:prefLabel xml:lang="en">MaterialRelation</skos:prefLabel>
    <skos:example xml:lang="en">The Lennard-Jones potential.
A force field.
An Hamiltonian.</skos:example>
  </rdf:Description>
