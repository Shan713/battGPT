  <rdf:Description rdf:about="https://w3id.org/emmo#SquareDegree">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_6f4d704a_a7c6_4c07_b8a7_ea0bab04128f"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb3223"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb3222"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_ac19c801_bead_4730_8b8c_50020eec45ec"/>
    <rdfs:comment xml:lang="en">A square degree is a non-SI unit measure of solid angle. It is denoted in various ways, including deg, sq. deg. and °². Just as degrees are used to measure parts of a circle, square degrees are used to measure parts of a sphere. Analogous to one degree being equal to π /180 radians, a square degree is equal to (π /180) or about 1/3283 steradian. The number of square degrees in a whole sphere is or approximately 41 253 deg. This is the total area of the 88 constellations in the list of constellations by area. For example, observed from the surface of the Earth, the Moon has a diameter of approximately 0.5°, so it covers a solid angle of approximately 0.196 deg, which is 4.8 × 10 of the total sky sphere.

-- QUDT</rdfs:comment>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedunits#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">°²</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <rdfs:label xml:lang="en">SquareDegree</rdfs:label>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deg2</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <skos:prefLabel xml:lang="en">SquareDegree</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A square degree is a non-SI unit measure of solid angle. It is denoted in various ways, including deg, sq. deg. and °². Just as degrees are used to measure parts of a circle, square degrees are used to measure parts of a sphere. Analogous to one degree being equal to π /180 radians, a square degree is equal to (π /180) or about 1/3283 steradian. The number of square degrees in a whole sphere is or approximately 41 253 deg. This is the total area of the 88 constellations in the list of constellations by area. For example, observed from the surface of the Earth, the Moon has a diameter of approximately 0.5°, so it covers a solid angle of approximately 0.196 deg, which is 4.8 × 10 of the total sky sphere.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/DEG2</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <skos:altLabel xml:lang="en">Square degree</skos:altLabel>
  </rdf:Description>
