  <rdf:Description rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb5081">
    <skos:example xml:lang="en">The electronical state of the RAM of my laptop is decoded by it as ASCII characters and printed on the screen.</skos:example>
    <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
    <owl:annotatedTarget xml:lang="en">We call "decoding" the act of recognise the variation according to a particular rule and generate another equivalent schema (e.g. in the agent's cognitive apparatus, as another form of data).
We call "interpreting" the act of providing semantic meaning to data, which is covered by the semiotic perspective.</owl:annotatedTarget>
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_3e7add3d_e6ed_489a_a796_8e31fef9b490"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
