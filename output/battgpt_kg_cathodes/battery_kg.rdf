  <rdf:Description rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b5080">
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIN 8590 Berichtigung 1:2004-02</rdfs:seeAlso>
    <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A manufacturing process in which metallic material is anodically dissolved under the influence of an electric current and an electrolyte solution. The current flow can be caused either by connection to an external current source or due to local element formation on the workpiece (etching).</owl:annotatedTarget>
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_b8ce01a5_1e0c_4c69_8e54_7235fd4fe47e"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
