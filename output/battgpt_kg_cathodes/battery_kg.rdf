    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_4b2c223f_89fb_4407_b1b6_24774b7fe770"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/W-PER-M2-K</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <skos:prefLabel xml:lang="en">WattPerSquareMetreKelvin</skos:prefLabel>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W.m-2.K-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">`Watt Per Square Meter Per Kelvin `(W m⁻² K⁻¹) is a unit in the category of Thermal heat transfer coefficient. It is also known as watt/square meter-kelvin. This unit is commonly used in the SI unit system. Watt Per Square Meter Per Kelvin (W m⁻² K⁻¹) has a dimension of MT⁻¹Q⁻¹ where M is mass, T is time, and Q is temperature. This unit is the standard SI unit in this category.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:altLabel xml:lang="en">Watt per Square Metre Kelvin</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">WattPerSquareMetreKelvin</rdfs:label>
    <rdfs:comment xml:lang="en">`Watt Per Square Meter Per Kelvin `(W m⁻² K⁻¹) is a unit in the category of Thermal heat transfer coefficient. It is also known as watt/square meter-kelvin. This unit is commonly used in the SI unit system. Watt Per Square Meter Per Kelvin (W m⁻² K⁻¹) has a dimension of MT⁻¹Q⁻¹ where M is mass, T is time, and Q is temperature. This unit is the standard SI unit in this category.

-- QUDT</rdfs:comment>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W/(m²⋅K)</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  </rdf:Description>
