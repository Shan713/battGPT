  <rdf:Description rdf:about="https://w3id.org/emmo#Coulomb">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4773"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_ab79e92b_5377_454d_be06_d61b50db295a"/>
