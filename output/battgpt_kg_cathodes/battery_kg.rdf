  <rdf:Description rdf:about="https://w3id.org/emmo#JoulePerCubicMetre">
    <skos:prefLabel xml:lang="en">JoulePerCubicMetre</skos:prefLabel>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J/m³</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
