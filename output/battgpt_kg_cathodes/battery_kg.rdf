    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_3cb55500_dc5b_4586_bbf3_1d4158afac35"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
    <rdfs:comment xml:lang="en">`Kilocalorie per Mole Degree Celsius` is a unit for 'Molar Heat Capacity' expressed as kcal/(mol-degC).

-- QUDT</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kcal/(mol⋅°C)</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
