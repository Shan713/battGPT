  <rdf:Description rdf:about="https://w3id.org/emmo#CoulombPerCubicMetre">
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/C-PER-M3</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:label xml:lang="en">CoulombPerCubicMetre</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4343"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8f36559a_a494_4b00_abc5_60bbc1475009"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4344"/>
