  <rdf:Description rdf:about="https://w3id.org/emmo#PlanckPower">
    <skos:prefLabel xml:lang="en">PlanckPower</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c8d084ad_f88e_4596_8e4d_982c6655ce6f"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
