    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">GaugeBoson</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_f68030be_94b8_4c61_a161_886468558054">
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">In EMMO FOL this is a defined property. In OWL spatial relations are primitive.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <skos:altLabel xml:lang="en">hasSpatialIntegralPart</skos:altLabel>
    <skos:prefLabel xml:lang="en">hasSpatialSlice</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A relation that identify a proper part of the whole that extends itself in time along the overall lifetime of the whole, and whose parts never cover the full spatial extension of the 4D whole.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:comment xml:lang="en">A relation that identify a proper part of the whole that extends itself in time along the overall lifetime of the whole, and whose parts never cover the full spatial extension of the 4D whole.</rdfs:comment>
