    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole is proper part of an entity of that type.</rdfs:comment>
  </rdf:Description>
