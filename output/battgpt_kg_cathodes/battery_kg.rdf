    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b2976"/>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Planck_power?oldid=493642483</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <rdfs:label xml:lang="en">PlanckPower</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <rdfs:comment xml:lang="en">The Planck energy divided by the Planck time is the Planck power Pₚ , equal to about 3.62831 × 10⁵² W. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the order of 1 × 10⁴⁵ W, less than one ten-millionth of the Planck power.

-- QUDT</rdfs:comment>
    <skos:altLabel xml:lang="en">Planck Power</skos:altLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The Planck energy divided by the Planck time is the Planck power Pₚ , equal to about 3.62831 × 10⁵² W. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the order of 1 × 10⁴⁵ W, less than one ten-millionth of the Planck power.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PlanckPower</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pₚ</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  </rdf:Description>
