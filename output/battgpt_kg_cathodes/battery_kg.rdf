  <rdf:Description rdf:about="https://w3id.org/emmo#Btu_Th_Per_Ft3">
    <skos:prefLabel xml:lang="en">Btu_Th_Per_Ft3</skos:prefLabel>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.translatorscafe.com/cafe/EN/units-converter/fuel-efficiency--volume/c/</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
