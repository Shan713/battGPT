    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b4816"/>
    <rdfs:label xml:lang="en">Conventional</rdfs:label>
    <rdfs:comment xml:lang="en">A 'Sign' that stands for an 'Object' through convention, norm or habit, without any resemblance to it.</rdfs:comment>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A 'Sign' that stands for an 'Object' through convention, norm or habit, without any resemblance to it.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
