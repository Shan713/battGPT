  <rdf:Description rdf:about="https://w3id.org/emmo#CoulombMetre">
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C⋅m</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It is also known as atomic unit, u.a., au, ua. This unit is commonly used in the SI unit system. Coulomb Meter (C-m) has a dimension of LTI where L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:label xml:lang="en">CoulombMetre</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb328"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb329"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8515e948_bc2f_423b_8025_e4830f2b21dd"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Coulomb Meter (C-m) is a unit in the category of Electric dipole moment. It is also known as atomic unit, u.a., au, ua. This unit is commonly used in the SI unit system. Coulomb Meter (C-m) has a dimension of LTI where L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <schema:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A26</schema:unitCode>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
    <skos:prefLabel xml:lang="en">CoulombMetre</skos:prefLabel>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C.m</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://qudt.org/vocab/unit/C-M</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:comment xml:lang="en">Coulomb Meter (C-m) is a unit in the category of Electric dipole moment. It is also known as atomic unit, u.a., au, ua. This unit is commonly used in the SI unit system. Coulomb Meter (C-m) has a dimension of LTI where L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</rdfs:comment>
