  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_4c1f58cd_6e2c_48fb_8098_1cbb762abb05">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_4db521a3_f80f_436b_b9c7_e4b52b1383ea"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">MetallicMaterial</skos:prefLabel>
    <rdfs:comment xml:lang="en">Inorganic substance, consisting of one or more metallic elements.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Inorganic substance, consisting of one or more metallic elements.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">MetallicMaterial</rdfs:label>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Metallic materials are known for their shiny luster, excellent electrical/thermal conductivity, malleability (shapable by hammering), and ductility (can be drawn into wires), due to metallic bonding (shared electrons); they often form alloys (like steel from iron/carbon) to enhance these properties for diverse applications.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  </rdf:Description>
