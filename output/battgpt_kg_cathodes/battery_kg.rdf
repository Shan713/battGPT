    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M⊕</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <skos:prefLabel xml:lang="en">EarthMass</skos:prefLabel>
    <rdfs:label xml:lang="en">EarthMass</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/specialunits#"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Earth mass (M⊕) is the unit of mass equal to that of the Earth. In SI Units, 1 M⊕ = 5.9722 × 10²⁴ kg. Earth mass is often used to describe masses of rocky terrestrial planets. The four terrestrial planets of the Solar System, Mercury, Venus, Earth, and Mars, have masses of 0.055, 0.815, 1.000, and 0.107 Earth masses respectively.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Earth_mass?oldid=495457885</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <skos:altLabel xml:lang="en">Earth mass</skos:altLabel>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/EarthMass</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:comment xml:lang="en">Earth mass (M⊕) is the unit of mass equal to that of the Earth. In SI Units, 1 M⊕ = 5.9722 × 10²⁴ kg. Earth mass is often used to describe masses of rocky terrestrial planets. The four terrestrial planets of the Solar System, Mercury, Venus, Earth, and Mars, have masses of 0.055, 0.815, 1.000, and 0.107 Earth masses respectively.

-- QUDT</rdfs:comment>
