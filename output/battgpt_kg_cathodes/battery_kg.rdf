    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example xml:lang="en">A molecule, including a photon emitted (or captured) as result of a de-excitation (or excitation) process.</skos:example>
    <skos:example xml:lang="en">The formation of an hydrogen atom from a proton and electron.</skos:example>
