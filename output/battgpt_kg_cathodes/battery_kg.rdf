    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A datatype for a specifying a physcial quantity as a string consisting of a numerical, a separator and an SI unit.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:example xml:lang="en">A more complete example showing how to specify the value of a physical quantity in turtle using this datatype:

    height1 a emmo:Height ;
        hasSIQuantityValue "3 cm"^^emmo:SIQuantityDatatype .</skos:example>
    <skos:example xml:lang="en">"3 cm"</skos:example>
  </rdf:Description>
