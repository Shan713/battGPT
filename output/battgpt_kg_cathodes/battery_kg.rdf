  <rdf:Description rdf:about="https://w3id.org/emmo#KiloMetre">
    <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KiloMetre</skos:prefLabel>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">km</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
