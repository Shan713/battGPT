    <rdfs:label xml:lang="en">FootPoundForcePerMinute</rdfs:label>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[ft_i].[lbf_av].min-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
