  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_348d39f7_6a17_49d1_9860_9b33b69b51de">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Source code (also referred to as source or code) is the version of software as it is originally written (i.e., typed into a computer) by a human in plain text (i.e., human readable alphanumeric characters).</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A source code is the companion of an application, being it the entity used to generate the application list of CPU executable instructions.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9ffffb55_3496_4307_82b8_a0d78fe1fcd8"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8681074a_e225_4e38_b586_e85b0f43ce38"/>
    <rdfs:comment xml:lang="en">A programming language entity expressing a formal detailed plan of what a software is intended to do.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/computerscience#"/>
    <skos:prefLabel xml:lang="en">SourceCode</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A programming language entity expressing a formal detailed plan of what a software is intended to do.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">SourceCode</rdfs:label>
  </rdf:Description>
