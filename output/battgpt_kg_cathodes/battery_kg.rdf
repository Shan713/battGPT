  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_4f2d1fcc_e20c_4479_9ad7_7a0480dd3e44">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An icon that represents the internal logical structure of the object.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:example xml:lang="en">A physics equation is replicating the mechanisms internal to the object.</skos:example>
    <skos:example xml:lang="en">Electrical diagram is diagrammatic and resemblance</skos:example>
    <skos:example xml:lang="en">MODA and CHADA are diagrammatic representation of a simulation or a characterisation workflow.</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">AnalogicalIcon</skos:prefLabel>
    <rdfs:comment xml:lang="en">An icon that represents the internal logical structure of the object.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_d7788d1a_020d_4c78_85a1_13563fcec168"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The subclass of icon inspired by Peirceian category (b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy (with the same logic) the relations in something (e.g. math formula, geometric flowchart).</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">An icon that focus on HOW the object works.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:label xml:lang="en">AnalogicalIcon</rdfs:label>
  </rdf:Description>
