  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The most fundamental unity criterion for the definition of an structure is that:
- is made of at least two quantums (a structure is not a simple entity)
- all quantum parts form a causally connected graph</rdfs:comment>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The class of individuals representing causally self-connected world entities.</rdfs:comment>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The disjoint union of Causal Path and CausalSystem classes.</rdfs:comment>
    <skos:prefLabel xml:lang="en">CausalStructure</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The most fundamental unity criterion for the definition of an structure is that:
- is made of at least two quantums (a structure is not a simple entity)
- all quantum parts form a causally connected graph</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">CausalStructure</rdfs:label>
    <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: CausalPath or CausalSystem</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A causal structure expresses itself in time and space thanks to the underlying causality relations between its constituent quantum entities. It must at least provide two temporal parts. The unity criterion beyond the definition of a causal structure (the most general concept of structure) is the existence of an undirected causal path between each of its parts.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The disjoint union of Causal Path and CausalSystem classes.</emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_53ed8611_2cd7_4286_9ef0_36572117b963"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The class of individuals representing causally self-connected world entities.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  </rdf:Description>
