  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352">
    <skos:prefLabel xml:lang="en">Substance</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_57d977ab_0036_4779_b59a_e47620afdb9c"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_41cecfc2_bb6b_45f3_b6cc_e7740d931afe"/>
    <rdfs:comment xml:lang="en">A matter entity characterised by the fact that it possesses some homogeneous properties or identification criteria.</rdfs:comment>
    <rdfs:label xml:lang="en">Substance</rdfs:label>
    <skos:example xml:lang="en">A pen can be classified as a substance (although it has parts with different properties) since it can be identified as being solid.</skos:example>
    <skos:example xml:lang="en">A litre of water.</skos:example>
    <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disjoint Union Of: MesoscopicSubstance, ContinuumSubstance</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A matter entity characterised by the fact that it possesses some homogeneous properties or identification criteria.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
