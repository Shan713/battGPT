  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with "condensed" phases of matter: systems of many constituents with strong interactions between them.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    <skos:prefLabel xml:lang="en">CondensedMatter</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_b9695e87_8261_412e_83cd_a86459426a28"/>
    <owl:equivalentClass rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b4262"/>
    <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equivalent To: Liquid or Solid</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
    <rdfs:label xml:lang="en">CondensedMatter</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with "condensed" phases of matter: systems of many constituents with strong interactions between them.</rdfs:comment>
  </rdf:Description>
