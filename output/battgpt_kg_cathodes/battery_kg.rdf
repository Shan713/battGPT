    <rdfs:label xml:lang="en">MaterialTreatment</rdfs:label>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">esce workpiece</rdfs:comment>
    <rdfs:comment xml:lang="en">The processing of a material aimed to transform its structure by means of any type of treatment, without involving relevant synthesis phenomena.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Has shaped bodies as input and output.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manufacturing by changing the properties of the material of which a workpiece is made, which is done, among other things, by changes in the submicroscopic or atomic range, e.g. by diffusion of atoms, generation and movement of dislocations in the atomic lattice or chemical reactions, and where unavoidable changes in shape are not part of the essence of these processes.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_a4d66059_5dd3_4b90_b4cb_10960559441b"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_71d1c8f0_c6e3_44b5_a4b6_1b74ff35698a"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The processing of a material aimed to transform its structure by means of any type of treatment, without involving relevant synthesis phenomena.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:prefLabel xml:lang="en">MaterialTreatment</skos:prefLabel>
    <rdfs:seeAlso xml:lang="en">DIN 8580:2020</rdfs:seeAlso>
  </rdf:Description>
