  <rdf:Description rdf:about="https://w3id.org/emmo#BtuPerPoundDegreeFahrenheit">
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[Btu_IT].[lb_av]-1.[degF]-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[Btu_IT]/([lb_av].[degF])</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_08b308d4_31cd_4779_a784_aa92fc730f39"/>
