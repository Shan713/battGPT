    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en">Characterisation</skos:altLabel>
    <skos:example xml:lang="en">Assigning the word "red" as sign for an object provides an information to all other interpreters about the outcome of a specific observation procedure according to the determiner.</skos:example>
    <rdfs:label xml:lang="en">Determination</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
