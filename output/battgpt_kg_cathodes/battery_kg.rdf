    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_53bd0c90_41c3_46e2_8779_cd2a80f7e18b"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb2600"/>
    <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NewtonPerSquareMetre</skos:prefLabel>
    <skos:altLabel xml:lang="en">Newtons Per Square Metre</skos:altLabel>
    <rdfs:comment xml:lang="en">The SI unit of pressure. The pascal is the standard pressure unit in the MKS metric system, equal to one newton per square meter or one "kilogram per meter per second per second." The unit is named for Blaise Pascal (1623-1662), French philosopher and mathematician, who was the first person to use a barometer to measure differences in altitude.

-- QUDT</rdfs:comment>
