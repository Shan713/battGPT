  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_9b52133b_8f6c_47fb_93f1_419071db3f4b">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An intentional agent that takes part in driving a process without being a group.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/agency#"/>
    <rdfs:isDefinedBy rdf:resource="https://plato.stanford.edu/entries/agency/#OthKinAgeMenShaColRelArt"/>
    <rdfs:comment xml:lang="en">An intentional agent that takes part in driving a process without being a group.</rdfs:comment>
    <rdfs:label xml:lang="en">SharedAgent</rdfs:label>
    <skos:example xml:lang="en">Singing a song together with others.
Carrying a piece of furniture together with others.</skos:example>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_7a317af2_d2f7_4e8a_8fbd_aaebfb7d21cc"/>
    <skos:prefLabel xml:lang="en">SharedAgent</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_a9891fff_fa7a_4806_b7bd_786de7358e8d">
    <skos:example xml:lang="en">The W boson decays, where a single W boson decays in two particles such as electron and electron antineutrino, or quark and antiquark.</skos:example>
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A decay is a fundamental process occurring to one particle that is expressed as a complete bipartite directed graph K(1,n) with n&gt;1, being n the number of outgoing particles.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    <rdfs:label xml:lang="en">Decay</rdfs:label>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of fundamental systems where a particle generates two or more other particles.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The class of fundamental systems where a particle generates two or more other particles.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decay is a fundamental process occurring to one particle that is expressed as a complete bipartite directed graph K(1,n) with n&gt;1, being n the number of outgoing particles.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/standardmodel#"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_43a4e80d_6ae9_45ed_8cfb_fd0a5339bf87"/>
    <skos:prefLabel xml:lang="en">Decay</skos:prefLabel>
  </rdf:Description>
