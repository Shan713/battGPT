    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">SI unit for electric potential difference.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <schema:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VLT</schema:unitCode>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Volt?oldid=494812083</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.V06634</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The volt is the unit of electric potential difference—electric potential difference is also known as voltage. The size of 1 volt is officially defined as the potential difference between two points of a wire carrying a current of 1 ampere when the power dissipated in the wire is 1 watt.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/V</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits#"/>
    <rdfs:comment xml:lang="en">SI unit for electric potential difference.</rdfs:comment>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Volt</rdfs:label>
  </rdf:Description>
