  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_12b2ec1e_fb89_468a_a51d_97c2a6db297c">
    <rdfs:label xml:lang="en">IonActivity</rdfs:label>
    <rdfs:comment xml:lang="en">Normally a standard solution is a solution of the ion at a molality of 1 mol/kg (exactly). Standardized conditions are normally 1013,25 hPa and 25 °C.</rdfs:comment>
    <rdfs:comment xml:lang="en">ratio of the product of ion molality b and a correction factor γ to the molality b° of the same ion in a standard solution under standardized conditions: a = bγ / b°.</rdfs:comment>
    <rdfs:comment xml:lang="en">The correction factor is called activity coefficient and it is determined experimentally. See ActivityCoefficient</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_125e8614_0dad_4c04_9ac9_03317e63beec"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">ratio of the product of ion molality b and a correction factor γ to the molality b° of the same ion in a standard solution under standardized conditions: a = bγ / b°.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
    <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-01-20</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
    <skos:prefLabel xml:lang="en">IonActivity</skos:prefLabel>
  </rdf:Description>
