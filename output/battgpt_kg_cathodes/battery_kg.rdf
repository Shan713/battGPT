    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ph</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
