  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_c130614a_2985_476d_a7ed_8a137847703c">
    <skos:prefLabel xml:lang="en">IntentionalAgent</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An agent that is driven by the intention to reach a defined objective in driving a process.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:seeAlso rdf:resource="https://plato.stanford.edu/entries/agency"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Intentionality is not limited to human agents, but in general to all agents that have the capacity to decide to act in driving a process according to a motivation.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4476"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_2480b72b_db8d_460f_9a5f_c2912f979046"/>
    <rdfs:comment xml:lang="en">An agent that is driven by the intention to reach a defined objective in driving a process.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
    <rdfs:label xml:lang="en">IntentionalAgent</rdfs:label>
  </rdf:Description>
