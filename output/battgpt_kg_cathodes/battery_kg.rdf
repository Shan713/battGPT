  <rdf:Description rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4191">
    <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_9380ab64_0363_4804_b13f_3a8a94119a76"/>
