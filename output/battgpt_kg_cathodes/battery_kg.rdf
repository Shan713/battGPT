  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_dd4a7f3e_ef56_466c_ac1a_d2716b5f87ec">
    <rdfs:comment xml:lang="en">Subclasses of 'ObjectiveProperty' classify objects according to the type semiosis that is used to connect the property to the object (e.g. by measurement, by convention, by modelling).</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantity that is obtained from a well-defined procedure.</rdfs:comment>
    <rdfs:label xml:lang="en">ObjectiveProperty</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_2a888cdf_ec4a_4ec5_af1c_0343372fc978"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_d9350951_5300_44e8_ae61_79fb7c53b7e7"/>
    <skos:prefLabel xml:lang="en">ObjectiveProperty</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A quantity that is obtained from a well-defined procedure.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:altLabel xml:lang="en">PhysicalProperty</skos:altLabel>
    <skos:altLabel xml:lang="en">QuantitativeProperty</skos:altLabel>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The word objective does not mean that each observation will provide the same results. It means that the observation followed a well defined procedure.

This class refers to what is commonly known as physical property, i.e. a measurable property of physical system, whether is quantifiable or not.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  </rdf:Description>
