  <rdf:Description rdf:about="https://w3id.org/emmo#Slug">
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b3186"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b3187"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa"/>
    <skos:prefLabel xml:lang="en">Slug</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The slug is a unit of mass associated with Imperial units. It is a mass that accelerates by 1 ft/s when a force of one pound-force (lbF) is exerted on it. With standard gravity gc = 9.80665 m/s, the international foot of 0.3048 m and the avoirdupois pound of 0.45359237 kg, one slug therefore has a mass of approximately 32.17405 lbm or 14.593903 kg. At the surface of the Earth, an object with a mass of 1 slug exerts a force of about 32.17 lbF or 143 N.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">slug</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/SLUG</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:comment xml:lang="en">The slug is a unit of mass associated with Imperial units. It is a mass that accelerates by 1 ft/s when a force of one pound-force (lbF) is exerted on it. With standard gravity gc = 9.80665 m/s, the international foot of 0.3048 m and the avoirdupois pound of 0.45359237 kg, one slug therefore has a mass of approximately 32.17405 lbm or 14.593903 kg. At the surface of the Earth, an object with a mass of 1 slug exerts a force of about 32.17 lbF or 143 N.

-- QUDT</rdfs:comment>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Slug?oldid=495010998</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
