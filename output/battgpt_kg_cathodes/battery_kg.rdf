  <rdf:Description rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb5162">
    <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_6786b336_e982_4759_8dee_1905a4106591"/>
    <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RP(x, y) ≡ PP(x, y) ∧ ∃φ(φ(x) ∧ φ(y))</owl:annotatedTarget>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">φ is a class of the theory that in the EMMO OWL is supposed to be subclass of CausalStructure.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">We usa a predicate template notation as RP&lt;φ&gt;(x,y) to specify subclasses of RP(x,y) for the class φ, meaning that RP&lt;φ&gt;(x, y) ≡ PP(x, y) ∧ φ(x) ∧ φ(y)</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_9380ab64_0363_4804_b13f_3a8a94119a76"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
