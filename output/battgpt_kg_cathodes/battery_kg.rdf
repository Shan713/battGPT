  <rdf:Description rdf:about="https://w3id.org/emmo#AmpereTurnPerMetre">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_08b308d4_31cd_4779_a784_aa92fc730f39"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e6b83139_ba92_4fbd_a8b2_c8dde55844a1"/>
    <skos:altLabel xml:lang="en">Ampere Turn per Metre</skos:altLabel>
    <rdfs:label xml:lang="en">AmpereTurnPerMetre</rdfs:label>
    <skos:prefLabel xml:lang="en">AmpereTurnPerMetre</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/AT-PER-M</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits#"/>
    <rdfs:comment xml:lang="en">The  `Ampere Turn per Metre` is the SI unit of magnetic field strength. One ampere per meter is equal to π/250 oersteds (12.566 371 millioersteds) in CGS units. The ampere per meter is also the SI unit of "magnetization" in the sense of magnetic dipole moment per unit volume; in this context 1 A/m = 0.001 emu per cubic centimeter.

-- QUDT</rdfs:comment>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At/m</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The  `Ampere Turn per Metre` is the SI unit of magnetic field strength. One ampere per meter is equal to π/250 oersteds (12.566 371 millioersteds) in CGS units. The ampere per meter is also the SI unit of "magnetization" in the sense of magnetic dipole moment per unit volume; in this context 1 A/m = 0.001 emu per cubic centimeter.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  </rdf:Description>
