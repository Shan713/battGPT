    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pa⋅s/m</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <skos:prefLabel xml:lang="en">PascalSecondPerMetre</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b2731"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b2730"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e35d4936_b2e3_4cd6_a437_f1c864b3d450"/>
    <skos:altLabel xml:lang="en">Pascal Second Per Metre</skos:altLabel>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pa.s.m-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:comment xml:lang="en">Pascal Second Per Meter (Pa-s/m) is a unit in the category of Specific acoustic impedance. It is also known as pascal-second/meter. Pascal Second Per Meter has a dimension of ML²T⁻¹ where M is mass, L is length, and T is time. It essentially the same as the corresponding standard SI unit kg/m2· s.

-- QUDT</rdfs:comment>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Pascal Second Per Meter (Pa-s/m) is a unit in the category of Specific acoustic impedance. It is also known as pascal-second/meter. Pascal Second Per Meter has a dimension of ML²T⁻¹ where M is mass, L is length, and T is time. It essentially the same as the corresponding standard SI unit kg/m2· s.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  </rdf:Description>
