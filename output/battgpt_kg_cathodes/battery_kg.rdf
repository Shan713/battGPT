    <skos:prefLabel xml:lang="en">StaticFrictionCoefficient</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Proportionality factor between the maximum magnitude of the tangential component of the static friction force and the magnitude of the normal component of the contact force between two bodies at relative rest with respect to each other.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">StaticFrictionCoefficient</rdfs:label>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">When it is not necessary to distinguish between dynamic friction factor and static friction factor, the name friction factor may be used for both.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q73695673</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
    <rdfs:comment xml:lang="en">Proportionality factor between the maximum magnitude of the tangential component of the static friction force and the magnitude of the normal component of the contact force between two bodies at relative rest with respect to each other.</rdfs:comment>
  </rdf:Description>
