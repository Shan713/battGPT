  <rdf:Description rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b5078">
    <emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 xml:lang="en">From Latin partire, partiri ‘divide, share’.</emmo:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The term 'part' is here intended not only in mereological sense but also as role. For example. the term part is used to define the role played by an actor, specifying not only a mereological participation of the actor to an act, but also a specific role for that actor.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_4f226cf3_6d02_4d35_8566_a9e641bc6ff3"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
    <owl:annotatedTarget xml:lang="en">Part</owl:annotatedTarget>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
