  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">indirectlyCauses</rdfs:label>
    <rdfs:comment xml:lang="en">A causal relation between the effected and the causing entities with intermediaries.</rdfs:comment>
    <rdfs:comment xml:lang="en">An indirect cause is a relation between two entities that is mediated by a intermediate entity. In other words, there are no quantum parts of the causing entity that are direct cause of quantum parts of the caused entity.</rdfs:comment>
    <skos:altLabel xml:lang="en">influences</skos:altLabel>
    <skos:altLabel xml:lang="en">isIndirectCauseOf</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
    <skos:prefLabel xml:lang="en">indirectlyCauses</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A causal relation between the effected and the causing entities with intermediaries.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_d67ee67e_4fac_4676_82c9_aec361dba698"/>
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">An indirect cause is a relation between two entities that is mediated by a intermediate entity. In other words, there are no quantum parts of the causing entity that are direct cause of quantum parts of the caused entity.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
  </rdf:Description>
