  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360">
    <skos:prefLabel xml:lang="en">CausalPath</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4615"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_52b8a39b_e5ff_46d3_b972_65bc43077a07"/>
    <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: MultiParticlePath, ElementaryParticle</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
    <skos:example xml:lang="en">An electron moving in time interacting with other particles.</skos:example>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of entities that possess a temporal structure but no spatial structure.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en">Elementary</skos:altLabel>
    <skos:altLabel xml:lang="en">CausalChain</skos:altLabel>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A causal path is a concept almost equivalent to the concept of elementary particle in physics.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:label xml:lang="en">CausalPath</rdfs:label>
    <rdfs:comment xml:lang="en">A causal chain is an ordered causal sequence of entities that does not host any bifurcation within itself (a chain). A chain can only be partitioned in time.</rdfs:comment>
    <rdfs:comment xml:lang="en">The class of entities that possess a temporal structure but no spatial structure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A causal chain is an ordered causal sequence of entities that does not host any bifurcation within itself (a chain). A chain can only be partitioned in time.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
  </rdf:Description>
