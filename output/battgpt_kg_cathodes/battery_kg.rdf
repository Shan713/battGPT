  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_9d8f708a_f291_4d72_80ec_362c6e6bbca6">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The unique point where the weighted relative position of the distributed mass of an Item sums to zero. Equivalently, it is the point where if a force is applied to the Item, causes the Item to move in direction of force without rotation.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">CentreOfMass</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_4312cae4_03ba_457e_b35d_0671a7db350c"/>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Center_of_mass</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <rdfs:comment xml:lang="en">The unique point where the weighted relative position of the distributed mass of an Item sums to zero. Equivalently, it is the point where if a force is applied to the Item, causes the Item to move in direction of force without rotation.</rdfs:comment>
    <rdfs:comment xml:lang="en">In non-relativistic physics, the centre of mass doesn’t depend on the chosen reference frame.</rdfs:comment>
    <skos:prefLabel xml:lang="en">CentreOfMass</skos:prefLabel>
  </rdf:Description>
