  <rdf:Description rdf:about="https://w3id.org/emmo#PoundPerHour">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb3034"/>
