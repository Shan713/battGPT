  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_660a4964_0333_4663_bc66_e93ef59b0679">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A matter that is not a particulate matter and that does not fullfill the criteria of being a continuum substance.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A matter that is not a particulate matter and that does not fullfill the criteria of being a continuum substance.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Mesoscopic substances typically exist on a length scale between atoms and molecules and macroscopic (bulk) substances. They are typically in the range of some nanometers to about a micrometer and often exhibit unique physical properties due to their size and shape.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:label xml:lang="en">MesoscopicSubstance</rdfs:label>
    <skos:example xml:lang="en">nanoparticle,
quantum dot, 
carbon nanotupe</skos:example>
    <skos:prefLabel xml:lang="en">MesoscopicSubstance</skos:prefLabel>
    <owl:disjointWith rdf:resource="https://w3id.org/emmo#EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2"/>
  </rdf:Description>
