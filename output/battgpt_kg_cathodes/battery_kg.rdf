  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_eb50c9cb_9576_4a61_95ec_f81fb8218187"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4433"/>
    <rdfs:comment xml:lang="en">The superclass of entities which are defined by requiring the existence of some parts (at least one) of specifically given types, where the specified types are different with respect to the type of the whole.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
    <skos:prefLabel xml:lang="en">Whole</skos:prefLabel>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A whole is categorized as fundamental (or maximal) or redundant (non-maximal).</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A whole is always defined using a criterion expressed through the classical transitive parthood relation.
This class is expected to host the definition of world objects as they appear in its wholeness, dependently on some of their parts and independently on the surroundings.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The superclass of entities which are defined by requiring the existence of some parts (at least one) of specifically given types, where the specified types are different with respect to the type of the whole.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">Whole</rdfs:label>
  </rdf:Description>
