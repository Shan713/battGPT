  <rdf:Description rdf:about="https://w3id.org/emmo#Dalton">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b466"/>
