    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/metrology#"/>
    <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The Unified Code for Units of Measure (UCUM) is a code system intended to include all units of measures being contemporarily used in international science, engineering, and business. The purpose is to facilitate unambiguous electronic communication of quantities together with their units.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  </rdf:Description>
