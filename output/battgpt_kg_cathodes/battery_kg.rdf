  <rdf:Description rdf:about="https://w3id.org/battgpt/kg#CrystalStructure">
    <rdfs:comment xml:lang="en">Crystallographic structural representation describing the periodic arrangement, unit cell, symmetry, and atomic sites of a material. Explicitly anchored under owl:Thing (v0.3.0) for consistency with its sibling local classes (Site, UnitCell, Species, CrystalBond); no single class in EMMO core, EMMO domain-battery, EMMO domain-electrochemistry, or EMMO domain-chemical-substance cleanly captures 'the crystallographic structure of a substance', and EMMO's own domain-crystallography ontology remains an explicitly work-in-progress v0.1.0 draft not imported here, so this is left as a standalone local root rather than force-fit under an unstable upstream branch.</rdfs:comment>
    <skos:prefLabel xml:lang="en">CrystalStructure</skos:prefLabel>
    <rdfs:label xml:lang="en">CrystalStructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/battgpt/kg#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
