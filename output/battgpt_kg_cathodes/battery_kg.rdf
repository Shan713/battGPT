  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_ee0466e4_780d_4236_8281_ace7ad3fc5d2">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15db234d_ecaf_4715_9838_4b4ec424fb13"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4398"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A causal structure that is tessellated in direct parts.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A causal structure that is tessellated in direct parts.</rdfs:comment>
    <rdfs:comment xml:lang="en">A tessellation (or tiling) is the covering of a surface, often a plane, using one or more geometric shapes, called tiles, with no overlaps and no gaps.</rdfs:comment>
    <skos:altLabel xml:lang="en">Tiling</skos:altLabel>
    <rdfs:label xml:lang="en">Tessellation</rdfs:label>
