  <rdf:Description rdf:about="https://w3id.org/emmo#InchOfMercury">
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Inch_of_mercury?oldid=486634645</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b1335"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_53bd0c90_41c3_46e2_8779_cd2a80f7e18b"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b1336"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <rdfs:label xml:lang="en">InchOfMercury</rdfs:label>
    <rdfs:comment xml:lang="en">Inches of mercury, (inHg) is a unit of measurement for pressure. It is still widely used for barometric pressure in weather reports, refrigeration and aviation in the United States, but is seldom used elsewhere. It is defined as the pressure exerted by a column of mercury of 1 inch in height at 32 °F at the standard acceleration of gravity. 1 inHg = 3,386.389 pascals at 0 °C.

-- QUDT</rdfs:comment>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inHg</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Inches of mercury, (inHg) is a unit of measurement for pressure. It is still widely used for barometric pressure in weather reports, refrigeration and aviation in the United States, but is seldom used elsewhere. It is defined as the pressure exerted by a column of mercury of 1 inch in height at 32 °F at the standard acceleration of gravity. 1 inHg = 3,386.389 pascals at 0 °C.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[in_i'Hg]</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/IN_HG</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <skos:altLabel xml:lang="en">Inch of Mercury</skos:altLabel>
    <skos:prefLabel xml:lang="en">InchOfMercury</skos:prefLabel>
  </rdf:Description>
