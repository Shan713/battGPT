  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_53ed8611_2cd7_4286_9ef0_36572117b963">
    <rdfs:comment xml:lang="en">The class of individuals representing mereological fusions consisting of two or more quantum entities.</rdfs:comment>
    <rdfs:comment xml:lang="en">The union of the CausalCluster and CausalStructure classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mereological fusion is any entity that is made up of two or more quantum entities, regardless of the fact that they are or not self-connected. It captures the idea of set, but excluding singletons.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of individuals representing mereological fusions consisting of two or more quantum entities.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">The union of the CausalCluster and CausalStructure classes.</emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
    <skos:prefLabel xml:lang="en">Fusion</skos:prefLabel>
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A mereological fusion is any entity that is made up of two or more quantum entities, regardless of the fact that they are or not self-connected. It captures the idea of set, but excluding singletons.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: CausalCluster or CausalStructure</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf"/>
    <rdfs:label xml:lang="en">Fusion</rdfs:label>
    <skos:example xml:lang="en">An atom, a group of persons, a fluid.</skos:example>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_01354ac2_cce1_4b7d_8b4a_7322d6cb10bc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
