  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_8533871a_01e4_4935_8c7b_cedf8fcc3fa3">
    <rdfs:label xml:lang="en">Replica</rdfs:label>
    <skos:example xml:lang="en">A small scale replica of a plane tested in a wind gallery shares the same functionality in terms of aerodynamic behaviour of the bigger one.</skos:example>
    <skos:example xml:lang="en">Pinocchio is a functional icon of a boy since it imitates the external behaviour without having the internal biological structure of a human being (it is made of magic wood...).</skos:example>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An icon that not only resembles the object, but also can express some of the object's functions.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:prefLabel xml:lang="en">Replica</skos:prefLabel>
