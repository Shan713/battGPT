    <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q45760</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
