  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_3733bd38_ca2b_4264_a92a_3075a1715598">
    <skos:prefLabel xml:lang="en">foreruns</skos:prefLabel>
    <skos:altLabel xml:lang="en">predecessorOf</skos:altLabel>
    <skos:altLabel xml:lang="en">hasSuccessor</skos:altLabel>
    <skos:altLabel xml:lang="en">isAntecedentOf</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality#"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A causal relation between the y effected and the x causing entities with intermediaries, where x isCauseOf y and not(y isCauseOf x).</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_ebc9e62c_5dc4_44db_9060_7923740bdf78"/>
    <rdfs:label xml:lang="en">foreruns</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/emmo#EMMO_451e410e_8e0d_4a4b_9211_d6ef619296dc"/>
    <skos:example xml:lang="en">My life between 18-24 years has successor my life between 32-40 years, since there is an intermediary (i.e. my life between 25-32 years).</skos:example>
    <owl:propertyDisjointWith rdf:resource="https://w3id.org/emmo#EMMO_d01b3ee2_91a5_4ce2_95cd_f0d2c333c6d3"/>
    <rdfs:comment xml:lang="en">A causal relation between the y effected and the x causing entities with intermediaries, where x isCauseOf y and not(y isCauseOf x).</rdfs:comment>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Transitivity is implemented at A-Box level with a SWRL rule.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_451e410e_8e0d_4a4b_9211_d6ef619296dc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#AbamperePerSquareCentiMetre">
    <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AbamperePerSquareCentiMetre</skos:prefLabel>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abA/cm²</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <skos:altLabel xml:lang="en">Abampere per Square Centimetre</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_120d86b6_d7c4_4490_8ef2_8a5f58403950"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb3"/>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bi/cm2</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bi.cm-2</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Abampere Per Square Centimeter (aA/cm²) is a unit in the category of Electric current density. It is also known as abamperes per square centimeter, abampere/square centimeter, abampere/square centimetre, abamperes per square centimetre, abampere per square centimetre. This unit is commonly used in the cgs unit system. Abampere Per Square Centimeter (aA/cm²) has a dimension of L⁻²I where L is length, and I is electric current. It can be converted to the corresponding standard SI unit A/m² by multiplying its value by a factor of 100000.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.efunda.com/glossary/units/units--electric_current_density--abampere_per_square_centimeter.cfm</rdfs:seeAlso>
    <rdfs:comment xml:lang="en">Abampere Per Square Centimeter (aA/cm²) is a unit in the category of Electric current density. It is also known as abamperes per square centimeter, abampere/square centimeter, abampere/square centimetre, abamperes per square centimetre, abampere per square centimetre. This unit is commonly used in the cgs unit system. Abampere Per Square Centimeter (aA/cm²) has a dimension of L⁻²I where L is length, and I is electric current. It can be converted to the corresponding standard SI unit A/m² by multiplying its value by a factor of 100000.

-- QUDT</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AbamperePerSquareCentiMetre</rdfs:label>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/A_Ab-PER-CentiM2</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  </rdf:Description>
