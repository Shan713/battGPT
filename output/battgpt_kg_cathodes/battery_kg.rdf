  <rdf:Description rdf:about="https://w3id.org/emmo#Litre">
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4713"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4711"/>
