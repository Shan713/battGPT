  <rdf:Description rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b5057">
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">This axiom reflects the fact the the universe is causally self-connected. In fact, a  non causally connected universe would have been the sum of causally independend sub-universes, without any knowledge of others.
This axiom may be seen as Ockam's razor applied to causality.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918"/>
    <owl:annotatedTarget rdf:resource="https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
