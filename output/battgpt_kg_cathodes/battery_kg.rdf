    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_a06e3d38_1aa8_4f45_89a8_722dbacfda24"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">For substance X in a liquid or a solid mixture; quotient of absolute activity of substance X and the product of absolute activity of the pure substance X at the same temperature and pressure and amount-of-substance fraction of substance X.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
