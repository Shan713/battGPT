  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_2b44fb2a_ada8_46af_a961_6e534a61416d">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1783139f_575f_4e41_a409_1e70aceced27"/>
    <rdfs:comment xml:lang="en">A semiosis where an interpretant, already present in the internal representational space of the interpreter, is resolved by the interpreter by identifying the referent, i.e. the entity for which the sign stands for according to the interpreter understanding.</rdfs:comment>
    <rdfs:label xml:lang="en">Verifying</rdfs:label>
    <skos:prefLabel xml:lang="en">Verifying</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A semiosis where an interpretant, already present in the internal representational space of the interpreter, is resolved by the interpreter by identifying the referent, i.e. the entity for which the sign stands for according to the interpreter understanding.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
