    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The Planck energy divided by the Planck time is the Planck power Pₚ , equal to about 3.62831 × 10⁵² W. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the order of 1 × 10⁴⁵ W, less than one ten-millionth of the Planck power.

-- QUDT</rdfs:comment>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pₚ</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PlanckPower</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  </rdf:Description>
