    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">While a task is only an holistic part of a workflow, a task tile provide a more precise context about the placement of a task in the topological structure of a workflow by using a reductionistic categorization. A workflow is now seen as a tiling and the task is on of its tiles.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en">Step</skos:altLabel>
  </rdf:Description>
