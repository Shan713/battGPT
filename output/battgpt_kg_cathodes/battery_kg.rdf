  <rdf:Description rdf:about="https://w3id.org/battgpt/kg#NegativeElectrodeRole">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/battgpt/kg#"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/battgpt/kg#BatteryRole"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Anode / negative electrode functional component role. skos:closeMatch targets EMMO domain-electrochemistry's NegativeElectrode class specifically, not its sibling Anode class: NegativeElectrode is polarity-based and stable across charge/discharge, whereas Anode is defined by current direction and, strictly, swaps with Cathode when a secondary cell is charged versus discharged. BatteryRole's role individuals are meant to be stable per-material assignments, so the polarity-based classes are the correct alignment target.</rdfs:comment>
    <skos:closeMatch rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_c94c041b_8ea6_43e7_85cc_d2bce7785b4c"/>
    <skos:definition xml:lang="en">Anode / negative electrode functional component role.</skos:definition>
    <rdfs:label xml:lang="en">NegativeElectrodeRole</rdfs:label>
    <skos:prefLabel xml:lang="en">NegativeElectrodeRole</skos:prefLabel>
  </rdf:Description>
