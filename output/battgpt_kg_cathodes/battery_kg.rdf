  <rdf:Description rdf:about="https://w3id.org/emmo#UnifiedAtomicMassUnit">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b3434"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b3433"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The unified atomic mass unit (symbol: u) or dalton (symbol: Da) is the standard unit that is used for indicating mass on an atomic or molecular scale (atomic mass). It is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state,[ and has a value of 1.660538921(73) × 10⁻²⁷ kg. One dalton is approximately equal to the mass of one nucleon; an equivalence of saying 1 g mol⁻¹. The CIPM have categorised it as a 'non-SI unit' because units values in SI units must be obtained experimentally.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">UnifiedAtomicMassUnit</rdfs:label>
    <skos:altLabel xml:lang="en">Unified Atomic Mass Unit</skos:altLabel>
    <skos:prefLabel xml:lang="en">UnifiedAtomicMassUnit</skos:prefLabel>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Atomic_mass_unit</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">u</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">u</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <rdfs:comment xml:lang="en">The unified atomic mass unit (symbol: u) or dalton (symbol: Da) is the standard unit that is used for indicating mass on an atomic or molecular scale (atomic mass). It is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state,[ and has a value of 1.660538921(73) × 10⁻²⁷ kg. One dalton is approximately equal to the mass of one nucleon; an equivalence of saying 1 g mol⁻¹. The CIPM have categorised it as a 'non-SI unit' because units values in SI units must be obtained experimentally.

-- QUDT</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/U</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  </rdf:Description>
