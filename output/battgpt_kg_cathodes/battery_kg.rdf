    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Abvolt?oldid=477198646</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
