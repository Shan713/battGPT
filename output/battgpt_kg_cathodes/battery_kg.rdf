    <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.A00496</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
    <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-4.1</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
