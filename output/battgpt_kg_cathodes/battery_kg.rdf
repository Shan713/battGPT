  <rdf:Description rdf:about="https://w3id.org/emmo#Sievert">
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b4339"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"/>
