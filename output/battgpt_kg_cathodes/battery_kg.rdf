  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_bbca6dfa_7463_4e8d_8280_35862ff50ce0">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_32e701c0_a925_49df_9829_0931b8554807"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The superclass for all classes of entities that have parts of the same type of the whole.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example xml:lang="en">An object A which is classified as water-fluid possesses a proper part B which is water itself if the lenght scale of the B is larger than the water intermolecular distance keeping it in the continuum range. In this sense, A is redundant.

If A is a water-fluid so small that its every proper part is no more a continuum object (i.e. no more a fluid), then A is fundamental.</skos:example>
    <skos:example xml:lang="en">A sufficently large volume of liquid water has parts of the same type.</skos:example>
    <rdfs:comment xml:lang="en">Redundant(x) ≡ ∃φ[φ(x) ∧ ∃yRP⟨φ⟩(y, x)]</rdfs:comment>
    <rdfs:comment xml:lang="en">The superclass for all classes of entities that have parts of the same type of the whole.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Redundant</skos:prefLabel>
    <emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">Redundant(x) ≡ ∃φ[φ(x) ∧ ∃yRP⟨φ⟩(y, x)]</emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2"/>
    <rdfs:label xml:lang="en">Redundant</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
    <skos:altLabel xml:lang="en">NonMaximal</skos:altLabel>
  </rdf:Description>
