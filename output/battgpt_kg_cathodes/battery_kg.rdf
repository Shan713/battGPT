    <rdfs:label xml:lang="en">MoleKelvin</rdfs:label>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Mole Kelvin is a unit for `Temperature Amount Of Substance` expressed as mol-K.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
