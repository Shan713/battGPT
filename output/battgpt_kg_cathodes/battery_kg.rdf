    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb2964"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Planck force is the derived unit of force resulting from the definition of the base Planck units for time, length, and mass. It is equal to the natural unit of momentum divided by the natural unit of time.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <skos:altLabel xml:lang="en">Planck Force</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">PlanckForce</skos:prefLabel>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">planckforce</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <rdfs:comment xml:lang="en">Planck force is the derived unit of force resulting from the definition of the base Planck units for time, length, and mass. It is equal to the natural unit of momentum divided by the natural unit of time.

-- QUDT</rdfs:comment>
