    <skos:altLabel xml:lang="en">Kilogram per Hour</skos:altLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8826aefb_0bf6_4378_8732_fc80aa95654c"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b1675"/>
