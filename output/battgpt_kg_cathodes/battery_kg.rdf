  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_8aba9715_d542_4a79_a778_6115d2b4febd">
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b811"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8af3b008_0e32_4684_85ab_a52a8e7b6877"/>
    <rdfs:label xml:lang="en">CollectiveAgency</rdfs:label>
    <rdfs:comment xml:lang="en">Collective agency occurs when two or more individuals act as a group, in accordance with certain principles or procedures that constitute and organize the group.</rdfs:comment>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Collective agency occurs when two or more individuals act as a group, in accordance with certain principles or procedures that constitute and organize the group.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:isDefinedBy rdf:resource="https://plato.stanford.edu/entries/agency/#OthKinAgeMenShaColRelArt"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/agency#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">CollectiveAgency</skos:prefLabel>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The group acting collectively is intended to be represented as an item, meaning that all members of the group should have had at least one causal interaction with another member. The collective action in fact is taken in accordance with certain principles or procedures that constitute and organize the group itself that requires implicitly a causal interaction between members.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  </rdf:Description>
