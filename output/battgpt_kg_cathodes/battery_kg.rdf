    <skos:example xml:lang="en">From a bash shell would e.g. `ls` be a command. Another example of a shell command would be `/path/to/executable arg1 arg2`.</skos:example>
    <rdfs:comment xml:lang="en">An instruction to a computer system to perform a given task.</rdfs:comment>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Commands are typically performed from a shell or a shell script, but not limited to them.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A command must be interpretable by the computer system.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <skos:prefLabel xml:lang="en">Command</skos:prefLabel>
    <rdfs:label xml:lang="en">Command</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_64963ed6_39c9_4258_85e0_6466c4b5420c"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/computerscience#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_0a88be81_343d_4388_92c1_09228ff95ada">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Probability is a dimensionless quantity that can attain values between 0 and 1; zero denotes the impossible event and 1 denotes a certain event.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">Probability</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_faab3f84_e475_4a46_af9c_7d249f0b9aef"/>
    <rdfs:comment xml:lang="en">Probability is a dimensionless quantity that can attain values between 0 and 1; zero denotes the impossible event and 1 denotes a certain event.</rdfs:comment>
    <rdfs:comment xml:lang="en">The propability for a certain outcome, is the ratio between the number of events leading to the given outcome and the total number of events.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
