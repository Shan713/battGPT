  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_b4494d69_6393_4eb4_8346_7fedd4df0bc5">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole are not proper part of an entity of that type.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">Maximal</rdfs:label>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A maximal class M (subclass of Maximal) is defined by choosing a reference type φ so that M is subclass of φ, all parts of x are needed to keep φ(x) and if you add something to x, then x is no more a φ.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_157fdf31_6387_42be_8e72_10530519214a rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Maximal.png</emmo:EMMO_157fdf31_6387_42be_8e72_10530519214a>
    <skos:prefLabel xml:lang="en">Maximal</skos:prefLabel>
    <rdfs:comment xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole are not proper part of an entity of that type.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2"/>
  </rdf:Description>
