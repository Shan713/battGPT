  <rdf:Description rdf:about="https://w3id.org/emmo#MegaBar">
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb1789"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_53bd0c90_41c3_46e2_8779_cd2a80f7e18b"/>
