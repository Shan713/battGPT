    <rdfs:label xml:lang="en">DegreePerMinute</rdfs:label>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deg.min-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deg/min</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedunits#"/>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/DEG-PER-MIN</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A unit of measure for the rate of change of plane angle, dω / dt,  in durations of one minute.The vector ω is directed along the axis of rotation in the direction for which the rotation is clockwise.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en">Degree per Minute</skos:altLabel>
    <skos:prefLabel xml:lang="en">DegreePerMinute</skos:prefLabel>
    <rdfs:comment xml:lang="en">A unit of measure for the rate of change of plane angle, dω / dt,  in durations of one minute.The vector ω is directed along the axis of rotation in the direction for which the rotation is clockwise.

-- QUDT</rdfs:comment>
  </rdf:Description>
