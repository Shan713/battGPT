    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Class that includes the application of scientific knowledge, tools and techniques in order to transform a precursor object (ex. conversion of material) following a practic purpose.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:altLabel xml:lang="en">ProductionEngineeringProcess</skos:altLabel>
    <skos:prefLabel xml:lang="en">TechnologyProcess</skos:prefLabel>
  </rdf:Description>
