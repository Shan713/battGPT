    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A process which is a spatial part of another process.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb3702"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_846b637b_7b12_47a1_9430_0274b2f588ac"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">In the EMMO the relation of participation to a process falls under mereotopology.

Since topological connection means causality, then the only way for a real world object to participate to a process is to be a part of it.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:label xml:lang="en">SubProcess</rdfs:label>
    <rdfs:comment xml:lang="en">A process which is a spatial part of another process.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
    <skos:prefLabel xml:lang="en">SubProcess</skos:prefLabel>
  </rdf:Description>
