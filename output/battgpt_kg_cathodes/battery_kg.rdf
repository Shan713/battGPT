  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_49267eba_5548_4163_8f36_518d65b583f9">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of causal objects that stand for world objects according to a specific representational perspective.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:prefLabel xml:lang="en">Perspective</skos:prefLabel>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">This class is the practical implementation of the EMMO pluralistic approach for which the only objective categorization is provided by the Universe individual and all the Quantum individuals.
Between these two extremes, there are several subjective ways to categorize real world objects, each one provide under a 'Perspective' subclass.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:label xml:lang="en">Perspective</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
    <rdfs:comment xml:lang="en">The class of causal objects that stand for world objects according to a specific representational perspective.</rdfs:comment>
  </rdf:Description>
