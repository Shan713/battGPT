  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_1f2bfb9f_ecc6_46a0_9e41_2d6fcbf59e4b">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/standardmodel#"/>
    <rdfs:comment xml:lang="en">The class of fundamental systems where the number of input particles is reduced to one.</rdfs:comment>
    <rdfs:comment xml:lang="en">A collapse is a fundamental interaction between m colliding particles that results in a single outgoing particle (inverse decay)  that is expressed as a complete bipartite directed graph K(m,1) with m&gt;1.</rdfs:comment>
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A collapse is a fundamental interaction between m colliding particles that results in a single outgoing particle (inverse decay)  that is expressed as a complete bipartite directed graph K(m,1) with m&gt;1.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_43a4e80d_6ae9_45ed_8cfb_fd0a5339bf87"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class of fundamental systems where the number of input particles is reduced to one.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">Collapse</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example xml:lang="en">The Higgs boson production from two gluons, or a bottom and an anti-bottom quark.</skos:example>
    <skos:prefLabel xml:lang="en">Collapse</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_9bed5d66_805a_4b3a_9153_beaf67143848">
