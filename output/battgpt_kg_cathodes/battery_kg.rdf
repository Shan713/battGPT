  <rdf:Description rdf:about="https://w3id.org/emmo#HenryPerMetre">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The henry per meter (symbolized H/m) is the unit of magnetic permeability in the International System of Units ( SI ). Reduced to base units in SI, 1 H/m is the equivalent of one kilogram meter per square second per square ampere.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Henry?oldid=491435978</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
