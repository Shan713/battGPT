  <rdf:Description rdf:about="https://w3id.org/emmo#FootPerSecond">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">`foot per second` (plural `feet per second`) is a unit of both speed (scalar) and velocity (vector quantity, which includes direction). It expresses the distance in feet (ft) traveled or displaced, divided by the time in seconds (s, or sec). The corresponding unit in the International System of Units (SI) is the `metre per second`. Abbreviations include ft/s, ft/sec and fps, and the rarely used scientific notation ft s.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/FT-PER-SEC</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ft/s</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Foot_per_second?oldid=491316573</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">FootPerSecond</skos:prefLabel>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b1110"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b1109"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_4f5c7c54_1c63_4d17_b12b_ea0792c2b187"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits#"/>
    <skos:altLabel xml:lang="en">Foot per Second</skos:altLabel>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[ft_i]/s</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[ft_i].s-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:label xml:lang="en">FootPerSecond</rdfs:label>
    <rdfs:comment xml:lang="en">`foot per second` (plural `feet per second`) is a unit of both speed (scalar) and velocity (vector quantity, which includes direction). It expresses the distance in feet (ft) traveled or displaced, divided by the time in seconds (s, or sec). The corresponding unit in the International System of Units (SI) is the `metre per second`. Abbreviations include ft/s, ft/sec and fps, and the rarely used scientific notation ft s.

-- QUDT</rdfs:comment>
  </rdf:Description>
