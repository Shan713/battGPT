  <rdf:Description rdf:about="https://w3id.org/emmo#CoulombPerMole">
    <skos:prefLabel xml:lang="en">CoulombPerMole</skos:prefLabel>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb338"/>
