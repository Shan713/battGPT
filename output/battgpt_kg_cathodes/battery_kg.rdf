  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_35d2e130_6e01_41ed_94f7_00b333d46cf9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">In Peirce semiotics this kind of sign category is called symbol. However, since symbol is also used in formal languages, the name is changed in conventional.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
