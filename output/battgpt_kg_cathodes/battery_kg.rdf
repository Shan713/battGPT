  <rdf:Description rdf:about="https://w3id.org/emmo#Stathenry">
    <skos:prefLabel xml:lang="en">Stathenry</skos:prefLabel>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statH</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.efunda.com/glossary/units/units--electric_inductance--stathenry.cfm</rdfs:seeAlso>
    <rdfs:comment xml:lang="en">"Stathenry" (statH) is a unit in the category of Electric inductance. It is also known as stathenries. This unit is commonly used in the cgs unit system. Stathenry (statH) has a dimension of ML²T⁻²I⁻² where M is mass, L is length, T is time, and I is electric current. It can be converted to the corresponding standard SI unit H by multiplying its value by a factor of 8.987552 × 10¹¹ .

-- QUDT</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb3329"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb3328"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_585e0ff0_9429_4d3c_b578_58abb1ba21d1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
    <rdfs:label xml:lang="en">Stathenry</rdfs:label>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/H_Stat</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">"Stathenry" (statH) is a unit in the category of Electric inductance. It is also known as stathenries. This unit is commonly used in the cgs unit system. Stathenry (statH) has a dimension of ML²T⁻²I⁻² where M is mass, L is length, T is time, and I is electric current. It can be converted to the corresponding standard SI unit H by multiplying its value by a factor of 8.987552 × 10¹¹ .

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  </rdf:Description>
