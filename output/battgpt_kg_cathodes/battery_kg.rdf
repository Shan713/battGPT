  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_ae2d1a96_bfa1_409a_a7d2_03d69e8a125a">
    <rdfs:label xml:lang="en">hasParticipant</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_13191289_6c2b_4741_93e1_82d53bd0e703"/>
    <rdfs:comment xml:lang="en">Participation is a parthood relation: you must be part of the process to contribute to it. A participant whose 4D extension is totally contained within the process.

Participation is not under direct parthood since a process is not strictly related to reductionism, but it's a way to categorise temporal regions by the interpreters.</rdfs:comment>
    <rdfs:comment xml:lang="en">The relation between a process and an object participating to it, i.e. that is relevant to the process itself.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_9a50a0ae_841a_46fe_8b23_3df319b60611"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The relation between a process and an object participating to it, i.e. that is relevant to the process itself.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce"/>
    <skos:prefLabel xml:lang="en">hasParticipant</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  </rdf:Description>
