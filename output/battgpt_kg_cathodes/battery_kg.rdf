    <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10-9.1</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
    <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-30</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_af794e9d_dc7d_4756_83e1_2cd0e2ec864e"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_2946d40b_24a1_47fa_8176_e3f79bb45064"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb796"/>
    <rdfs:comment xml:lang="en">For an atom or nucleus, this energy is quantized and can be written as:

    W = g μ M B

where g is the appropriate g factor, μ is mostly the Bohr magneton or nuclear magneton, M is magnetic quantum number, and B is magnitude of the magnetic flux density.

-- ISO 80000</rdfs:comment>
    <rdfs:comment xml:lang="en">Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:

    ΔW = −μ · B</rdfs:comment>
    <skos:prefLabel xml:lang="en">MagneticDipoleMoment</skos:prefLabel>
    <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://goldbook.iupac.org/terms/view/M03688</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:

    ΔW = −μ · B</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-55</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/quantitykind/MagneticDipoleMoment</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:label xml:lang="en">MagneticDipoleMoment</rdfs:label>
  </rdf:Description>
