    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abF</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <rdfs:label xml:lang="en">Abfarad</rdfs:label>
    <rdfs:comment xml:lang="en">An abfarad is an obsolete electromagnetic (CGS) unit of capacitance equal to 10⁹ farads (1,000,000,000 F or 1 GF). The absolute farad of the e.m.u. system, for a steady current identically abC/abV, and identically reciprocal abdaraf. 1 abF = 1 GF.

-- QUDT</rdfs:comment>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GF</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits#"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An abfarad is an obsolete electromagnetic (CGS) unit of capacitance equal to 10⁹ farads (1,000,000,000 F or 1 GF). The absolute farad of the e.m.u. system, for a steady current identically abC/abV, and identically reciprocal abdaraf. 1 abF = 1 GF.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-13</rdfs:seeAlso>
