    <skos:prefLabel xml:lang="en">StringData</skos:prefLabel>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Since a string is a simple type that can contain only characters but not other child elements, is often not suitable for representing human text, that may need additional elements for control of aspects such as bidirectional formatting or ruby annotation.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EquivalentTo: hasDataValue some xsd:string</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
    <rdfs:label xml:lang="en">StringData</rdfs:label>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Symbolic data that consist of a sequence of characters.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
