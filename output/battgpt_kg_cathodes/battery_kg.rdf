  <rdf:Description rdf:about="https://w3id.org/emmo#PascalSecondPerCubicMetre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb2728"/>
