    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[Btu_IT].[lb_av]-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.efunda.com/glossary/units/units--energy_density--british_thermal_unit_it_per_cubic_foot.cfm</rdfs:seeAlso>
    <rdfs:comment xml:lang="en">The amount of energy generated by a pound of substance is measured in British thermal units (IT) per pound of mass. 1 Btu_{IT}/lb is equivalent to 2.326 × 10³ joule per kilogram (J/kg).

