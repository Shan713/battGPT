    <skos:prefLabel xml:lang="en">DippingForms</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">DippingForms</rdfs:label>
  </rdf:Description>
