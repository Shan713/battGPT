  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_a15cea10_9946_4d2b_95c5_cfc333fd2abb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">PhysicalParticle</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
    <rdfs:comment xml:lang="en">A well defined physical entity, elementary or composite, usually treated as a singular unit, that is found at scales spanning from the elementary particles to molecules, as fundamental constituents of larger scale substances (as the etymology of "particle" suggests).</rdfs:comment>
    <rdfs:comment xml:lang="en">The union of hadron and lepton, or fermion and bosons.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d"/>
    <rdfs:label xml:lang="en">PhysicalParticle</rdfs:label>
    <emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 xml:lang="en">The union of hadron and lepton, or fermion and bosons.</emmo:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84>
    <skos:altLabel xml:lang="en">Particle</skos:altLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A well defined physical entity, elementary or composite, usually treated as a singular unit, that is found at scales spanning from the elementary particles to molecules, as fundamental constituents of larger scale substances (as the etymology of "particle" suggests).</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The scope of the physical particle definition goes from the elementary particles to molecules, as fundamental constituents of substances.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  </rdf:Description>
