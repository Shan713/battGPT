    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/EffectiveMass</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The mass that it seems to have when responding to forces, or the mass that it seems to have when interacting with other identical particles in a thermal distribution.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
