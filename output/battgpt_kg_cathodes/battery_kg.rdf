  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The class for entities which stands for a specific data format expressed using a symbolic encoding.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/2012/REC-xmlschema11-2-20120405/#built-in-datatypes</rdfs:seeAlso>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Datatype_Maps</rdfs:seeAlso>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.w3.org/TR/rdf11-concepts/</rdfs:seeAlso>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.w3schools.com/xml/schema_dtypes_numeric.asp</rdfs:seeAlso>
    <skos:prefLabel xml:lang="en">SymbolicData</skos:prefLabel>
    <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DisjointUnionOf: ArrayData, ScalarData</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_057e7d57_aff0_49de_911a_8861d85cef40"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The class for entities which stands for a specific data format expressed using a symbolic encoding.</rdfs:comment>
    <rdfs:comment xml:lang="en">A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data.</rdfs:comment>
    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LiteralData</skos:altLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
    <emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13 xml:lang="en">A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data.</emmo:EMMO_31252f35_c767_4b97_a877_1235076c3e13>
    <rdfs:label xml:lang="en">SymbolicData</rdfs:label>
  </rdf:Description>
