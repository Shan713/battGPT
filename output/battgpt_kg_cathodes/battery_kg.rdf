    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb4544"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_53e825d9_1a09_483c_baa7_37501ebfbe1c"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">SI unit for force.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Newton</emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">The "Newton" is the SI unit of force. A force of one newton will accelerate a mass of one kilogram at the rate of one meter per second per second. The newton is named for Isaac Newton (1642-1727), the British mathematician, physicist, and natural philosopher. He was the first person to understand clearly the relationship between force (F), mass (m), and acceleration (a) expressed by the formula F = m·a.

-- QUDT</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits#"/>
    <rdfs:comment xml:lang="en">SI unit for force.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Newton</skos:prefLabel>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/N</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:label xml:lang="en">Newton</rdfs:label>
    <schema:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEW</schema:unitCode>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
