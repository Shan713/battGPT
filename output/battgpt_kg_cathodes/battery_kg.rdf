  <rdf:Description rdf:about="https://w3id.org/emmo#Btu_It_Per_Lb">
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Btu{IT}/lb</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
    <rdfs:label xml:lang="en">Btu_It_Per_Lb</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb170"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_847f1d9f_205e_46c1_8cb6_a9e479421f88"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb171"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/unclassifiedunits#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">Btu_It_Per_Lb</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The amount of energy generated by a pound of substance is measured in British thermal units (IT) per pound of mass. 1 Btu_{IT}/lb is equivalent to 2.326 × 10³ joule per kilogram (J/kg).

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:altLabel xml:lang="en">BTU-IT-PER-lb</skos:altLabel>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[Btu_IT].[lb_av]-1</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[Btu_IT]/[lb_av]</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:comment xml:lang="en">The amount of energy generated by a pound of substance is measured in British thermal units (IT) per pound of mass. 1 Btu_{IT}/lb is equivalent to 2.326 × 10³ joule per kilogram (J/kg).

-- QUDT</rdfs:comment>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.efunda.com/glossary/units/units--energy_density--british_thermal_unit_it_per_cubic_foot.cfm</rdfs:seeAlso>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/BTU_IT-PER-LB</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
  </rdf:Description>
