  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_b9695e87_8261_412e_83cd_a86459426a28">
    <rdfs:comment xml:lang="en">A superclass made as the disjoint union of all the form under which matter can exist.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/materials#"/>
    <skos:prefLabel xml:lang="en">StateOfMatter</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8b0923ab_b500_477b_9ce9_8b3a3e4dc4f2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">StateOfMatter</rdfs:label>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/State_of_matter</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">In physics, a state of matter is one of the distinct forms in which matter can exist. Four states of matter are observable in everyday life: solid, liquid, gas, and plasma.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A superclass made as the disjoint union of all the form under which matter can exist.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disjoint Union Of: Gas, Plasma, Liquid, Solid</emmo:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db>
  </rdf:Description>
