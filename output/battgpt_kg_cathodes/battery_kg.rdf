    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits#"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <skos:altLabel xml:lang="en">Ampere Turn</skos:altLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The `ampere-turn` was the MKS unit of magnetomotive force (MMF), represented by a direct current of one ampere flowing in a single-turn loop in a vacuum. "Turns" refers to the winding number of an electrical conductor comprising an inductor. The ampere-turn was replaced by the SI unit, ampere.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:prefLabel xml:lang="en">AmpereTurn</skos:prefLabel>
    <rdfs:label xml:lang="en">AmpereTurn</rdfs:label>
    <rdfs:comment xml:lang="en">The `ampere-turn` was the MKS unit of magnetomotive force (MMF), represented by a direct current of one ampere flowing in a single-turn loop in a vacuum. "Turns" refers to the winding number of an electrical conductor comprising an inductor. The ampere-turn was replaced by the SI unit, ampere.

-- QUDT</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AT</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
