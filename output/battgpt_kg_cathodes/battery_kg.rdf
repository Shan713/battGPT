    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q97708211</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Quotient of the product of the electric charge of a particle and the magnitude of the magnetic flux density of the magnetic field, and the particle mass.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">CyclotronAngularFrequency</rdfs:label>
  </rdf:Description>
