  <rdf:Description rdf:about="https://w3id.org/battgpt/kg#hasSpecificCapacity">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/battgpt/kg#"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_e1097637_70d2_4895_973f_2396f04fa204"/>
    <rdfs:domain rdf:resource="https://w3id.org/emmo/domain/battery#battery_68ed592a_7924_45d0_a108_94d6275d57f0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:prefLabel xml:lang="en">hasSpecificCapacity</skos:prefLabel>
    <rdfs:comment xml:lang="en">Relates a battery cell to its specific capacity (capacity per unit mass). New in v0.3.0, reusing EMMO domain-electrochemistry's SpecificCapacity class.</rdfs:comment>
    <rdfs:label xml:lang="en">hasSpecificCapacity</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/emmo/domain/electrochemistry#electrochemistry_1e3dc60d_dd6b_47d6_8161_70004fc5ee30"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150">
    <skos:example xml:lang="en">If an inhabited house is considered as an house that is occupied by some people in its majority of time, then an interval of inhabited house in which occasionally nobody is in there is no more an inhabited house, but an unhinabited house, since this temporal part does not satisfy the criteria of the whole.</skos:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">SubObject</rdfs:label>
    <rdfs:comment xml:lang="en">An object which is a temporal part of another object.</rdfs:comment>
    <skos:prefLabel xml:lang="en">SubObject</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9d799b43_e188_4047_8167_121d96b31a26"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b3651"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Here we consider a temporal interval that is lower than the characteristic time of the physical process that provides the causality connection between the object parts.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An object which is a temporal part of another object.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
  </rdf:Description>
