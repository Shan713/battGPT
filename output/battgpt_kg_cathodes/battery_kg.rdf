  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_28fbea28_2204_4613_87ff_6d877b855fcd">
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Arrays are ordered mathematical objects who's elementary spatial parts are numbers. Their dimensionality is constructed with spatial direct parthood, where 1-dimensional arrays have spatial direct parts Number and n-dimensional array have spatial direct parts (n-1)-dimensional arrays.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:prefLabel xml:lang="en">Array</skos:prefLabel>
    <rdfs:comment xml:lang="en">Arrays are ordered objects, since they are a subclasses of Arrangement.</rdfs:comment>
    <rdfs:comment xml:lang="en">Arrays are ordered mathematical objects who's elementary spatial parts are numbers. Their dimensionality is constructed with spatial direct parthood, where 1-dimensional arrays have spatial direct parts Number and n-dimensional array have spatial direct parts (n-1)-dimensional arrays.</rdfs:comment>
    <rdfs:comment xml:lang="en">Array subclasses with a specific shape can be constructed with cardinality restrictions.

See Shape4x3Matrix as an example.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:example xml:lang="en">A Vector is a 1-dimensional Array with Number as spatial direct parts,
a Matrix is a 2-dimensional Array with Vector as spatial direct parts,
an Array3D is a 3-dimensional Array with Matrix as spatial direct parts,
and so forth...</skos:example>
    <rdfs:label xml:lang="en">Array</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb2110">
