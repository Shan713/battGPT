  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_51f426a6_af4a_4e91_a392_2b0bb635e2d5">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/chemistry#"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Relates a substance to chemical composition.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:domain rdf:resource="https://w3id.org/emmo#EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352"/>
    <skos:prefLabel xml:lang="en">hasChemicalComposition</skos:prefLabel>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_eb3518bf_f799_4f9e_8c3e_ce59af11453b"/>
    <rdfs:label xml:lang="en">hasChemicalComposition</rdfs:label>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">This property is often used to relate a substance directly to SingleComponentComposition indifiduals for each of its components.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:comment xml:lang="en">Relates a substance to chemical composition.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:example xml:lang="en">This relation can be used to relate a material to a chemical composition quantity of one of its chemical species. For example, the amount of aluminium in substance subst:alloy1 can be expressed as:

```turtle
subst:alloy1 a emmo:Substance ;
    emmo:hasChemicalComposition [
        a emmo:SingleComponentComposition ;
        emmo:hasSpeciesPart [ a emmo:AluminiumSymbol ] ;
        emmo:hasQuantityPart [
            a emmo:MassFraction ;
            hasSIQuantityValue "98.1 wt%"^^emmo:SIQuantityDatatype
        ]
    ] .
```</skos:example>
    <rdfs:range rdf:resource="https://w3id.org/emmo#EMMO_7efd64d1_05a1_49cd_a7f0_783ca050d4f3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_12aae025_a226_4762_9d51_81200a8ce54c">
    <skos:prefLabel xml:lang="en">PseudoscalarMeson</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A meson with spin zero and odd parity.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:comment xml:lang="en">A meson with spin zero and odd parity.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">PseudoscalarMeson</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/physicalistic#"/>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Pseudoscalar_meson</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_be0a7278_b4e6_4bca_88ba_de3f67a478e2"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb5010">
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">This definition reads: "The universe is the sum of all entities that are part of themselves". Since parthood (P) is reflexive by axiom, then the universe is the sum of all mereological entities.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">u ≡ σx⟨P(x, x)⟩</owl:annotatedTarget>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_3c7affee_09ed_42e7_a190_4a10c75ab6dd">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hardening of a workpiece caused by the precipitation of one or more compounds from a supersaturated solid solution</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">PrecipitationHardening</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_dacfc7dc_5ddb_4f67_986b_dcd01d649d60"/>
    <skos:prefLabel xml:lang="en">PrecipitationHardening</skos:prefLabel>
  </rdf:Description>
