    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A non-elementary particle (bonded) of a fundamental bosonic type (integer spin).</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
