    <skos:altLabel xml:lang="en">Coulomb per Kilogram</skos:altLabel>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/C-PER-KiloGM</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CoulombPerKilogram</skos:prefLabel>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">`Coulomb Per Kilogram (C/kg)` is the unit in the category of Exposure. It is also known as coulombs per kilogram, coulomb/kilogram. This unit is commonly used in the SI unit system. Coulomb Per Kilogram (C/kg) has a dimension of M⁻¹TI where M is mass, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
