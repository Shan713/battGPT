    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b64"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_cdc962d8_f3ea_4764_a57a_c7caa4859179"/>
    <schema:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D61</schema:unitCode>
    <skos:prefLabel xml:lang="en">Arcminute</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#"/>
    <skos:altLabel xml:lang="en">ArcMinute</skos:altLabel>
    <skos:altLabel xml:lang="en">MinuteOfArc</skos:altLabel>
    <rdfs:comment xml:lang="en">A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or π /10,800 radians. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation.

-- QUDT</rdfs:comment>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
