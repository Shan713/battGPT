  <rdf:Description rdf:about="https://w3id.org/emmo#Joule">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siunits#"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f"/>
