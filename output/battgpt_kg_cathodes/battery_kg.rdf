  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_1b32a555_978b_4e56_933f_e158e165023e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel xml:lang="en">VectorMeson</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/physicalistic#"/>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Vector_meson</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <rdfs:comment xml:lang="en">A meson with total spin 1 and odd parity.</rdfs:comment>
    <rdfs:label xml:lang="en">VectorMeson</rdfs:label>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A meson with total spin 1 and odd parity.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_be0a7278_b4e6_4bca_88ba_de3f67a478e2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_febf1178_c74b_4d6d_816c_591ac2ee3530">
    <rdfs:comment xml:lang="en">The relation between two causally reachable entities through a path with at least one hasNonSpatialContactWith relation (i.e. non representing physical interactions).</rdfs:comment>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The relation between two causally reachable entities through a path with at least one hasNonSpatialContactWith relation (i.e. non representing physical interactions).</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/emmo#EMMO_113087fa_8354_49d1_9625_5f36698d3298"/>
    <rdfs:label xml:lang="en">hasImproperIndirectInteraction</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/foundation/mereocausality-full#"/>
    <skos:prefLabel xml:lang="en">hasImproperIndirectInteraction</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_15db234d_ecaf_4715_9838_4b4ec424fb13">
    <skos:prefLabel xml:lang="en">Reductionistic</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_49267eba_5548_4163_8f36_518d65b583f9"/>
    <rdfs:comment xml:lang="en">A class devoted to categorize causal objects by specifying their granularity levels.</rdfs:comment>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Direct parthood is the antitransitive parthood relation used to build the class hierarchy (and the granularity hierarchy) for this perspective.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A granularity level is specified by a tiling decomposition of the whole y. A tiling is identified as a set of items {x1, x2, ... xn} called tiles that:
    - are proper parts of y
    - covers the entire whole (y = x1 +x2 + ... + xn)
    - do not overlap
    - are part of one, and one only, whole (inverse functional)</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:label xml:lang="en">Reductionistic</rdfs:label>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A class devoted to categorize causal objects by specifying their granularity levels.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/reductionistic#"/>
  </rdf:Description>
