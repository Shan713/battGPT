  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_49804605_c0fe_4538_abda_f70ba1dc8a5d">
    <skos:prefLabel xml:lang="en">SubProcess</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_846b637b_7b12_47a1_9430_0274b2f588ac"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b3702"/>
    <rdfs:label xml:lang="en">SubProcess</rdfs:label>
    <rdfs:comment xml:lang="en">A process which is a spatial part of another process.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/persistence#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">In the EMMO the relation of participation to a process falls under mereotopology.

Since topological connection means causality, then the only way for a real world object to participate to a process is to be a part of it.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A process which is a spatial part of another process.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <skos:example xml:lang="en">Breathing is a subprocess of living for a human being.</skos:example>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_1783139f_575f_4e41_a409_1e70aceced27">
    <skos:prefLabel xml:lang="en">PartialSemiosis</skos:prefLabel>
    <rdfs:comment xml:lang="en">A semiosis where the triangle of relation is not completely developed.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A semiosis where the triangle of relation is not completely developed.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">PartialSemiosis</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_3fe33e1c_2b62_4669_af92_8066cf53761d"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/semiotics#"/>
  </rdf:Description>
