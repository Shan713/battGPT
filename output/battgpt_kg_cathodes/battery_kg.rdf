    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">Gauge pressure can be measured using a diaphragm sensor, where one side of the diaphragm is exposed to the pressure media that is to be measured, while the other side is exposed to the ambient atmospheric pressure.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
