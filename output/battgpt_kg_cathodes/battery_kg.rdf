    <rdfs:label xml:lang="en">Bel</rdfs:label>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">A logarithmic unit of sound pressure equal to 10 decibels (dB),  It is defined as: 1 B = (1/2) log₁₀(Np)

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
