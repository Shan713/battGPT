    <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_19d925d0_2cf1_40e5_a391_1a99d68409c9"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
