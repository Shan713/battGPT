    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b1674"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KilogramPerHour</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/siacceptedunits#"/>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kg/h</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
