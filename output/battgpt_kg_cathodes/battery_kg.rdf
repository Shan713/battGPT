    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Heat_capacity</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-15</emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Quantity C = dQ/dT, when the thermodynamic temperature of a system is increased by dT as a result of the addition of a amount of heat dQ, under given condition.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <rdfs:label xml:lang="en">HeatCapacity</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
    <skos:prefLabel xml:lang="en">HeatCapacity</skos:prefLabel>
    <emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-47</emmo:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://qudt.org/vocab/quantitykind/HeatCapacity</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dbpedia.org/page/Heat_capacity</emmo:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25>
    <rdfs:comment xml:lang="en">Quantity C = dQ/dT, when the thermodynamic temperature of a system is increased by dT as a result of the addition of a amount of heat dQ, under given condition.</rdfs:comment>
    <rdfs:comment xml:lang="en">Examples of condition might be constant volume or constant pressure for a gas.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_dae32a4a_d8da_4047_81b0_36a9713fdce1"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b4143"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_2946d40b_24a1_47fa_8176_e3f79bb45064"/>
