  <rdf:Description rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b4895">
    <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_ad0e72fc_dcaa_490d_8371_b4d814dcda2c"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/emmo#EMMO_3f9ae00e_810c_4518_aec2_7200e424cf68"/>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">doi:10.3233/FAIA231120</rdfs:seeAlso>
    <owl:annotatedTarget xml:lang="en">Causality is the fundamental concept describing how entities affect each other, and conceptually precedes time and space relations. In the EMMO causality is the foundation for space and time relations.
Embracing a strong reductionistic view, causality originates at quantum entities level, meaning that causal relations between macroscopic entities is simply the sum of quantum level causality relations.</owl:annotatedTarget>
  </rdf:Description>
