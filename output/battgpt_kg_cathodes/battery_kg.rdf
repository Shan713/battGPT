    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1a6ddb13_49ff_4305_97a1_d1458d51c066"/>
    <skos:prefLabel xml:lang="en">IterativeTask</skos:prefLabel>
    <emmo:EMMO_157fdf31_6387_42be_8e72_10530519214a rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/emmo/raw/1.0.3/doc/figs/IterativeWorkflow.png</emmo:EMMO_157fdf31_6387_42be_8e72_10530519214a>
    <rdfs:comment xml:lang="en">An iterative workflow which is a task of a larger workflow.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/reference/workflow#"/>
    <rdfs:label xml:lang="en">IterativeTask</rdfs:label>
    <skos:example xml:lang="en">A Jacobi method, involving the iterative multiplication between a matrix A and a vector x, which is part of larger workflow for the solution of a partial differential equation using finite differences.</skos:example>
  </rdf:Description>
