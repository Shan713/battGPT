    <rdfs:label xml:lang="en">Peening</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_46dc0d51_b60f_49cd_8650_9aba7be3726c"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/manufacturing#"/>
    <skos:prefLabel xml:lang="en">Peening</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ShotPeening</skos:altLabel>
    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Verfestigungsstrahlen</skos:altLabel>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(according to DIN 8200) Shot peening to generate residual compressive stresses in layers of the blasting material close to the surface in order to improve certain component properties, e.g. fatigue strength, corrosion resistance, wear resistance (from: DIN 8200:1982)</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
  </rdf:Description>
