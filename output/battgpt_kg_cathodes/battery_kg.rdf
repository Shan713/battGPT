  <rdf:Description rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb5182">
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d xml:lang="en">https://en.wikipedia.org/wiki/Condensed_matter_physics</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13"/>
    <owl:annotatedTarget xml:lang="en">The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with "condensed" phases of matter: systems of many constituents with strong interactions between them.</owl:annotatedTarget>
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_220b7201_d277_4dca_bf6a_5a5e2c4062dd"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
