  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_adc5aa0d_9add_4c8a_aa81_b5798a654ca9">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">in a given medium, average distance that particles of a specified type travel between successive interactions of a specified type.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.wikidata.org/wiki/Q756307</emmo:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The mean free path may thus be specified either for all interactions, i.e. total mean free path, or for particular types of interaction such as scattering, capture, or ionization.</rdfs:comment>
    <rdfs:comment xml:lang="en">in a given medium, average distance that particles of a specified type travel between successive interactions of a specified type.</rdfs:comment>
