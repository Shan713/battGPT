    <emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1351/goldbook.S05513</emmo:EMMO_fe015383_afb3_44a6_ae86_043628697aa2>
