  <rdf:Description rdf:about="https://w3id.org/emmo#WattPerSquareMetreKelvin">
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b3502"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b3503"/>
