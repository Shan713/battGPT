    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
