  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_fc859d37_408d_44b6_b345_a0ea0b65121e">
    <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stoffeigenschaft ändern</skos:altLabel>
