  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_f96feb3f_4438_4e43_aa44_7458c4d87fc2">
    <rdfs:label xml:lang="en">HyperfineTransitionFrequencyOfCs</rdfs:label>
    <rdfs:comment xml:lang="en">The frequency standard in the SI system in which the photon absorption by transitions between the two hyperfine ground states of caesium-133 atoms are used to control the output frequency.

It defines the base unit second in the SI system.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_f2ca6dd0_0e5f_4392_a92d_cafdae6cfc95"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_852b4ab8_fc29_4749_a8c7_b92d4fca7d5a"/>
    <skos:prefLabel xml:lang="en">HyperfineTransitionFrequencyOfCs</skos:prefLabel>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/isq#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The frequency standard in the SI system in which the photon absorption by transitions between the two hyperfine ground states of caesium-133 atoms are used to control the output frequency.

It defines the base unit second in the SI system.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  </rdf:Description>
