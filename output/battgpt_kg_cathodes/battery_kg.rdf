    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b2724"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_fced2382_9c23_47a1_8246_a5dcd45ad99c"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b2725"/>
