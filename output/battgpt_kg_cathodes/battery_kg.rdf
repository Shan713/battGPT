    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">We usa a predicate template notation as DP&lt;φ&gt;(x,y) to specify subclasses of DP(x,y) for the class φ, meaning that DP&lt;φ&gt;(x, y) ≡ PP(x, y) ∧ (φ(x) ↔ ¬φ(y))</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">φ is a class of the theory</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DP(x, y) ≡ PP(x, y) ∧ ∃φ[φ(x) ↔ ¬φ(y)]</owl:annotatedTarget>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
