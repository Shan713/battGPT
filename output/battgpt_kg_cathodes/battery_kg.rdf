  <rdf:Description rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb5017">
    <owl:annotatedProperty rdf:resource="https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
    <owl:annotatedTarget xml:lang="en">In Peirce semiotics three subtypes of icon are possible:
(a) the image, which depends on a simple quality (e.g. picture)
(b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy the relations in something (e.g. math formula, geometric flowchart)
(c) the metaphor, which represents the representative character of a sign by representing a parallelism in something else
[Wikipedia]</owl:annotatedTarget>
    <owl:annotatedSource rdf:resource="https://w3id.org/emmo#EMMO_d7788d1a_020d_4c78_85a1_13563fcec168"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Semiotic_theory_of_Charles_Sanders_Peirce#II._Icon,_index,_symbol</rdfs:seeAlso>
  </rdf:Description>
