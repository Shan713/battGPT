  <rdf:Description rdf:about="https://w3id.org/emmo#CubicMetre">
    <skos:prefLabel xml:lang="en">CubicMetre</skos:prefLabel>
    <schema:unitCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MTQ</schema:unitCode>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The SI unit of volume, equal to 1.0e6 cm3, 1000 liters, 35.3147 ft3, or 1.30795 yd3. A cubic meter holds about 264.17 U.S. liquid gallons or 219.99 British Imperial gallons.

-- QUDT</rdfs:comment>
