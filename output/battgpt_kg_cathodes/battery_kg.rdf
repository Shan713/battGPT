  <rdf:Description rdf:about="https://w3id.org/emmo#EMMO_0914449c_ef24_4372_b669_9cdd13b59fed">
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The superclass for all classes of entities that have no proper parts of the same type of the whole is proper part of an entity of that type.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A minimal class M (subclass of Minimal) is defined by choosing a reference type φ so that M is subclass of φ, all parts of x are needed to keep φ(x) and x is proper part of a larger φ entity.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:label xml:lang="en">Minimal</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2"/>
