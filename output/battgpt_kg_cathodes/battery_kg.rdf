    <owl:someValuesFrom rdf:resource="https://w3id.org/emmo#EMMO_608a1b30_df6f_4bbb_9dc3_5c0de92fd9cf"/>
    <owl:onProperty rdf:resource="https://w3id.org/emmo#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569"/>
