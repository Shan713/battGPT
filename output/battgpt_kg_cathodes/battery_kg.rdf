  <rdf:Description rdf:about="https://w3id.org/emmo#AcreFoot">
    <skos:altLabel xml:lang="en">Acre Foot</skos:altLabel>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b31"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_9141801c_c539_4c72_b423_8c74ff6b8f05"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"/>
    <rdfs:subClassOf rdf:nodeID="n6a0b4d77db1d4bb4a28be148935c0b69b32"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/otherunits#"/>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">An acre-foot is a unit of volume commonly used in the United States in reference to large-scale water resources, such as reservoirs, aqueducts, canals, sewer flow capacity, and river flows. It is defined by the volume of one acre of surface area to a depth of one foot. Since the acre is defined as a chain by a furlong (66 ft × 660 ft) the acre-foot is exactly 43,560 cubic feet. For irrigation water, the volume of 1 ft × 1 ac = 43,560 ft³ (1,233.482 m³, 325,851 US gal).

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://en.wikipedia.org/wiki/Acre-foot</emmo:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d>
    <skos:prefLabel xml:lang="en">AcreFoot</skos:prefLabel>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[acr_br].[ft_i]</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <rdfs:label xml:lang="en">AcreFoot</rdfs:label>
    <rdfs:comment xml:lang="en">An acre-foot is a unit of volume commonly used in the United States in reference to large-scale water resources, such as reservoirs, aqueducts, canals, sewer flow capacity, and river flows. It is defined by the volume of one acre of surface area to a depth of one foot. Since the acre is defined as a chain by a furlong (66 ft × 660 ft) the acre-foot is exactly 43,560 cubic feet. For irrigation water, the volume of 1 ft × 1 ac = 43,560 ft³ (1,233.482 m³, 325,851 US gal).

-- QUDT</rdfs:comment>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/AC-FT</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-35</rdfs:seeAlso>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ac⋅ft</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
