  <rdf:Description rdf:about="https://w3id.org/emmo#CoulombSquareMetre">
    <rdfs:comment xml:lang="en">Coulomb Square Meter (C-m2) is a unit in the category of Electric quadrupole moment. This unit is commonly used in the SI unit system. Coulomb Square Meter (C-m2) has a dimension of L2TI where L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</rdfs:comment>
    <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/2.1/vocab/unit</rdfs:isDefinedBy>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/disciplines/units/coherentsiunits#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb345"/>
    <rdfs:subClassOf rdf:nodeID="nd6cec6f81ae84ad2953881773eab9f5eb344"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_92aaff7b_3a7c_4c1a_b149_d422e9682106"/>
    <skos:prefLabel xml:lang="en">CoulombSquareMetre</skos:prefLabel>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/C-M2</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
    <skos:altLabel xml:lang="en">Coulomb Square Metre</skos:altLabel>
    <rdfs:label xml:lang="en">CoulombSquareMetre</rdfs:label>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C.m2</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">Coulomb Square Meter (C-m2) is a unit in the category of Electric quadrupole moment. This unit is commonly used in the SI unit system. Coulomb Square Meter (C-m2) has a dimension of L2TI where L is length, T is time, and I is electric current. This unit is the standard SI unit in this category.

-- QUDT</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
    <emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C⋅m²</emmo:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64>
  </rdf:Description>
