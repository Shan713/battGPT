    <rdfs:label xml:lang="en">Pascal</rdfs:label>
    <emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://qudt.org/vocab/unit/PA</emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc>
