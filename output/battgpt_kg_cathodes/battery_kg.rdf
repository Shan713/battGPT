  <rdf:Description rdf:about="https://w3id.org/battgpt/kg#">
    <owl:imports rdf:resource="https://w3id.org/emmo"/>
    <owl:imports rdf:resource="https://w3id.org/emmo/domain/battery"/>
    <owl:imports rdf:resource="https://w3id.org/emmo/domain/chemical-substance"/>
    <owl:imports rdf:resource="https://w3id.org/emmo/domain/electrochemistry"/>
    <owl:imports rdf:resource="https://w3id.org/battinfo"/>
    <dcterms:description xml:lang="en">Custom predicates, standards-compliant domain classes, and named role individuals for battery materials, crystallography, DFT properties, crystal connectivity, reified bond entities, battery components, and a locally-defined cathode/electrolyte crystal-structure-family taxonomy (verified to have no equivalent upstream in EMMO core, EMMO domain-battery, EMMO domain-electrochemistry, EMMO domain-chemical-substance, or EMMO's work-in-progress domain-crystallography). v0.3.0 additionally imports EMMO domain-electrochemistry explicitly (previously only reachable transitively through domain-battery) and aligns BattGPT's battery-role classes to it via skos:closeMatch.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionInfo>0.3.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/battgpt/kg/0.3.0/battgpt"/>
    <dcterms:isVersionOf rdf:resource="https://w3id.org/battgpt/kg#"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-08-05T00:00:00+00:00</dcterms:created>
    <rdfs:comment xml:lang="en">Contains ObjectProperty, DatatypeProperty, SubClass, and NamedIndividual definitions extending EMMO and BattINFO. Changes in v0.3.0 relative to v0.2.2: (1) explicit owl:imports of EMMO domain-electrochemistry, plus skos:closeMatch from PositiveElectrodeRole/NegativeElectrodeRole/ElectrolyteRole/SeparatorRole to the matching electrochemistry: classes; (2) battery-cell-level electrochemical-quantity properties (hasCapacity, hasSpecificCapacity, hasIonicConductivity, hasOpenCircuitVoltage, hasCRate, hasCoulombicEfficiency, hasStateOfCharge, hasVoltage), all reusing existing EMMO domain-electrochemistry/EMMO-core range classes rather than redefining them; (3) a new StructureFamily taxonomy (StructureFamily / OxideStructureFamily / PolyanionStructureFamily / SulfideStructureFamily and their leaf structure-type classes) plus hasStructureFamily, filling the one gap confirmed absent from the whole imported EMMO/BattINFO closure; (4) a dedicated CoordinationGeometry class so hasCoordinationGeometry no longer shares its range with CrystalSystem/SpaceGroup's generic emmo:Property ancestor; (5) hasBondTo is now formally derived via an owl:propertyChainAxiom (hasBond o hasTargetSite) instead of being a second, independently-asserted fact that could drift from the reified CrystalBond; (6) belongsToElectrode's range is tightened to the union of PositiveElectrodeRole/NegativeElectrodeRole (usesMaterial, its inverse, is left general over all BatteryRole subclasses); (7) BulkModulusProperty/ShearModulusProperty are re-anchored under emmo:Pressure instead of the generic emmo:PhysicalQuantity; (8) CrystalStructure, Site, and UnitCell get explicit grounding (CrystalStructure under owl:Thing like its siblings; Site requires hasSpecies some Species; UnitCell requires hasSite some Site).</rdfs:comment>
    <dcterms:title xml:lang="en">BattGPT Battery Materials Knowledge Graph Predicate &amp; Extension Ontology</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:priorVersion rdf:resource="https://w3id.org/battgpt/kg/0.2.2/battgpt"/>
    <vann:preferredNamespacePrefix>battgpt</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/battgpt/kg#</vann:preferredNamespaceUri>
    <dcterms:creator xml:lang="en">BattGPT Team</dcterms:creator>
  </rdf:Description>
