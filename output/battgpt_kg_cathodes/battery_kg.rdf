  <rdf:Description rdf:about="https://w3id.org/emmo#CoulombPerSquareMetre">
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C/m2</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
    <emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C.m-2</emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652>
