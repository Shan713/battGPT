    <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_bbca6dfa_7463_4e8d_8280_35862ff50ce0"/>
    <skos:prefLabel xml:lang="en">Heap</skos:prefLabel>
    <rdfs:label xml:lang="en">Heap</rdfs:label>
    <emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f xml:lang="en">A heap class H (subclass of Heap) is defined by choosing a reference type φ, with H subclass of φ, so that each H entity has non overlapping φ parts.</emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/perspectives/structural#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The superclass for all classes of entities that have at least two non overlapping proper parts of the same type of the whole.</rdfs:comment>
    <emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 xml:lang="en">The superclass for all classes of entities that have at least two non overlapping proper parts of the same type of the whole.</emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9>
  </rdf:Description>
