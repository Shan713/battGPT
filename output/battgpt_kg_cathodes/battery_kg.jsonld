    "http://www.w3.org/2002/07/owl#annotatedTarget": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "RP(x, y) ≡ PP(x, y) ∧ ∃φ(φ(x) ∧ φ(y))"
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "We usa a predicate template notation as RP<φ>(x,y) to specify subclasses of RP(x,y) for the class φ, meaning that RP<φ>(x, y) ≡ PP(x, y) ∧ φ(x) ∧ φ(y)"
      },
      {
        "@language": "en",
        "@value": "φ is a class of the theory that in the EMMO OWL is supposed to be subclass of CausalStructure."
      }
    ]
  },
