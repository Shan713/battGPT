  {
    "@id": "https://w3id.org/emmo#InverseSquarePlanckMass",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "In physics, the Planck mass, denoted by m_P, is the unit of mass in the system of natural units known as Planck units. It is defined so that ≈  1.2209 × 10 GeV/c₀ = 2.17651(13) × 10 kg, (or 21.7651 μ g), where c₀ is the speed of light in a vacuum, G is the gravitational constant, and ℏ is the reduced Planck constant. Particle physicists and cosmologists often use the reduced Planck mass, which is ≈ 4.341 × 10 kg = 2.435 × 10 GeV/c. The added factor of 1/√(8π) simplifies a number of equations in general relativity. Quantum effects are typified by the magnitude of Planck's constant.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      },
      {
        "@id": "https://w3id.org/emmo/disciplines/units/otherunits#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "InverseSquarePlanckMass"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_6aa04359_50d6_43d7_b3a7_296bd391bf7d"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b1352"
      },
      {
