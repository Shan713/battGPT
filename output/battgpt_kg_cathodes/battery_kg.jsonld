      {
        "@language": "en",
        "@value": "Contrast"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@language": "en",
        "@value": "Luciano Floridi, \"Information - A very Short Introduction\", Oxford University Press., (2010) ISBN 978-0199551378"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_49267eba_5548_4163_8f36_518d65b583f9"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Dedomena"
      },
      {
        "@language": "en",
        "@value": "Pattern"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Contrast"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A perspective in which entities are represented according to the variation of their properties."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "The covering axiom that defines the contrast class discriminates within all the possible causal objects between encoded contrast (data) or non encoded contrast."
      },
      {
        "@language": "en",
        "@value": "A contrast is a causal object whose variations (non-uniformity) can be recognised and eventually interpreted.\nA contrast can be of different physical types (e.g., matter, wave, atomic excited states).\nHow the variations are recognised and eventually decoded depends on the interpreting rules that characterise that type of contrast.\nVariations are pure physical variations and do not necessarily possess semantic meaning."
      }
    ]
  },
