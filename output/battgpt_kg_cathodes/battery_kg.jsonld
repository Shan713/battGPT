      },
      {
        "@id": "https://w3id.org/emmo#EMMO_7610efb8_c7c6_4684_abc1_774783c62472"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b2969"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
