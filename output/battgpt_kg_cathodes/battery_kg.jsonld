  {
    "@id": "https://w3id.org/emmo#EMMO_054af807_85cd_4a13_8eba_119dfdaaf38b",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The interpreter's internal representation of the object in a semiosis process."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/perspectives/semiotics#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Interpretant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4611"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4613"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4608"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_b803f122_4acb_4064_9d71_c1e5fd091fc9"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4609"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A film is the interpretant for a camera, which is the interpreter. The object captured by the camera is the referent. The film is the internal representation of the object, i.e. how the camera understand the object according to its capacity. The film (interpretant) refers to the object (referent) according to the camera (interpreter).\nWhen the film is removed from the camera, developed and printed on photographic paper (or for digital camera the image is downloaded as jpeg and displayed on a laptop) then we create a sign other than the interpretant.\nHowever, in case of analogic film we can always look at the negatve that will suggest the intended referent. This is because both sign and interpretant are related to the referent in a similar way.\n(What we call sign and interpretant in EMMO are both intended as \"signs\" in Peirce semiotics, the first being external signal for the interpreter and the second the internal sign)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Interpretant"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The interpreter's internal representation of the object in a semiosis process."
      }
    ]
  },
