    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The class of individuals that stand for gravitons elementary particles."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "While this particle is only supposed to exist, the EMMO approach to classical and quantum systems represents fields as made of particles.\n\nFor this reason graviton is an useful concept to homogenize the approach between different fields."
      }
    ],
