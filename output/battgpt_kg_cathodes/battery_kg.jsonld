  {
    "@id": "https://w3id.org/battgpt/kg#StructureFamily",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Structural-prototype classification of a crystal structure (e.g. which well-known battery-material structure type it belongs to: layered oxide, olivine, spinel, garnet, sulfide superionic conductor, ...). New in v0.3.0. Confirmed absent from EMMO core, EMMO domain-battery, EMMO domain-electrochemistry, EMMO domain-chemical-substance, and EMMO's work-in-progress domain-crystallography ontology (v0.1.0, not imported here) — this branch is a genuine BattGPT extension, not a restatement of an upstream concept. It is deliberately the deepest local subclass hierarchy in the ontology: it is the intended conditioning vocabulary for hyperbolic (OnT) embedding and for CrystaLLM soft-prompt conditioning. A composite concept like 'Layered Oxide Cathode' is not given its own class; it is queried as a material with hasStructureFamily some LayeredOxideStructure and belongsToElectrode PositiveElectrodeRoleIndividual, which avoids a combinatorial explosion of family-x-role classes, most of which would never be populated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/battgpt/kg#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "StructureFamily"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Structural-prototype classification of a crystal structure."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "StructureFamily"
      }
    ]
  },
