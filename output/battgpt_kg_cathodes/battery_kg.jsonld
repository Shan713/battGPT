    "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b5057",
    "@type": [
      "http://www.w3.org/2002/07/owl#Axiom"
    ],
    "http://www.w3.org/2002/07/owl#annotatedProperty": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedSource": [
      {
        "@id": "https://w3id.org/emmo#EMMO_08cb807c_e626_447b_863f_e2835540e918"
      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedTarget": [
      {
        "@id": "https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "This axiom reflects the fact the the universe is causally self-connected. In fact, a  non causally connected universe would have been the sum of causally independend sub-universes, without any knowledge of others.\nThis axiom may be seen as Ockam's razor applied to causality."
      }
    ]
  },
