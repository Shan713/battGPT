    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "With the causal cluster term we address an heterogeneous group of entities, which possess the common feature of having at least two causally non connected quanta. It comprises collections (non self-connected entities) and causal systems (entities extended in space)."
      },
      {
        "@language": "en",
        "@value": "The disjoint union of the CausalSystem and Collection classes."
      },
      {
        "@language": "en",
        "@value": "The class of individuals representing causal clusters."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
