  {
    "@id": "https://w3id.org/emmo#EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An object which is a temporal part of another object."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/perspectives/persistence#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
