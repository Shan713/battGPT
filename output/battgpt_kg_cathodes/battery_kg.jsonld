  {
    "@id": "https://w3id.org/battgpt/kg#NegativeElectrodeRole",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Anode / negative electrode functional component role. skos:closeMatch targets EMMO domain-electrochemistry's NegativeElectrode class specifically, not its sibling Anode class: NegativeElectrode is polarity-based and stable across charge/discharge, whereas Anode is defined by current direction and, strictly, swaps with Cathode when a secondary cell is charged versus discharged. BatteryRole's role individuals are meant to be stable per-material assignments, so the polarity-based classes are the correct alignment target."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/battgpt/kg#"
      }
    ],
