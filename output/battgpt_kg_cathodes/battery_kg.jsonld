  {
    "@id": "https://w3id.org/emmo#Degree",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Degree is a measurement of plane angle, defined by representing a full rotation as 360 degrees."
      },
      {
        "@language": "en",
        "@value": "A degree (in full, a degree of arc, arc degree, or arcdegree), usually denoted by ° (the degree symbol), is a measurement of plane angle, representing 1/360 of a full rotation; one degree is equivalent to  2π /360 rad, 0.017453 rad. It is not an SI unit, as the SI unit for angles is radian, but is an accepted SI unit.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#"
      }
