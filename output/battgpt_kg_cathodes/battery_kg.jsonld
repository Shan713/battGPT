    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The class for entities which stands for a specific data format expressed using a symbolic encoding."
      },
      {
        "@language": "en",
        "@value": "A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/isq#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "SymbolicData"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://www.w3.org/TR/2012/REC-xmlschema11-2-20120405/#built-in-datatypes"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Datatype_Maps"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://www.w3.org/TR/rdf11-concepts/"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "https://www.w3schools.com/xml/schema_dtypes_numeric.asp"
      }
    ],
