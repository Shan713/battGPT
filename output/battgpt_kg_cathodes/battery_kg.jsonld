        "@language": "en",
        "@value": "hasSpatialSection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_dc57d998_23db_4d8e_b2cd_f346b195b846"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasSpatialPartialPart"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "hasSpatialSection"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A proper part of the whole that is not Spatial or Temporal."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "This relation is a filler, to categorise the parts of an entity that are not covered by the other parthood relations.\nA proper part is then the disjoint union of: spatial part, temporal part and spatio temporal part relations."
      },
      {
        "@language": "en",
        "@value": "This relation identifies parts of a 4D object that do not fully cover the lifetime extent of the whole (spatial) nor the full spatial extent (temporal)."
      }
    ]
  },
