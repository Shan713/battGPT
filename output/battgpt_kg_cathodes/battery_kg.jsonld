  {
    "@id": "https://w3id.org/emmo#EMMO_bbca6dfa_7463_4e8d_8280_35862ff50ce0",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Redundant(x) ≡ ∃φ[φ(x) ∧ ∃yRP⟨φ⟩(y, x)]"
      },
      {
        "@language": "en",
        "@value": "The superclass for all classes of entities that have parts of the same type of the whole."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/perspectives/structural#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Redundant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://w3id.org/emmo#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_32e701c0_a925_49df_9829_0931b8554807"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "NonMaximal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "An object A which is classified as water-fluid possesses a proper part B which is water itself if the lenght scale of the B is larger than the water intermolecular distance keeping it in the continuum range. In this sense, A is redundant.\n\nIf A is a water-fluid so small that its every proper part is no more a continuum object (i.e. no more a fluid), then A is fundamental."
      },
      {
        "@language": "en",
        "@value": "A sufficently large volume of liquid water has parts of the same type."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Redundant"
      }
    ],
    "https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84": [
      {
        "@language": "en",
        "@value": "Redundant(x) ≡ ∃φ[φ(x) ∧ ∃yRP⟨φ⟩(y, x)]"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The superclass for all classes of entities that have parts of the same type of the whole."
      }
    ]
  },
