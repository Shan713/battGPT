  {
    "@id": "https://w3id.org/emmo#EMMO_67fc0a36_8dcb_4ffa_9a43_31074efa3296",
    "@type": [
      "http://www.w3.org/2002/07/owl#IrreflexiveProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#AsymmetricProperty",
      "http://www.w3.org/2002/07/owl#InverseFunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a quantity to its metrological reference through a semiotic process."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/emmo#EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/metrology#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "hasMetrologicalReference"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/emmo#EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_eb3518bf_f799_4f9e_8c3e_ce59af11453b"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "In EMMO version 1.0.0, physical quantities used the hasMetrologicalReference object property to relate them to their units via physical dimensionality. This was simplified in 1.0.0-alpha3 in order to make reasoning faster.\n\nThe restriction (e.g. for the physical quantity Length)\n\n    Length hasMetrologicalReference only (hasPhysicsDimension only LengthDimension)\n\nwas in 1.0.0-alpha3 changed to\n\n    Length hasPhysicsDimension some LengthDimension\n\nLikewise were the universal restrictions on the corresponding unit changed to excistential. E.g.\n\n    Metre hasPhysicsDimension only LengthDimension\n\nwas changed to\n\n    Metre hasPhysicsDimension some LengthDimension\n\nThe label of this class was also changed from PhysicsDimension to PhysicalDimension."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "hasMetrologicalReference"
      }
    ]
  },
