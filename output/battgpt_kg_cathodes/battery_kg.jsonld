      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b3572"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "British Thermal Unit (Thermochemical Definition)"
      }
