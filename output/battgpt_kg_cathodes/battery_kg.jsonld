      {
        "@id": "https://w3id.org/emmo#EMMO_801395f8_948e_4637_ac3b_5fcd587d72ca"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "CompositePhysicalObject"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "A composite physical object is made of bonded objects (i.e. characterised by their quantum states using a Schrodinger equation approach) that are connected together by elementary particles travelling between them. These elemenentary particles are real particles, describing the existance of a classical field (e.g. Coulomb potential between charged particles)."
      }
    ],
