  {
    "@id": "https://w3id.org/emmo#EMMO_74a75cf1_3418_4244_b43c_b5db94635d42",
    "@type": [
      "http://www.w3.org/2002/07/owl#IrreflexiveProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#AsymmetricProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation grouping all direct parthood relations used in the reductionistic perspective."
      },
      {
        "@language": "en",
        "@value": "Tiling parthood enables the establishment of hierarchy of granularities, starting with an entity and providing several tessellation levels according to specific criteria.\nThe criteria are implemented in specialised versions of the tiling parthood relation (e.g., metrological direct part, XML format direct part).\nThe tiles and the tessellated entity (tessellation) are causally self connected (i.e., items), coherently with the concept behind the definition of the reductionistic perspective.\nThe tiles of specific granularity level provide a covering for the whole and are mutually non-overlapping, as the label \"tile\" suggests."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/emmo#EMMO_ee0466e4_780d_4236_8281_ace7ad3fc5d2"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/perspectives/reductionistic#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "hasTile"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/emmo#EMMO_9953c19f_ee33_4af8_be5e_dbf6d1e33581"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_814b6b76_e0ca_4953_a832_d1816fb695f1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasDirectPart"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "hasTile"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "Tiling parthood enables the establishment of hierarchy of granularities, starting with an entity and providing several tessellation levels according to specific criteria.\nThe criteria are implemented in specialised versions of the tiling parthood relation (e.g., metrological direct part, XML format direct part).\nThe tiles and the tessellated entity (tessellation) are causally self connected (i.e., items), coherently with the concept behind the definition of the reductionistic perspective.\nThe tiles of specific granularity level provide a covering for the whole and are mutually non-overlapping, as the label \"tile\" suggests."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The relation grouping all direct parthood relations used in the reductionistic perspective."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "This relation is not antitransitive, to enable partitioning of a causal structure with more than one tiling scheme (e.g. time and space partitioning)."
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "This relation is a simple collector of all relations inverse functional direct parthoods that can be defined in specialised theories using reductionism."
      }
    ]
  },
