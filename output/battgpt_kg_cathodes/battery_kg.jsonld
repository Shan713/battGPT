    "https://w3id.org/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "http://dbpedia.org/resource/Joule"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "SI unit for energy."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "The SI unit of work or energy, defined to be the work done by a force of one newton acting to move an object through a distance of one meter in the direction in which the force is applied. Equivalently, since kinetic energy is one half the mass times the square of the velocity, one joule is the kinetic energy of a mass of two kilograms moving at a velocity of 1 m/s.\n\n-- QUDT"
      }
    ],
    "https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "http://en.wikipedia.org/wiki/Joule?oldid=494340406"
      }
    ],
