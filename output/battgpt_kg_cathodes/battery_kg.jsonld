  {
    "@id": "https://w3id.org/emmo#PlanckLength",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "In physics, the Planck length, denoted ℓₚ, is a unit of length, equal to 1.616199(97)×10⁻³⁵ metres. It is a base unit in the system of Planck units. The Planck length can be defined from three fundamental physical constants: the speed of light in a vacuum, Planck's constant, and the gravitational constant.\n\n-- QUDT"
      }
    ],
