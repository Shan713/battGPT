  {
    "@id": "https://w3id.org/battgpt/kg#",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-08-05T00:00:00+00:00"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@language": "en",
        "@value": "BattGPT Team"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Custom predicates, standards-compliant domain classes, and named role individuals for battery materials, crystallography, DFT properties, crystal connectivity, reified bond entities, battery components, and a locally-defined cathode/electrolyte crystal-structure-family taxonomy (verified to have no equivalent upstream in EMMO core, EMMO domain-battery, EMMO domain-electrochemistry, EMMO domain-chemical-substance, or EMMO's work-in-progress domain-crystallography). v0.3.0 additionally imports EMMO domain-electrochemistry explicitly (previously only reachable transitively through domain-battery) and aligns BattGPT's battery-role classes to it via skos:closeMatch."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://w3id.org/battgpt/kg#"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "BattGPT Battery Materials Knowledge Graph Predicate & Extension Ontology"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "battgpt"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/battgpt/kg#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Contains ObjectProperty, DatatypeProperty, SubClass, and NamedIndividual definitions extending EMMO and BattINFO. Changes in v0.3.0 relative to v0.2.2: (1) explicit owl:imports of EMMO domain-electrochemistry, plus skos:closeMatch from PositiveElectrodeRole/NegativeElectrodeRole/ElectrolyteRole/SeparatorRole to the matching electrochemistry: classes; (2) battery-cell-level electrochemical-quantity properties (hasCapacity, hasSpecificCapacity, hasIonicConductivity, hasOpenCircuitVoltage, hasCRate, hasCoulombicEfficiency, hasStateOfCharge, hasVoltage), all reusing existing EMMO domain-electrochemistry/EMMO-core range classes rather than redefining them; (3) a new StructureFamily taxonomy (StructureFamily / OxideStructureFamily / PolyanionStructureFamily / SulfideStructureFamily and their leaf structure-type classes) plus hasStructureFamily, filling the one gap confirmed absent from the whole imported EMMO/BattINFO closure; (4) a dedicated CoordinationGeometry class so hasCoordinationGeometry no longer shares its range with CrystalSystem/SpaceGroup's generic emmo:Property ancestor; (5) hasBondTo is now formally derived via an owl:propertyChainAxiom (hasBond o hasTargetSite) instead of being a second, independently-asserted fact that could drift from the reified CrystalBond; (6) belongsToElectrode's range is tightened to the union of PositiveElectrodeRole/NegativeElectrodeRole (usesMaterial, its inverse, is left general over all BatteryRole subclasses); (7) BulkModulusProperty/ShearModulusProperty are re-anchored under emmo:Pressure instead of the generic emmo:PhysicalQuantity; (8) CrystalStructure, Site, and UnitCell get explicit grounding (CrystalStructure under owl:Thing like its siblings; Site requires hasSpecies some Species; UnitCell requires hasSite some Site)."
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://w3id.org/emmo"
      },
      {
        "@id": "https://w3id.org/emmo/domain/battery"
      },
      {
        "@id": "https://w3id.org/emmo/domain/chemical-substance"
      },
      {
        "@id": "https://w3id.org/emmo/domain/electrochemistry"
      },
      {
        "@id": "https://w3id.org/battinfo"
      }
    ],
    "http://www.w3.org/2002/07/owl#priorVersion": [
      {
        "@id": "https://w3id.org/battgpt/kg/0.2.2/battgpt"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/battgpt/kg/0.3.0/battgpt"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.3.0"
      }
    ]
