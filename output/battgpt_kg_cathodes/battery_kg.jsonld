    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Normally a standard solution is a solution of the ion at a molality of 1 mol/kg (exactly). Standardized conditions are normally 1013,25 hPa and 25 °C."
      },
      {
        "@language": "en",
        "@value": "ratio of the product of ion molality b and a correction factor γ to the molality b° of the same ion in a standard solution under standardized conditions: a = bγ / b°."
      },
      {
        "@language": "en",
        "@value": "The correction factor is called activity coefficient and it is determined experimentally. See ActivityCoefficient"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/isq#"
