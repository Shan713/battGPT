  {
    "@id": "https://w3id.org/emmo#ElectronVolt",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The amount of energy gained (or lost) by the charge of a single electron moving across an electric potential difference of one volt."
      },
      {
        "@language": "en",
        "@value": "An electron volt (eV) is the energy that an electron gains when it travels through a potential of one volt. You can imagine that the electron starts at the negative plate of a parallel plate capacitor and accelerates to the positive plate, which is at one volt higher potential. Numerically 1 eV approximates 1.6x10⁻¹⁹ joules, where 1 joule is 6.2x10¹⁸ eV. For example, it would take 6.2x10²⁰ eV/sec to light a 100 watt light bulb.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ElectronVolt"
      }
    ],
