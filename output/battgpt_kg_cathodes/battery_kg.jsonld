  {
    "@id": "https://w3id.org/emmo#EMMO_28fbea28_2204_4613_87ff_6d877b855fcd",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Array subclasses with a specific shape can be constructed with cardinality restrictions.\n\nSee Shape4x3Matrix as an example."
      },
      {
        "@language": "en",
        "@value": "Arrays are ordered mathematical objects who's elementary spatial parts are numbers. Their dimensionality is constructed with spatial direct parthood, where 1-dimensional arrays have spatial direct parts Number and n-dimensional array have spatial direct parts (n-1)-dimensional arrays."
      },
      {
        "@language": "en",
        "@value": "Arrays are ordered objects, since they are a subclasses of Arrangement."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/isq#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Array"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A Vector is a 1-dimensional Array with Number as spatial direct parts,\na Matrix is a 2-dimensional Array with Vector as spatial direct parts,\nan Array3D is a 3-dimensional Array with Matrix as spatial direct parts,\nand so forth..."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Array"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "Arrays are ordered mathematical objects who's elementary spatial parts are numbers. Their dimensionality is constructed with spatial direct parthood, where 1-dimensional arrays have spatial direct parts Number and n-dimensional array have spatial direct parts (n-1)-dimensional arrays."
      }
    ]
  },
