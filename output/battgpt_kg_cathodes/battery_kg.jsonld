      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4061"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4062"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_a77a0a4b_6bd2_42b2_be27_4b63cebbb59e"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_be8680e5_28ec_4168_9206_d1cd33fbd458"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4060"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "DegreeCelsius"
      }
    ],
    "https://schema.org/unitCode": [
