    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\"The unit one is the neutral element of any system of units – necessary and present automatically.\"\n\n-- SI Brochure"
      },
      {
        "@language": "en",
        "@value": "Represents the number 1, used as an explicit unit to say something has no units."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/metrology#"
      }
    ],
