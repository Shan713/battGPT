      {
        "@language": "en",
        "@value": "Result of a measurement.\n\nA set of quantity values being attributed to a measurand (quantity) together with any other available relevant information, like measurement uncertainty.\n\n-- VIM"
      }
    ],
    "https://w3id.org/emmo#EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6": [
      {
        "@language": "en",
        "@value": "measurement result"
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "A measurement result generally contains “relevant information” about the set of measured quantity properties, such that some may be more representative of the measured quantity than others. This may be expressed in the form of a probability density function (pdf)."
      },
      {
        "@language": "en",
        "@value": "A measurement result has the measured quantity, measurement uncertainty and other relevant attributes as holistic parts."
      }
    ]
