    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The class of individuals representing mereological fusions consisting of two or more quantum entities."
      },
      {
        "@language": "en",
        "@value": "The union of the CausalCluster and CausalStructure classes."
      },
      {
        "@language": "en",
        "@value": "A mereological fusion is any entity that is made up of two or more quantum entities, regardless of the fact that they are or not self-connected. It captures the idea of set, but excluding singletons."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
