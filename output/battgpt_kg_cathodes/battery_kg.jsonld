    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "`Watt Per Square Meter Per Kelvin `(W m⁻² K⁻¹) is a unit in the category of Thermal heat transfer coefficient. It is also known as watt/square meter-kelvin. This unit is commonly used in the SI unit system. Watt Per Square Meter Per Kelvin (W m⁻² K⁻¹) has a dimension of MT⁻¹Q⁻¹ where M is mass, T is time, and Q is temperature. This unit is the standard SI unit in this category.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/units/coherentsiunits#"
