      },
      {
        "@id": "https://w3id.org/emmo#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Carat"
      }
    ],
