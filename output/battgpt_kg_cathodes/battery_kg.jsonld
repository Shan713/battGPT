    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The customary metric unit of land area, equal to 100 ares. One hectare is a square hectometer, that is, the area of a square 100 meters on each side: exactly 10 000 square meters or approximately 107 639.1 square feet, 11 959.9 square yards, or 2.471 054 acres.\n\n-- QUDT"
      },
      {
        "@language": "en",
        "@value": "A non-SI metric unit of area defined as the square with 100-metre sides."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
