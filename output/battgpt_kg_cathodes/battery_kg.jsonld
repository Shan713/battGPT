      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/emmo#EMMO_c9c8f824_9127_4f93_bc21_69fe78a7f6f2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "kg\nm/s\nkm"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "MeasurementUnit"
      }
    ],
    "https://w3id.org/emmo#EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "DisjointUnionOf: DimensionlessUnit, DimensionalUnit"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "DisjointUnionOf: NonPrefixedUnit, PrefixedUnit"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A metrological reference for a physical quantity."
      }
    ],
    "https://w3id.org/emmo#EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6": [
      {
        "@language": "en",
        "@value": "measurement unit (VIM3 1.9)"
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "\"Unit symbols are mathematical entities and not abbreviations.\"\n\n\"Symbols for units are treated as mathematical entities. In expressing the value of a quantity as the product of a numerical value and a unit, both the numerical value and the unit may be treated by the ordinary rules of algebra.\"\n\nhttps://www.bipm.org/utils/common/pdf/si-brochure/SI-Brochure-9-EN.pdf"
      },
      {
        "@language": "en",
        "@value": "Measurement units and procedure units are disjoint."
      },
      {
        "@language": "en",
        "@value": "\"Real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the second quantity to the first one as a number\"\nISO 80000-1"
      },
      {
        "@language": "en",
        "@value": "Quantitative value are expressed as a multiple of the 'MeasurementUnit'."
      }
    ]
  },
