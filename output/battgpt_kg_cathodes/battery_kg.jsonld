    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "http://www.linfo.org/program.html"
      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedProperty": [
      {
        "@id": "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"
      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedSource": [
      {
        "@id": "https://w3id.org/emmo#EMMO_8681074a_e225_4e38_b586_e85b0f43ce38"
      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedTarget": [
      {
        "@language": "en",
        "@value": "Software is usually used as a generic term for programs. However, in its broadest sense it can refer to all information (i.e., both programs and data) in electronic form and can provide a distinction from hardware, which refers to computers or other electronic systems on which software can exist and be use.\nHere we explicitly include in the definition also all the data (e.g. source code, script files) that takes part to the building of the executable, are necessary to the execution of a program or that document it for the users."
      }
    ]
  },
