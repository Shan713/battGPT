    "https://w3id.org/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "http://dbpedia.org/resource/Lumen"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "SI unit for luminous flux."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "The SI unit for measuring the flux of light being produced by a light source or received by a surface. The intensity of a light source is measured in candelas. One lumen represents the total flux of light emitted, equal to the intensity in candelas multiplied by the solid angle in steradians into which the light is emitted. A full sphere has a solid angle of 4·π steradians. A light source that uniformly radiates one candela in all directions has a total luminous flux of 1 cd·4π sr = 4π cd·sr ≈ 12.57 lumens. \"Lumen\" is a Latin word for light.\n\n-- QUDT"
      }
    ],
    "https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://en.wikipedia.org/wiki/Lumen_(unit)"
      }
    ],
    "https://w3id.org/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "https://doi.org/10.1351/goldbook.L03639"
      }
    ]
  },
