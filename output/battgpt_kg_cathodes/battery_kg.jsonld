  {
    "@id": "https://w3id.org/emmo#EMMO_eb77076b_a104_42ac_a065_798b2d2809ad",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A standalone atom has direct part one 'nucleus' and one 'electron_cloud'.\n\nAn O 'atom' within an O₂ 'molecule' is an 'e-bonded_atom'.\n\nIn this material branch, H atom is a particular case, with respect to higher atomic number atoms, since as soon as it shares its electron it has no nucleus entangled electron cloud.\n\nWe cannot say that H₂ molecule has direct part two H atoms, but has direct part two H nucleus."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/periodictable#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Atom"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_21205421_5783_4d3e_81e5_10c5d894a88a"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4822"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4821"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "ChemicalElement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Atom"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A standalone atom has direct part one 'nucleus' and one 'electron_cloud'.\n\nAn O 'atom' within an O₂ 'molecule' is an 'e-bonded_atom'.\n\nIn this material branch, H atom is a particular case, with respect to higher atomic number atoms, since as soon as it shares its electron it has no nucleus entangled electron cloud.\n\nWe cannot say that H₂ molecule has direct part two H atoms, but has direct part two H nucleus."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "An 'atom' is a 'nucleus' surrounded by an 'electron_cloud', i.e. a quantum system made of one or more bounded electrons."
      }
    ]
  },
