      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4342"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
