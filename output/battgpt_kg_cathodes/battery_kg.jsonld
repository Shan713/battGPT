      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b94"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_33433bb1_c68f_45ee_a466_f01e2c57b214"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Barn"
      }
    ],
    "https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/vocab/unit/BARN"
      }
