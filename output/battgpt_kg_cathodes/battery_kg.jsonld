  {
    "@id": "https://w3id.org/emmo#EMMO_40989212_4866_41c0_8a20_84fd39540f29",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Product of the ion activities of the ions resulting from the dissociation of a solute in a saturated solution, raised to powers equal to their stoichiometric numbers."
      },
      {
        "@language": "en",
        "@value": "For the dissociation of a salt AmBn → mA + nB, the solubility product is KSP = am(A) ⋅ an(B), where a is ionic activity and m and n are the stoichiometric numbers."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/isq#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "SolubilityProduct"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_066937f0_ea5c_4b06_8739_53f66d5ef89e"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b691"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "SolubilityProductConstant"
