  {
    "@id": "https://w3id.org/emmo#EMMO_a69a215c_4f4d_4729_a9c6_39302bbc5f77",
    "@type": [
      "http://www.w3.org/2002/07/owl#IrreflexiveProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#SymmetricProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An interaction between two entities is seen as an exchange of causality relations that goes both ways.\nThere are no requirements about their numbers (except that are minimun two) and their directions (except that there must be a two-way causality, e.g. from x to y and from y to x).\nHowever, interactions can be categorised as:\n- representing a physical interaction (in this case we call it a contact, expression of a spatial relation)\n- or non representing a physical interaction, being simply an arbitrary sum of causality relations between entities.\nThe first case occurs when the causality relations between the quantums of the entities corresponds to the fundamental interactions as described by Feynman diagrams (Quantum Field Theory)."
      },
      {
        "@language": "en",
        "@value": "A symmetric relation occuring when x isDirectCause y and y isDirectCause x."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/foundation/mereocausality-full#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "hasInteractionWith"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_555d0261_da5e_4301_b7f9_46f604a32e91"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "hasInteractionWith"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "An interaction between two entities is seen as an exchange of causality relations that goes both ways.\nThere are no requirements about their numbers (except that are minimun two) and their directions (except that there must be a two-way causality, e.g. from x to y and from y to x).\nHowever, interactions can be categorised as:\n- representing a physical interaction (in this case we call it a contact, expression of a spatial relation)\n- or non representing a physical interaction, being simply an arbitrary sum of causality relations between entities.\nThe first case occurs when the causality relations between the quantums of the entities corresponds to the fundamental interactions as described by Feynman diagrams (Quantum Field Theory)."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A symmetric relation occuring when x isDirectCause y and y isDirectCause x."
      }
    ]
  },
  {
    "@id": "https://w3id.org/emmo#EMMO_5c15f8c4_d2de_47a0_acdd_470b8dda979b",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Internationalized Resource Identifier (IRI) is a compact sequence of characters that identifies an abstract or physical resource. It is similar to URI, but greatly extends the allowed character set from ASCII to the Universal Character Set (Unicode/ISO 10646).."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/computerscience#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "IRI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_c404e6d9_261d_4d2e_ab0d_ba4e05062647"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://en.wiktionary.org/wiki/Ῥόδος"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "IRI"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "An Internationalized Resource Identifier (IRI) is a compact sequence of characters that identifies an abstract or physical resource. It is similar to URI, but greatly extends the allowed character set from ASCII to the Universal Character Set (Unicode/ISO 10646).."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "IRIs are commonly used as identifiers for ontological entities, although the extended unicode character set is rarely used."
      }
    ],
    "https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://en.wikipedia.org/wiki/Internationalized_Resource_Identifier"
      }
    ]
  },
