  {
    "@id": "https://w3id.org/emmo#EMMO_15db234d_ecaf_4715_9838_4b4ec424fb13",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A class devoted to categorize causal objects by specifying their granularity levels."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/perspectives/reductionistic#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Reductionistic"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_49267eba_5548_4163_8f36_518d65b583f9"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Reductionistic"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A class devoted to categorize causal objects by specifying their granularity levels."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Direct parthood is the antitransitive parthood relation used to build the class hierarchy (and the granularity hierarchy) for this perspective."
      },
      {
        "@language": "en",
        "@value": "A granularity level is specified by a tiling decomposition of the whole y. A tiling is identified as a set of items {x1, x2, ... xn} called tiles that:\n    - are proper parts of y\n    - covers the entire whole (y = x1 +x2 + ... + xn)\n    - do not overlap\n    - are part of one, and one only, whole (inverse functional)"
      }
    ]
  },
