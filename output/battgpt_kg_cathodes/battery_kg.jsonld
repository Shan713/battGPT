  {
    "@id": "https://w3id.org/emmo#EMMO_1f2bfb9f_ecc6_46a0_9e41_2d6fcbf59e4b",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The class of fundamental systems where the number of input particles is reduced to one."
      },
      {
        "@language": "en",
        "@value": "A collapse is a fundamental interaction between m colliding particles that results in a single outgoing particle (inverse decay)  that is expressed as a complete bipartite directed graph K(m,1) with m>1."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
