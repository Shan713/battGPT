  {
    "@id": "https://w3id.org/emmo#EMMO_ee7ddcb8_ad8e_4ff7_a09f_889d8edf8f8b",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Vector quantity with magnitude equal to the heat flow rate dΦ through a surface element divided by the area dA of the element, and direction eφ in the direction of propagation of heat."
      },
      {
        "@language": "en",
        "@value": "At a fixed point in a medium, the direction of propagation of heat is opposite to the temperature gradient. At a point on the surface separating two media with different temperatures, the direction of propagation of heat is normal to the surface, from higher to lower temperatures."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/isq#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "DensityOfHeatFlowRate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#emmo_fd2aa864_eef7_4c3d_8243_9ea832d9df3e"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_dae32a4a_d8da_4047_81b0_36a9713fdce1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
