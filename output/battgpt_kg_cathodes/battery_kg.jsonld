      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Example showing how to specify the value of a physical quantity in turtle using hasSIQuantityValue:\n\n    height1 a emmo:Height ;\n        hasSIQuantityValue \"3 cm\"^^emmo:SIQuantityDatatype ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "hasSIQuantityValue"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "Relates a physical quantity to its value specified as a string consisting of a numerical, a separator and a unit."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Using hasSIQuantityValue is a convenient, but less semantic, alternative to specify value and unit of a physical quantity compared to using the 'hasNumericalPart' and 'hasReferencePart'/'hasMetrologicalReference' relations.\n\nThe unit should be a valid, possible prefixed, derived SI unit."
      }
    ]
