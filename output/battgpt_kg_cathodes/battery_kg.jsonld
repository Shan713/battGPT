  {
    "@id": "https://w3id.org/emmo#EMMO_51f426a6_af4a_4e91_a392_2b0bb635e2d5",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a substance to chemical composition."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/emmo#EMMO_bc37743c_37c4_4ec7_9d58_d1aae5567352"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/chemistry#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "hasChemicalComposition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/emmo#EMMO_7efd64d1_05a1_49cd_a7f0_783ca050d4f3"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_eb3518bf_f799_4f9e_8c3e_ce59af11453b"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "This relation can be used to relate a material to a chemical composition quantity of one of its chemical species. For example, the amount of aluminium in substance subst:alloy1 can be expressed as:\n\n```turtle\nsubst:alloy1 a emmo:Substance ;\n    emmo:hasChemicalComposition [\n        a emmo:SingleComponentComposition ;\n        emmo:hasSpeciesPart [ a emmo:AluminiumSymbol ] ;\n        emmo:hasQuantityPart [\n            a emmo:MassFraction ;\n            hasSIQuantityValue \"98.1 wt%\"^^emmo:SIQuantityDatatype\n        ]\n    ] .\n```"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "hasChemicalComposition"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "Relates a substance to chemical composition."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "This property is often used to relate a substance directly to SingleComponentComposition indifiduals for each of its components."
      }
    ]
  },
