  {
    "@id": "https://w3id.org/emmo#WattPerSteradian",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "`Watt Per Steradian (W/sr)` is the unit in the category of Radiant intensity. It is also known as watts per steradian. This unit is commonly used in the SI unit system. Watt Per Steradian (W/sr) has a dimension of M· L⁻²· T⁻³ where M is mass, L is length, and T is time. This unit is the standard SI unit in this category.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
