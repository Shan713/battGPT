  {
    "@id": "https://w3id.org/emmo#InchOfMercury",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Inches of mercury, (inHg) is a unit of measurement for pressure. It is still widely used for barometric pressure in weather reports, refrigeration and aviation in the United States, but is seldom used elsewhere. It is defined as the pressure exerted by a column of mercury of 1 inch in height at 32 °F at the standard acceleration of gravity. 1 inHg = 3,386.389 pascals at 0 °C.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      },
      {
