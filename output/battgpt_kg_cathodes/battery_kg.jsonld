      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedTarget": [
      {
        "@language": "en",
        "@value": "Causality is the fundamental concept describing how entities affect each other, and conceptually precedes time and space relations. In the EMMO causality is the foundation for space and time relations.\nEmbracing a strong reductionistic view, causality originates at quantum entities level, meaning that causal relations between macroscopic entities is simply the sum of quantum level causality relations."
      }
    ]
  },
