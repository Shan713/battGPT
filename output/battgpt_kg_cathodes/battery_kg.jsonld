  {
    "@id": "https://w3id.org/emmo#EMMO_555d0261_da5e_4301_b7f9_46f604a32e91",
    "@type": [
      "http://www.w3.org/2002/07/owl#IrreflexiveProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Direct causality is a concept that captures the idea of direct interaction between two entities, given the fact that there are no causal intermediaries between them. It requires that at least a quantum of the causing entity is direct cause of a quantum of the caused entity.\nIt does not exclude the possibility of other indirect causal routes between some proper parts of the two entities.\nThe direct causality in a 4D ontology covers both time-like causal interaction (when causality is one-way from one entity to another) and space-like causal interaction (when causality is two-way between two entities)."
      },
      {
        "@language": "en",
        "@value": "A causal relation between the causing and the effected entities occurring without intermediaries."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/foundation/mereocausality#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "directlyCauses"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_d67ee67e_4fac_4676_82c9_aec361dba698"
      }
    ],
    "http://www.w3.org/2002/07/owl#propertyDisjointWith": [
      {
        "@id": "https://w3id.org/emmo#EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "isDirectCauseOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "directlyCauses"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "Direct causality is a concept that captures the idea of direct interaction between two entities, given the fact that there are no causal intermediaries between them. It requires that at least a quantum of the causing entity is direct cause of a quantum of the caused entity.\nIt does not exclude the possibility of other indirect causal routes between some proper parts of the two entities.\nThe direct causality in a 4D ontology covers both time-like causal interaction (when causality is one-way from one entity to another) and space-like causal interaction (when causality is two-way between two entities)."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A causal relation between the causing and the effected entities occurring without intermediaries."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Direct cause is irreflexive."
      },
      {
        "@language": "en",
        "@value": "Direct cause provides the edges for the transitive restriction of the direct acyclic causal graph whose nodes are the quantum entities."
      }
    ]
  },
