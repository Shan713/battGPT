      {
        "@language": "en",
        "@value": "ProcedureUnit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "MeasurementProcedure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Rockwell C hardness of a given sample (150 kg load): 43.5HRC(150 kg)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "ProcedureUnit"
      }
    ],
