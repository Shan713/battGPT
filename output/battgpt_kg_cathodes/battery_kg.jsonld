  {
    "@id": "https://w3id.org/emmo#EMMO_eb50c9cb_9576_4a61_95ec_f81fb8218187",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The superclass for all classes of individuals that requires to have a part of another specific class of entity of different type with a specific relation with it."
      },
      {
        "@language": "en",
        "@value": "The qualified whole concept express the requirement for an entity of a type, say A, to have a part of another type, say B, with A and B belonging to different taxonomical branches.\nThe concept of whole is then defined as something that needs a part of a specific type to exist.\nFor example, an atom always requires a nucleus part to exist (but not viceversa)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/metrology#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "QualifiedWhole"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_0277f24a_ea7f_4917_81b7_fb0406c8fc62"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "QWhole"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "QualifiedWhole"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "The qualified whole concept express the requirement for an entity of a type, say A, to have a part of another type, say B, with A and B belonging to different taxonomical branches.\nThe concept of whole is then defined as something that needs a part of a specific type to exist.\nFor example, an atom always requires a nucleus part to exist (but not viceversa)"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The superclass for all classes of individuals that requires to have a part of another specific class of entity of different type with a specific relation with it."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Al QWhole subclasses shuld have an axiom to express the part requirements, in the form of:\nMyQWholeClass\n    SubClassOf: hasProperPart some AnotherClass\nThis is a necessary but not sufficient condition."
      }
    ]
  },
