    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/perspectives/contrast#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "NonEncodedContrast"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "EnvironmentalData"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A cloud in the sky. The radiative spectrum of a star."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "NonEncodedContrast"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "Contrast that occurs naturally without an encoding agent producing it."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "This is a really broad class that gathers all physical phenomena in which a contrast occurs naturally, such as cloud patterns, tree rings, stains.\nIt doesn't mean that such contrasts cannot be used to deduce something: in fact they can be seen as indexes (in semiotic sense) of a causally connected phenomena. Simply, there is no agent behind that contrast with the intention to transmit data."
      },
      {
        "@language": "en",
        "@value": "A non encoded contrast (e.g. a temperature variation) can be represented by data that describes (e.g. the string \"today it's warmer than yesterday\") or quantifies (e.g. Monday 28 °C, Tuesday 30 °C) it through a semiotic process."
      }
    ]
  },
