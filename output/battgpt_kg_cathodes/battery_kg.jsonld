    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The class of individuals standing for an amount of ordinary matter substance."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "A instance of a material (e.g. nitrogen) can represent any state of matter. The fact that the individual also belongs to other classes (e.g. Gas) would reveal the actual form in which the material is found."
      },
      {
        "@language": "en",
        "@value": "Material usually means some definite kind, quality, or quantity of matter, especially as intended for use."
      },
      {
        "@language": "en",
        "@value": "A material may be either a mesoscopic or a continuum substance."
      }
    ]
  },
