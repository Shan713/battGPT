    "https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/vocab/unit/M3-PER-SEC"
      }
    ],
    "https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "m3.s-1"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "m3/s"
      }
    ],
    "https://w3id.org/emmo#EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "m³/s"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A cubic metre per second (m³s⁻¹, m³/s), cumecs or cubic meter per second in American English) is a derived SI unit of flow rate equal to that of a stere or cube with sides of one metre ( u0303 39.37 in) in length exchanged or moving each second. It is popularly used for water flow, especially in rivers and streams, and fractions for HVAC values measuring air flow.\n\n-- QUDT"
      }
    ]
  },
