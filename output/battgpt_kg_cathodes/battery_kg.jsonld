    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "A whole is always defined using a criterion expressed through the classical transitive parthood relation.\nThis class is expected to host the definition of world objects as they appear in its wholeness, dependently on some of their parts and independently on the surroundings."
      },
      {
        "@language": "en",
        "@value": "A whole is categorized as fundamental (or maximal) or redundant (non-maximal)."
