  {
    "@id": "https://w3id.org/emmo#WattPerSquareMetreSteradian",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "`Watt per steradian per square metre` is the SI unit of radiance (W·sr⁻¹·m⁻²), while that of spectral radiance in frequency is the watt per steradian per square metre per hertz (W·sr⁻¹·m⁻²·Hz⁻¹) and that of spectral radiance in wavelength is the watt per steradian per square metre, per metre (W·sr⁻¹·m⁻³), commonly the watt per steradian per square metre per nanometre (W·sr⁻¹·m⁻²·nm⁻¹). It has a dimension of ML⁻⁴T⁻³ where M is mass, L is length, and T is time. This unit is the standard SI unit in this category.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      },
      {
        "@id": "https://w3id.org/emmo/disciplines/units/coherentsiunits#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "WattPerSquareMetreSteradian"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://www.efunda.com/glossary/units/units--radiance--watt_per_square_meter_per_steradian.cfm"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b3510"
      },
      {
