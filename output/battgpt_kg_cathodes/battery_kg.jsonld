  {
    "@id": "https://w3id.org/emmo#EMMO_668fbd5b_6f1b_405c_9c6b_d6067bd0595a",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A matter object throughout which all physical properties of a material are essentially uniform."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
