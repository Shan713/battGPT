  {
    "@id": "https://w3id.org/emmo#PlanckImpedance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Planck impedance is the unit of electrical resistance, denoted by Zₚ, in the system of natural units known as Planck units. The Planck impedance is directly coupled to the impedance of free space, Z₀, and differs in value from Z₀ only by a factor of 4π. If the Planck charge were instead defined to normalize the permittivity of free space, ε₀, rather than the Coulomb constant, 1/(4πε₀), then the Planck impedance would be identical to the characteristic impedance of free space.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/units/unclassifiedunits#"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "PlanckImpedance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"
      },
