  {
    "@id": "https://w3id.org/emmo#PascalSecondPerMetre",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Pascal Second Per Meter (Pa-s/m) is a unit in the category of Specific acoustic impedance. It is also known as pascal-second/meter. Pascal Second Per Meter has a dimension of ML²T⁻¹ where M is mass, L is length, and T is time. It essentially the same as the corresponding standard SI unit kg/m2· s.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      },
      {
        "@id": "https://w3id.org/emmo/disciplines/units/coherentsiunits#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "PascalSecondPerMetre"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://www.efunda.com/glossary/units/units--specific_acoustic_impedance--pascal_second_per_meter.cfm"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
