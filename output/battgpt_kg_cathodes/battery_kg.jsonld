    "@id": "https://w3id.org/emmo#EMMO_e56ee3eb_7609_4ae1_8bed_51974f0960a6",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An equation with variables can always be represented as:\n\nf(v0, v1, ..., vn) = g(v0, v1, ..., vn)\n\nwhere f is the left hand and g the right hand  side expressions and v0, v1, ..., vn are the variables."
      },
      {
        "@language": "en",
        "@value": "The class of 'mathematical'-s that stand for a statement of equality between two mathematical expressions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/math#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Equation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_88470739_03d3_4c47_a03e_b30a1288d50c"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4484"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "2+3 = 5\nx^2 +3x  = 5x\ndv/dt = a\nsin(x) = y"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Equation"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The class of 'mathematical'-s that stand for a statement of equality between two mathematical expressions."
      }
    ]
  },
