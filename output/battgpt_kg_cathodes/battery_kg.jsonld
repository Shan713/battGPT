    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A parabolic function is a prediction of the trajectory of a falling object in a gravitational field. While it has predictive capabilities it lacks of an analogical character, since it does not show the law behind that trajectory."
