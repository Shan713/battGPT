        "@id": "https://w3id.org/emmo/perspectives/persistence#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "hasParticipant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/emmo#EMMO_13191289_6c2b_4741_93e1_82d53bd0e703"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
