  {
    "@id": "https://w3id.org/emmo#EMMO_c26a0340_d619_4928_b1a1_1a04e88bb89d",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The union of all classes categorising elementary particles according to the Standard Model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/reference/standardmodel-full#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "StandardModelParticle"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_3f9ae00e_810c_4518_aec2_7200e424cf68"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/emmo#EMMO_8dbaf3ca_8f0d_4c45_92e1_c6d805b83c87"
          },
          {
            "@id": "https://w3id.org/emmo#EMMO_fa3c9d4d_9fc9_4e8a_82c1_28c84e34133a"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "ElementaryParticle"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "StandardModelParticle"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The union of all classes categorising elementary particles according to the Standard Model."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "This class represents only real particles that are the input and output of a Feynman diagram, and hence respect the E²-p²c²=m²c⁴ energy-momentum equality (on the mass shell).\nIn the EMMO the virtual particles (off the mass shell), the internal propagators of the interaction within a Feynman diagram, are not represented as mereological entities but as object relations (binary predicates)."
      },
      {
        "@language": "en",
        "@value": "Graviton is included, even if it is an hypothetical particle, to enable causality for gravitational interactions."
      },
      {
        "@language": "en",
        "@value": "Disjointness comes from the fact that standard model elementary particles are entities that possess objectively distinct and singular characters."
      }
    ]
  },
