  {
    "@id": "https://w3id.org/emmo#EMMO_bafc17b5_9be4_4823_8bbe_ab4e90b6738c",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A process occurring with the active participation of an intentional agent that drives the process according to a specific objective (intention)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/metrology#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "IntentionalAgency"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_a49c2441_1e54_43f0_a1cf_2f553a23ac34"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4631"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "IntentionalProcess"
      },
      {
        "@language": "en",
        "@value": "Project"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "IntentionalAgency"
      }
    ],
    "https://w3id.org/emmo#EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "SubClassOf: hasAgent some IntentionalAgent"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A process occurring with the active participation of an intentional agent that drives the process according to a specific objective (intention)."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "The concept is not restricted to agencies where the agent accomplish its intention. For example, breaking a vase while reaching for a book is an intentional agency, because the action causing the vase to fall and break follows a volition (i.e., an act of willing).\nIntentional agency may be further categorised acccording to the fact that the some of the resulting processes may or may not be coherent with the volition."
      }
    ]
  },
