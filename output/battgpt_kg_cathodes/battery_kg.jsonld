    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Following nominalistic approach a species is simply a name that can point to an element name, a chemical formula or a chemical compound.\n\nSo everything addressed by these classes of names can be calleded a chemical species."
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Specific form of an element defined as to isotopic composition, electronic or oxidation state, and/or complex or molecular structure.\n\nChemical species is the macroscopic equivalent of molecular entity and refers to sets or ensembles of molecular entities."
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "N2\nMethane\nCH4\nFe\nSodium Chloride"
      }
    ],
