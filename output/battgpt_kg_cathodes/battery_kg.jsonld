      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4416"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
