  {
    "@id": "https://w3id.org/emmo#EMMO_43a4e80d_6ae9_45ed_8cfb_fd0a5339bf87",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A causal system that is the representation of a Feynman diagram, where quantum represents the real particles entering and exiting the system."
      },
      {
        "@language": "en",
        "@value": "A fundamental physical process is made of one or more standard particles as input, and one or more standard particles as output, where each input is direct cause of each output.\nEach fundamental physical phenomena refers to a Feynman diagram, hence is made at least of three standard model particles.\nThis requirement implies that a physical phenomena is either a decay, annihilation, interaction, collapse or creation phenomena (fundamental) or a composition of them (non-fundamental)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/reference/standardmodel#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "FundamentalPhysicalSystem"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/emmo#EMMO_b295158f_fda4_4124_ab58_d9ea4ccfca5a"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "FundamentalPhysicalSystem"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "A fundamental physical process is made of one or more standard particles as input, and one or more standard particles as output, where each input is direct cause of each output.\nEach fundamental physical phenomena refers to a Feynman diagram, hence is made at least of three standard model particles.\nThis requirement implies that a physical phenomena is either a decay, annihilation, interaction, collapse or creation phenomena (fundamental) or a composition of them (non-fundamental)."
      }
    ],
    "https://w3id.org/emmo#EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "DisjointUnionOf: Collapse, Interaction, Decay"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A causal system that is the representation of a Feynman diagram, where quantum represents the real particles entering and exiting the system."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "A fundamental system is expressed as a complete bipartite directed graph K(m,n) of quantums, m being the number of originating quantums, and n being the receiving quantums."
      }
    ]
  },
