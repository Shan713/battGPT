  {
    "@id": "https://w3id.org/emmo#EMMO_ae2d1a96_bfa1_409a_a7d2_03d69e8a125a",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Participation is a parthood relation: you must be part of the process to contribute to it. A participant whose 4D extension is totally contained within the process.\n\nParticipation is not under direct parthood since a process is not strictly related to reductionism, but it's a way to categorise temporal regions by the interpreters."
      },
      {
        "@language": "en",
        "@value": "The relation between a process and an object participating to it, i.e. that is relevant to the process itself."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/emmo#EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce"
      }
    ],
