  {
    "@id": "https://w3id.org/emmo#EMMO_52b8a39b_e5ff_46d3_b972_65bc43077a07",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The class of individuals representing causal particles."
      },
      {
        "@language": "en",
        "@value": "The disjoint union of CausalPath and Quantum classes."
      },
      {
        "@language": "en",
        "@value": "A causal particle represents the most elementary entity in physics, being it a simple state of an elementary particle, called quantum in the EMMO, or a chain of causally connected quanta."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
