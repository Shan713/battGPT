    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A non-SI unit of volume defined as 1 cubic decimetre (dm3),"
      },
      {
        "@language": "en",
        "@value": "Other used symbols for litre are \"l\" and \"ℓ\"."
      },
      {
        "@language": "en",
        "@value": "The litre (American spelling: `liter`; SI symbol l or L) is a non-SI metric system unit of volume equal to 1 `cubic decimetre` (dm³), 1,000 cubic centimetres (cm³) or 1/1000 `cubic metre`. If the lower case \"L\" is used as the symbol, it is sometimes rendered as a italic \"l\" to help distinguish it from the capital \"I\", although this usage has no official approval by any international bureau.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/units/prefixedsiunits#"
