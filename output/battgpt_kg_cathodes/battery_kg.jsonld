  {
    "@id": "https://w3id.org/emmo#WattPerSquareMetre",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "\"Watt per Square Meter} is a unit of irradiance defined as the power received per area. This is a unit in the category of Energy flux. It is also known as watts per square meter, watt per square metre, watts per square metre, watt/square meter, watt/square metre. This unit is commonly used in the SI unit system. Watt Per Square Meter (W/m²) has a dimension of MT^{-3\" where M is mass, and T is time. This unit is the standard SI unit in this category.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      },
      {
