  {
    "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b5017",
    "@type": [
      "http://www.w3.org/2002/07/owl#Axiom"
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://en.wikipedia.org/wiki/Semiotic_theory_of_Charles_Sanders_Peirce#II._Icon,_index,_symbol"
      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedProperty": [
      {
        "@id": "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"
      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedSource": [
      {
        "@id": "https://w3id.org/emmo#EMMO_d7788d1a_020d_4c78_85a1_13563fcec168"
      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedTarget": [
      {
        "@language": "en",
        "@value": "In Peirce semiotics three subtypes of icon are possible:\n(a) the image, which depends on a simple quality (e.g. picture)\n(b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy the relations in something (e.g. math formula, geometric flowchart)\n(c) the metaphor, which represents the representative character of a sign by representing a parallelism in something else\n[Wikipedia]"
      }
    ]
  },
