  {
    "@id": "https://w3id.org/emmo#EMMO_f658c301_ce93_46cf_9639_4eace2c5d1d5",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A symbolic that has parts a numerical object and a reference expressing the value of a quantity (expressed as the product of the numerical and the unit)."
      },
      {
        "@language": "en",
        "@value": "Following the International Vocabulary of Metrology (VIM), EMMO distinguishes between a quantity (a property) and the quantity value (a numerical and a reference).\n\nSo, for the EMMO the symbol \"kg\" is not a physical quantity but simply a 'Symbolic' object categorized as a 'MeasurementUnit'.\n\nWhile the string \"1 kg\" is a 'QuantityValue'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/metrology#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "QuantityValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4632"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4634"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_985bec21_989f_4b9e_a4b3_735d88099c3c"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_64c72d00_7582_44ea_a0b5_3a14e50acc36"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4633"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_35d2e130_6e01_41ed_94f7_00b333d46cf9"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_e12dcfa4_c9f1_4546_9a12_8457c052e6ba"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "6.8 m\n0.9 km\n8 K\n6 MeV\n43.5 HRC(150 kg)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "QuantityValue"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A symbolic that has parts a numerical object and a reference expressing the value of a quantity (expressed as the product of the numerical and the unit)."
      }
    ],
    "https://w3id.org/emmo#EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6": [
      {
        "@language": "en",
        "@value": "quantity value"
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "A quantity value is not necessarily a property, since it is possible to write \"10 kg\", without assigning this quantity to a specific object."
      }
    ]
  },
