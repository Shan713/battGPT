  {
    "@id": "https://w3id.org/emmo#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "The disjoint union of Causal Path and CausalSystem classes."
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "The class of individuals representing causally self-connected world entities."
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "The most fundamental unity criterion for the definition of an structure is that:\n- is made of at least two quantums (a structure is not a simple entity)\n- all quantum parts form a causally connected graph"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/isq#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "CausalStructure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_53ed8611_2cd7_4286_9ef0_36572117b963"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "CausalStructure"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "The most fundamental unity criterion for the definition of an structure is that:\n- is made of at least two quantums (a structure is not a simple entity)\n- all quantum parts form a causally connected graph"
      }
    ],
    "https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "The disjoint union of Causal Path and CausalSystem classes."
      }
    ],
    "https://w3id.org/emmo#EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "EquivalentTo: CausalPath or CausalSystem"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "The class of individuals representing causally self-connected world entities."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "A causal structure expresses itself in time and space thanks to the underlying causality relations between its constituent quantum entities. It must at least provide two temporal parts. The unity criterion beyond the definition of a causal structure (the most general concept of structure) is the existence of an undirected causal path between each of its parts."
      }
    ]
  },
