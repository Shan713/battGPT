    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "hasMetrologicalUncertainty"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "Assigns a quantifiable uncertainty to an objective property through a well-defined procecure."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Since measurement uncertainty is a subclass of objective property, this relation can also describe the uncertainty of an measurement uncertainty."
      }
    ]
  },
