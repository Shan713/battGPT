  {
    "@id": "https://w3id.org/emmo#EMMO_2d2ecd97_067f_4d0e_950c_d746b7700a31",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The class of not direct causally self-connected world entities."
      },
      {
        "@language": "en",
        "@value": "A collection is the concept that complements the item. A collection is an entity that has at least one part non directly causally connected with the rest.\nA collection can be partitioned in maximally connected items called members. The members are self-connected entities and there is no direct causality relation between them.\nThe combination of collection and item concepts is the EMMO mereocausality alternative to set theory. However, two items can be members only if they are non direct causally connected, giving some constraints to a collection definition. For example, two entities which are directly connected cannot be two distinct members, while their interiors (i.e. the entities obtained by removing the layer of parts that provides the causal contact between them) can be."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/foundation/mereocausality#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Collection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4716"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_76bd5e44_bf5a_49f9_a517_eea5e8bcbc2d"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/emmo#EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "The collection of users of a particular software, the collection of atoms that have been part of that just dissociated molecule."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Collection"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "A collection is the concept that complements the item. A collection is an entity that has at least one part non directly causally connected with the rest.\nA collection can be partitioned in maximally connected items called members. The members are self-connected entities and there is no direct causality relation between them.\nThe combination of collection and item concepts is the EMMO mereocausality alternative to set theory. However, two items can be members only if they are non direct causally connected, giving some constraints to a collection definition. For example, two entities which are directly connected cannot be two distinct members, while their interiors (i.e. the entities obtained by removing the layer of parts that provides the causal contact between them) can be."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The class of not direct causally self-connected world entities."
      }
    ]
  },
