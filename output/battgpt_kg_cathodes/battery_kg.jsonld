      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/vocab/unit/WB"
      }
    ],
    "https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Wb"
      }
    ],
    "https://w3id.org/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "http://dbpedia.org/resource/Weber"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "SI unit for magnetic flux."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "The SI unit of magnetic flux. \"Flux\" is the rate (per unit of time) at which something crosses a surface perpendicular to the flow. The weber is a large unit, equal to 10⁸ maxwells, and practical fluxes are usually fractions of one weber. The weber is the magnetic flux which, linking a circuit of one turn, would produce in it an electromotive force of 1 volt if it were reduced to zero at a uniform rate in 1 second. In SI base units, the dimensions of the weber are (kg·m²)/(s²·A). The weber is commonly expressed in terms of other derived units as the Tesla-square meter (T·m²), volt-seconds (V·s), or joules per ampere (J/A)."
      }
    ],
    "https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://en.wikipedia.org/wiki/Weber_(unit)"
      }
    ],
    "https://w3id.org/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "https://doi.org/10.1351/goldbook.W06666"
      }
    ]
  },
  {
    "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4342",
