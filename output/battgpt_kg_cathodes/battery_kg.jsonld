    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "For an atom or nucleus, this energy is quantized and can be written as:\n\n    W = g μ M B\n\nwhere g is the appropriate g factor, μ is mostly the Bohr magneton or nuclear magneton, M is magnetic quantum number, and B is magnitude of the magnetic flux density.\n\n-- ISO 80000"
      },
      {
        "@language": "en",
        "@value": "Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:\n\n    ΔW = −μ · B"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/isq#"
      }
    ],
