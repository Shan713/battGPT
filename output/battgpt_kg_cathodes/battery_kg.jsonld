  {
    "@id": "https://w3id.org/emmo#EMMO_463bcfda_867b_41d9_a967_211d4d437cfb",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A measurement is the process of experimentally obtaining one or more measurement results that can reasonably be attributed to a quantity."
      },
      {
        "@language": "en",
        "@value": "An 'observation' that results in a quantitative comparison of a 'property' of an 'object' with a standard reference based on a well defined mesurement procedure."
      },
      {
        "@language": "en",
        "@value": "A measurement always implies a causal interaction between the object and the observer."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/metrology#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Measurement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4100"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_3b19eab4_79be_4b02_bdaf_ecf1f0067a68"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4099"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4102"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_472a0ca2_58bf_4618_b561_6fe68bd9fd49"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4103"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4101"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "MeasurementProcedure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Measurement"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "An 'observation' that results in a quantitative comparison of a 'property' of an 'object' with a standard reference based on a well defined mesurement procedure."
      }
    ],
    "https://w3id.org/emmo#EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6": [
      {
        "@language": "en",
        "@value": "measurement"
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "The output of a measurement is in EMMO a measurement result, which in turn is attributed to one or more measurement values."
      },
      {
        "@language": "en",
        "@value": "For convinience, the semiotic shortcuts `hasMeasurementValue` and `hasMeasurementQuantity` allows the user to directly relate a measurement to the measured QuantityValue and Quantity, respectively."
      }
    ]
  },
