  {
    "@id": "https://w3id.org/emmo#EMMO_499e24a5_5072_4c83_8625_fe3f96ae4a8d",
    "@type": [
      "http://www.w3.org/2002/07/owl#IrreflexiveProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#AsymmetricProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A temporal relation between two entities occurs when the two entities are in a one directional causality relation. The idea is that a temporal relation always implies a one-directional causality between two entities, leading to a asymmetric relation.\nThis means that the causing entity can be in direct and optionally indirect causality relation with the effect entity. On the contrary, the effect entity cannot be in any causal relation (direct or indirect) with the causing entity."
      },
      {
        "@language": "en",
        "@value": "A time contact occurs when x isDirectCause y and not(y isCauseOf x)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/foundation/mereocausality#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "precedes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_ebc9e62c_5dc4_44db_9060_7923740bdf78"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_555d0261_da5e_4301_b7f9_46f604a32e91"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_60c57607_c9e7_4e75_a3d1_7a1f1f9928e4"
      }
    ],
    "http://www.w3.org/2002/07/owl#propertyDisjointWith": [
      {
        "@id": "https://w3id.org/emmo#EMMO_8785be5a_2493_4b12_8f39_31907ab11748"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_a69a215c_4f4d_4729_a9c6_39302bbc5f77"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "hasNext"
      },
      {
        "@language": "en",
        "@value": "isBefore"
      },
      {
        "@language": "en",
        "@value": "foregoes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "My life between 18-24 years has next my life between 24-32 years."
      },
      {
        "@language": "en",
        "@value": "The raw sample has next the treated sampled, which has next the examined sample. In this sense the whole sample is made of three states, connected by the has next relation, following its evolution in time."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "precedes"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "A temporal relation between two entities occurs when the two entities are in a one directional causality relation. The idea is that a temporal relation always implies a one-directional causality between two entities, leading to a asymmetric relation.\nThis means that the causing entity can be in direct and optionally indirect causality relation with the effect entity. On the contrary, the effect entity cannot be in any causal relation (direct or indirect) with the causing entity."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A time contact occurs when x isDirectCause y and not(y isCauseOf x)."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "This relation is asymmetric and irreflexive."
      },
      {
        "@language": "en",
        "@value": "Each pair of entities in direct causality relation is either in hasNext or hasTwoWayCauseWith relation. The two are mutually exclusive."
      }
    ]
  },
  {
    "@id": "https://w3id.org/emmo#EMMO_90589553_5625_4074_8f0d_0532fd7eb42b",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A manufacturing process in which the shape of a workpiece is changed by breaking the material cohesion at the processing point and thus the material cohesion is reduced overall."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/manufacturing#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "SeparateManufacturing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@language": "en",
        "@value": "DIN 8580:2020"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_8786cb47_8e1f_4968_9b15_f6d41fc51252"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "CuttingManufacturing"
      },
      {
        "@language": "de",
        "@value": "Trennen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "SeparateManufacturing"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A manufacturing process in which the shape of a workpiece is changed by breaking the material cohesion at the processing point and thus the material cohesion is reduced overall."
      }
    ]
  },
