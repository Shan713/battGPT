  {
    "@id": "https://w3id.org/emmo#JoulePerMole",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The joule per mole (symbol: J· mol⁻¹) is an SI derived unit of energy per amount of material. Energy is measured in joules, and the amount of material is measured in moles. Physical quantities measured in J· mol⁻¹) usually describe quantities of energy transferred during phase transformations or chemical reactions. Division by the number of moles facilitates comparison between processes involving different quantities of material and between similar processes involving different types of materials. The meaning of such a quantity is always context-dependent and, particularly for chemical reactions, is dependent on the (possibly arbitrary) definition of a 'mole' for a particular process.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      },
      {
        "@id": "https://w3id.org/emmo/disciplines/units/coherentsiunits#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "JoulePerMole"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b3974"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b3973"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_0972cb08_48bd_4524_ac03_8a2e7f30f02f"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Joule per Mole"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
