  {
    "@id": "https://w3id.org/emmo#Bel",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A logarithmic unit of sound pressure equal to 10 decibels (dB),  It is defined as: 1 B = (1/2) log₁₀(Np)\n\n-- QUDT"
      },
      {
        "@language": "en",
        "@value": "One bel is defined as `1⁄2 ln(10) neper`."
      },
      {
        "@language": "en",
        "@value": "Today decibel (one tenth of a bel) is commonly used instead of bel."
      },
      {
        "@language": "en",
        "@value": "bel is used to express the ratio of one value of a power or field quantity to another, on a logarithmic scale, the logarithmic quantity being called the power level or field level, respectively."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
