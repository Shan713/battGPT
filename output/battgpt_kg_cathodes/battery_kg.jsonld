  {
    "@id": "https://w3id.org/emmo#EMMO_3397f270_dfc1_4500_8f6f_4d0d85ac5f71",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An atom-based state defined by an exact number of e-bonded atomic species and an electron cloud made of the shared electrons."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/reference/physicalistic#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Molecule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_21205421_5783_4d3e_81e5_10c5d894a88a"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4090"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4089"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "ChemicalSubstance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "H₂0, C₆H₁₂O₆, CH₄"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Molecule"
      }
    ],
    "https://w3id.org/emmo#EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "DisjointUnionOf: Heteronuclear, Homonuclear"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "An atom-based state defined by an exact number of e-bonded atomic species and an electron cloud made of the shared electrons."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "An entity is called essential if removing one direct part will lead to a change in entity class.\nAn entity is called redundant if removing one direct part will not lead to a change in entity class."
      },
      {
        "@language": "en",
        "@value": "This definition states that this object is a non-periodic set of atoms or a set with a finite periodicity.\nRemoving an atom from the state will result in another type of atom_based state.\ne.g. you cannot remove H from H₂0 without changing the molecule type (essential). However, you can remove a C from a nanotube (redundant). C60 fullerene is a molecule, since it has a finite periodicity and is made of a well defined number of atoms (essential). A C nanotube is not a molecule, since it has an infinite periodicity (redundant)."
      }
    ]
  },
