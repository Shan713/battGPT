  {
    "@id": "https://w3id.org/emmo#EMMO_50afa1a9_2c4e_40fd_aa93_0e33511f1f27",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A causal interaction is a fundamental causal system that can be represented as a complete bipartite directed graph K(m,n), when m,n>1.\nThis concept covers fundamental particles interactions with 2 or more particles as input and as output."
      },
      {
        "@language": "en",
        "@value": "The class of fundamental systems where two or more input particles interacts, providing an output of other two or more particles."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/reference/standardmodel#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Interaction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_43a4e80d_6ae9_45ed_8cfb_fd0a5339bf87"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Electron-electron scattering. Electron-positron annihilation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Interaction"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "A causal interaction is a fundamental causal system that can be represented as a complete bipartite directed graph K(m,n), when m,n>1.\nThis concept covers fundamental particles interactions with 2 or more particles as input and as output."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The class of fundamental systems where two or more input particles interacts, providing an output of other two or more particles."
      }
    ]
  },
