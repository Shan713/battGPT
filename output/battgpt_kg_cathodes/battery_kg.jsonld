  {
    "@id": "https://w3id.org/emmo#SiderealDay",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The length of time which passes between a given fixed star in the sky crossing a given projected meridian (line of longitude). The sidereal day is 23 h 56 m 4.1 s, slightly shorter than the solar day because the Earth 's orbital motion about the Sun  means the Earth  has to rotate slightly more than one turn with respect to the \"fixed\" stars in order to reach the same Earth-Sun orientation. Another way of thinking about the difference is that it amounts to 1/365.2425^{th} of a day per day, since even if the Earth  did not spin on its axis at all, the Sun  would appear to make one rotation around the Earth  as the Earth  completed a single orbit (which takes one year).\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/units/unclassifiedunits#"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "SiderealDay"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://scienceworld.wolfram.com/astronomy/SiderealDay.html"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_15344998_4490_4b40_b242_c3d92e5cdc27"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b3176"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b3177"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_02e894c3_b793_4197_b120_3442e08f58d1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Sidereal Day"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
