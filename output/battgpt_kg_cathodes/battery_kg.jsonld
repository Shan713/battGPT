  {
    "@id": "https://w3id.org/emmo#EMMO_ad0e72fc_dcaa_490d_8371_b4d814dcda2c",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The superclass of all causal EMMO relations."
      },
      {
        "@language": "en",
        "@value": "Causality is the fundamental concept describing how entities affect each other, and conceptually precedes time and space relations. In the EMMO causality is the foundation for space and time relations.\nEmbracing a strong reductionistic view, causality originates at quantum entities level, meaning that causal relations between macroscopic entities is simply the sum of quantum level causality relations."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/foundation/mereocausality#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "causal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_ec2472ae_cf4a_46a5_8555_1556f5a6c3c5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "causal"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "Causality is the fundamental concept describing how entities affect each other, and conceptually precedes time and space relations. In the EMMO causality is the foundation for space and time relations.\nEmbracing a strong reductionistic view, causality originates at quantum entities level, meaning that causal relations between macroscopic entities is simply the sum of quantum level causality relations."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The superclass of all causal EMMO relations."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Each pair of entities is either in isCauseOf or isNotCauseOf relation. The two are mutually exclusive."
      },
      {
        "@language": "en",
        "@value": "Causality in the EMMO is intended as physical causation and not counter-factual. Meaning that causality is an expression of actual physical interactions, and not of a counterfactual depence such as “I didn't water the flowers, hence, I'm the cause of their death”."
      }
    ]
  },
