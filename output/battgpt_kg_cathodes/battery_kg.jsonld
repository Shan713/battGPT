  {
    "@id": "https://w3id.org/emmo#EMMO_847724b7_acef_490e_9f0d_67da967f2812",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Metrological uncertainty includes components arising from systematic effects, such as components associated with corrections and the assigned quantity values of measurement standards, as well as the definitional uncertainty. Sometimes estimated systematic effects are not corrected for but, instead, associated measurement uncertainty components are incorporated."
      },
      {
        "@language": "en",
        "@value": "The uncertainty of a quantity obtained through a well-defined procedure, characterising of the dispersion of the quantity."
      },
      {
        "@language": "en",
        "@value": "In general, for a given set of information, it is understood that the measurement uncertainty is associated with a stated quantity value. A modification of this value results in a modification of the associated uncertainty."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/metrology#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "MetrologicalUncertainty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b3786"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_dd4a7f3e_ef56_466c_ac1a_d2716b5f87ec"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "A metrological uncertainty can be assigned to any objective property via the 'hasMetrologicalUncertainty' relation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "- Standard deviation\n- Half-width of an interval with a stated coverage probability"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "MetrologicalUncertainty"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "The uncertainty of a quantity obtained through a well-defined procedure, characterising of the dispersion of the quantity."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Metrological uncertainty in EMMO is a slight generalisation of the VIM term 'measurement uncertainty', which is defined as \"a non-negative parameter characterising the dispersion of the quantity being measured\"."
      }
    ]
  },
  {
    "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b3786",
