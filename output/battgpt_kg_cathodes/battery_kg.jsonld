  {
    "@id": "https://w3id.org/emmo#EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference can be a measurement unit, a measurement procedure, a reference material, or a combination of such (VIM3 1.1 NOTE 2)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/isq#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "MetrologicalReference"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_985bec21_989f_4b9e_a4b3_735d88099c3c"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "MetrologicalReference"
      }
    ],
    "https://w3id.org/emmo#EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "EquivalentTo: StandardUnit or MeasurementUnit or ProcedureUnit"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A reference can be a measurement unit, a measurement procedure, a reference material, or a combination of such (VIM3 1.1 NOTE 2)."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "A symbolic is recognized as reference unit also if it is not part of a quantity (e.g. as in the sentence \"the Bq is the reference unit of Becquerel\").\nFor this reason we can't declare the axiom:\nMetrologicalReference SubClassOf: inverse(hasMetrologicalReference) some Quantity\nbecause there exist reference units without being part of a quantity.\nThis is peculiar to EMMO, where quantities as syntatic entities (explicit quantities) are distinct with quantities as semantic entities (properties)."
      }
    ]
  },
