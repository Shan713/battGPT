    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A unit that is a non-SI unit, specifically a CGS unit,  of polarizability known informally as polarizability volume.  The SI defined units for polarizability are C*m²/V and can be converted to Ångström³ by multiplying the SI value by 4 times pi times the vacuum permittivity and then converting the resulting m³ to Ångström³ through the SI base 10 conversion (multiplying by 10⁻³⁰).\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
