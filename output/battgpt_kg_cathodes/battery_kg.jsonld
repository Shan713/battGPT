    ],
    "https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "10.nV"
      }
    ],
    "https://w3id.org/emmo#EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "abV"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A unit of electrical potential equal to one hundred millionth of a volt (10⁻⁸ volts), used in the centimeter-gram-second (CGS) system of units. One abV is the potential difference that exists between two points when the work done to transfer one abcoulomb of charge between them equals: 1 erg· 1 abV = 10 nV.\n\n-- QUDT"
      }
    ],
    "https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://en.wikipedia.org/wiki/Abvolt?oldid=477198646"
      }
    ]
  },
