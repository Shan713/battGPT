        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Conversion of materials and assembly of components for the manufacture of products"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "application of scientific knowledge, tools, techniques, crafts or systems in order to solve a problem or to achieve an objective which can result in a product or process"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Technology is the application of knowledge for achieving practical goals in a reproducible way."
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Technology refers to methods, systems, and devices which are the result of scientific knowledge being used for practical purposes."
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Class that includes the application of scientific knowledge, tools and techniques in order to transform a precursor object (ex. conversion of material) following a practic purpose."
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "application of scientific knowledge, tools, techniques, crafts, systems or methods of organization in order to solve a problem or achieve an objective"
