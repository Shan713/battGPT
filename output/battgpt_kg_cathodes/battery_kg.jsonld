  {
    "@id": "https://w3id.org/emmo#EMMO_8aba9715_d542_4a79_a778_6115d2b4febd",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Collective agency occurs when two or more individuals act as a group, in accordance with certain principles or procedures that constitute and organize the group."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://plato.stanford.edu/entries/agency/#OthKinAgeMenShaColRelArt"
      },
      {
        "@id": "https://w3id.org/emmo/reference/agency#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "CollectiveAgency"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b811"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_8af3b008_0e32_4684_85ab_a52a8e7b6877"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "CollectiveAgency"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "Collective agency occurs when two or more individuals act as a group, in accordance with certain principles or procedures that constitute and organize the group."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "The group acting collectively is intended to be represented as an item, meaning that all members of the group should have had at least one causal interaction with another member. The collective action in fact is taken in accordance with certain principles or procedures that constitute and organize the group itself that requires implicitly a causal interaction between members."
      }
    ]
  },
