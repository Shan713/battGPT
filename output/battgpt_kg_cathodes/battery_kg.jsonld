    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The  `Ampere Turn per Metre` is the SI unit of magnetic field strength. One ampere per meter is equal to π/250 oersteds (12.566 371 millioersteds) in CGS units. The ampere per meter is also the SI unit of \"magnetization\" in the sense of magnetic dipole moment per unit volume; in this context 1 A/m = 0.001 emu per cubic centimeter.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
