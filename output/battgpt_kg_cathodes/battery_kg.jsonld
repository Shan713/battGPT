      {
        "@language": "en",
        "@value": "A relation that identify a proper item part of the whole, whose parts always cover the full spatial extension of the whole within a time interval."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "A temporal part of an item cannot both cause and be caused by any other proper part of the item.\nA temporal part is not constraint to be causally self-connected, i.e. it can be either an item or a collection. We therefore introduce two subproperties in order to distinguish between both cases."
      },
      {
        "@language": "en",
        "@value": "In EMMO FOL this is a defined property. In OWL temporal relations are primitive."
      }
    ]
