  {
    "@id": "https://w3id.org/emmo#EMMO_03441eb3_d1fd_4906_b953_b83312d7589e",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Sintering is the process of forming a solid mass of material through heat and pressure without melting to the point of liquefaction. This process involves the atoms in materials diffusing across the particle boundaries and fusing together into one piece."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/manufacturing#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sintering"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@language": "en",
        "@value": "ISO 3252:2019 Powder metallurgy\nsintering: thermal treatment of a powder or compact, at a temperature below the melting point of the main constituent, for the purpose of increasing its strength by the metallurgical bonding of its particles"
      },
      {
        "@language": "en",
        "@value": "ISO/ASTM TR 52906:2022 Additive manufacturing\nsintering: process of heating a powder metal compact to increase density and/or improve mechanical properties via solid state diffusion"
      },
      {
        "@language": "en",
        "@value": "https://www.twi-global.com/technical-knowledge/faqs/what-is-sintering"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_45fec702_54cb_4508_b47e_bdc581229e22"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Sintern"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Sintering"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "Sintering is the process of forming a solid mass of material through heat and pressure without melting to the point of liquefaction. This process involves the atoms in materials diffusing across the particle boundaries and fusing together into one piece."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Sintering occurs naturally in mineral deposits, and is used as a manufacturing process for materials including ceramics, metals and plastics.\nBecause the sintering temperature doesn’t reach the materials’ melting point, it is often used for materials with high melting points, such as molybdenum and tungsten."
      }
    ]
