  {
    "@id": "https://w3id.org/emmo#Stokes",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "`Stokes (St)` is a unit in the category of Kinematic viscosity. This unit is commonly used in the cgs unit system. Stokes (St) has a dimension of L²T⁻¹ where L is length, and T is time. It can be converted to the corresponding standard SI unit m²/s by multiplying its value by a factor of 0.0001.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
