  {
    "@id": "https://w3id.org/emmo#EMMO_472a0ca2_58bf_4618_b561_6fe68bd9fd49",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The set of established forms or methods of an organized body for accomplishing a certain task or tasks (Wiktionary)."
      },
      {
        "@language": "en",
        "@value": "An intentional process in which an agent works with some entities according to some existing formalised operative rules."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/disciplines/metrology#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Procedure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_6f5af708_f825_4feb_a0d1_a8d813d3022b"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4512"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b4510"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_bafc17b5_9be4_4823_8bbe_ab4e90b6738c"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "en",
        "@value": "Elaboration"
      },
      {
        "@language": "en",
        "@value": "Work"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "The process in which a control unit of a CPU (the agent) orchestrates some cached binary data according to a list of instructions (e.g. a program).\nThe process in which a librarian order books alphabetically on a shelf.\nThe execution of an algorithm."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Procedure"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "The set of established forms or methods of an organized body for accomplishing a certain task or tasks (Wiktionary)."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "An intentional process in which an agent works with some entities according to some existing formalised operative rules."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "A procedure can be considered as an intentional process with a plan."
      }
    ]
  },
