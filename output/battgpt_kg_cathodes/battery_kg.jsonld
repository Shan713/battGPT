  {
    "@id": "https://w3id.org/emmo#Diopter",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A dioptre, or diopter, is a unit of measurement for the optical power of a lens or curved mirror, which is equal to the reciprocal of the focal length measured in metres (that is, 1/metre). For example, a 3 dioptre lens brings parallel rays of light to focus at 1/3 metre. The same unit is also sometimes used for other reciprocals of distance, particularly radii of curvature and the vergence of optical beams. Though the diopter is based on the SI-metric system it has not been included in the standard so that there is no international name or abbreviation for this unit of measurement within the international system of units this unit for optical power would need to be specified explicitly as the inverse metre.\n\n-- QUDT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/2.1/vocab/unit"
      },
      {
        "@id": "https://w3id.org/emmo/disciplines/units/unclassifiedunits#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Diopter"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b568"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_608a1b30_df6f_4bbb_9dc3_5c0de92fd9cf"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_868ae137_4d25_493e_b270_21ea3d94849e"
      },
      {
        "@id": "https://w3id.org/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375"
      },
      {
        "@id": "_:n6a0b4d77db1d4bb4a28be148935c0b69b567"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Diopter"
      }
    ],
    "https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://qudt.org/vocab/unit/DIOPTER"
      }
    ],
    "https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "[diop]"
      }
    ],
    "https://w3id.org/emmo#EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "D"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A dioptre, or diopter, is a unit of measurement for the optical power of a lens or curved mirror, which is equal to the reciprocal of the focal length measured in metres (that is, 1/metre). For example, a 3 dioptre lens brings parallel rays of light to focus at 1/3 metre. The same unit is also sometimes used for other reciprocals of distance, particularly radii of curvature and the vergence of optical beams. Though the diopter is based on the SI-metric system it has not been included in the standard so that there is no international name or abbreviation for this unit of measurement within the international system of units this unit for optical power would need to be specified explicitly as the inverse metre.\n\n-- QUDT"
      }
    ],
    "https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "http://en.wikipedia.org/wiki/Dioptre?oldid=492506920"
      }
    ]
