      }
    ],
    "http://www.w3.org/2002/07/owl#annotatedTarget": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Process consisting of two steps: - first, the steel is heated in a quenching treatment to a temperature above Ac3 and then rapidly cooled in a liquid to produce a process-specific grain structure; - subsequently, the steel is heated to a specific temperature during tempering to set the desired property and cooled in air."
      }
    ]
  },
