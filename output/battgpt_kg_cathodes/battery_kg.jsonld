      }
    ],
    "https://w3id.org/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "http://dbpedia.org/resource/Sievert"
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "SI unit for equivalent doseof ionizing radiation. Sievert is derived from absorbed dose, but takes into account the biological effectiveness of the radiation, which is dependent on the radiation type and energy."
      }
    ],
    "https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f": [
      {
        "@language": "en",
        "@value": "Although the sievert has the same dimensions as the gray (i.e. joules per kilogram), it measures a different quantity. To avoid any risk of confusion between the absorbed dose and the equivalent dose, the corresponding special units, namely the gray instead of the joule per kilogram for absorbed dose and the sievert instead of the joule per kilogram for the dose equivalent, should be used.\n\n-- QUDT"
      }
    ],
    "https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "https://en.wikipedia.org/wiki/Equivalent_dose"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "http://en.wikipedia.org/wiki/Sievert?oldid=495474333"
      }
    ],
