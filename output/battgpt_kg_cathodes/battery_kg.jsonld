    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "`Joule Second per Mole` is a unit for 'Molar Angular Momentum' expressed as J s mol⁻¹.\n\n-- QUDT"
      }
    ],
