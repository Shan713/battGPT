  {
    "@id": "https://w3id.org/emmo#EMMO_5e00b1db_48fc_445b_82e8_ab0e2255bf52",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A chausal path whose quantum parts belongs to at least two different standard model fundamental types."
      },
      {
        "@language": "en",
        "@value": "An multi-particle path is a causal path of quantum entities of different type, following the causal connection between an initial quantum up to the final one, regardless on the fact that causality is passing through elementary particles of different types.\nFor example, a path starting from an elementary  photon, then through the electron with which it scatter, and then trough a positron with which the electron collides."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/emmo/reference/standardmodel#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "MultiParticlePath"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/emmo#EMMO_7b79b2ac_3cf2_4d3b_8cdc_bcabb59d869e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "MultiParticlePath"
      }
    ],
    "https://w3id.org/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13": [
      {
        "@language": "en",
        "@value": "An multi-particle path is a causal path of quantum entities of different type, following the causal connection between an initial quantum up to the final one, regardless on the fact that causality is passing through elementary particles of different types.\nFor example, a path starting from an elementary  photon, then through the electron with which it scatter, and then trough a positron with which the electron collides."
      }
    ],
    "https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9": [
      {
        "@language": "en",
        "@value": "A chausal path whose quantum parts belongs to at least two different standard model fundamental types."
      }
    ]
  },
