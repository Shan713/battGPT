      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "(according to DIN 8200) Shot peening to generate residual compressive stresses in layers of the blasting material close to the surface in order to improve certain component properties, e.g. fatigue strength, corrosion resistance, wear resistance (from: DIN 8200:1982)"
      }
    ]
