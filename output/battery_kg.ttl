@prefix battery: <https://w3id.org/emmo/domain/battery#> .
@prefix battgpt: <https://w3id.org/battgpt/kg#> .
@prefix chsub: <https://w3id.org/emmo/domain/chemical-substance#> .
@prefix cryst: <https://w3id.org/emmo/domain/crystallography#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix emmo: <https://w3id.org/emmo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/battgpt/kg> a owl:Ontology ;
    rdfs:label "BattGPT Battery Materials Knowledge Graph"@en ;
    owl:imports dcterms:,
        qudt:,
        prov:,
        emmo:,
        battery:,
        chsub:,
        cryst: ;
    owl:versionInfo "0.1.0"^^xsd:string .

battgpt:belongsToElectrode a owl:ObjectProperty ;
    rdfs:label "belongs to electrode"@en ;
    rdfs:comment "Inverse relation linking an active battery material to its containing electrode."@en ;
    rdfs:domain emmo:EMMO_4207e895_8bfe_4b08_8e2d_dd53af54e10b ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range battery:battery_179f82fb_3b5e_41a6_8586_bf2f9f170cf8 ;
    owl:inverseOf battgpt:usesMaterial .

battgpt:containsSite a owl:ObjectProperty ;
    rdfs:label "contains site"@en ;
    rdfs:comment "Relates a unit cell to an atomic coordinate site located within its bounds."@en ;
    rdfs:domain cryst:UnitCell ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range cryst:AtomicSite .

battgpt:containsSpecies a owl:ObjectProperty ;
    rdfs:label "contains species"@en ;
    rdfs:comment "Relates an atomic site to the chemical atomic species occupying that site."@en ;
    rdfs:domain cryst:AtomicSite ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range chsub:AtomicSpecies .

battgpt:hasAlpha a owl:DatatypeProperty ;
    rdfs:label "has lattice angle alpha"@en ;
    rdfs:comment "Unit cell inter-axial angle alpha in degrees."@en ;
    rdfs:domain cryst:UnitCell ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasBandGap a owl:ObjectProperty ;
    rdfs:label "has band gap"@en ;
    rdfs:comment "Links a material or crystal to its electronic band gap property."@en ;
    rdfs:domain cryst:Crystal ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
    rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 .

battgpt:hasBeta a owl:DatatypeProperty ;
    rdfs:label "has lattice angle beta"@en ;
    rdfs:comment "Unit cell inter-axial angle beta in degrees."@en ;
    rdfs:domain cryst:UnitCell ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasBondDistance a owl:DatatypeProperty ;
    rdfs:label "has bond distance"@en ;
    rdfs:comment "Inter-atomic bond distance in Angstroms between a site and its bonded neighbour."@en ;
    rdfs:domain cryst:AtomicSite ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasBondTo a owl:ObjectProperty ;
    rdfs:label "has bond to"@en ;
    rdfs:comment "Directed crystal-connectivity edge from one atomic site to a bonded neighbour site."@en ;
    rdfs:domain cryst:AtomicSite ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range cryst:AtomicSite .

battgpt:hasCif a owl:DatatypeProperty ;
    rdfs:label "has CIF"@en ;
    rdfs:comment "Crystallographic Information File (CIF) string describing the crystal structure."@en ;
    rdfs:domain cryst:Crystal ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:string .

battgpt:hasCoordinationGeometry a owl:ObjectProperty ;
    rdfs:label "has coordination geometry"@en ;
    rdfs:comment "Links an atomic site to its polyhedral coordination environment property."@en ;
    rdfs:domain cryst:AtomicSite ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
    rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 .

battgpt:hasCrystalSystem a owl:ObjectProperty ;
    rdfs:label "has crystal system"@en ;
    rdfs:comment "Relates a crystal structure to its crystal system family (Cubic, Hexagonal, Monoclinic, etc.)."@en ;
    rdfs:domain cryst:Crystal ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range cryst:CrystalSystem .

battgpt:hasElectronegativity a owl:DatatypeProperty ;
    rdfs:label "has electronegativity"@en ;
    rdfs:comment "Pauling scale electronegativity value."@en ;
    rdfs:domain chsub:Element ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasElement a owl:ObjectProperty ;
    rdfs:label "has element"@en ;
    rdfs:comment "Relates an atomic species to its fundamental periodic table element."@en ;
    rdfs:domain chsub:AtomicSpecies ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range chsub:Element .

battgpt:hasEnergyAboveHull a owl:ObjectProperty ;
    rdfs:label "has energy above hull"@en ;
    rdfs:comment "Links a material or crystal to its energy above the thermodynamic convex hull."@en ;
    rdfs:domain cryst:Crystal ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
    rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 .

battgpt:hasFormationEnergy a owl:ObjectProperty ;
    rdfs:label "has formation energy"@en ;
    rdfs:comment "Links a material or crystal to its DFT formation energy property per atom."@en ;
    rdfs:domain cryst:Crystal ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
    rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 .

battgpt:hasFormula a owl:DatatypeProperty ;
    rdfs:label "has formula"@en ;
    rdfs:comment "Reduced or IUPAC chemical formula string."@en ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:string .

battgpt:hasFractionalX a owl:DatatypeProperty ;
    rdfs:label "has fractional coordinate x"@en ;
    rdfs:comment "Fractional coordinate x of an atomic site within unit cell."@en ;
    rdfs:domain cryst:AtomicSite ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasFractionalY a owl:DatatypeProperty ;
    rdfs:label "has fractional coordinate y"@en ;
    rdfs:comment "Fractional coordinate y of an atomic site within unit cell."@en ;
    rdfs:domain cryst:AtomicSite ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasFractionalZ a owl:DatatypeProperty ;
    rdfs:label "has fractional coordinate z"@en ;
    rdfs:comment "Fractional coordinate z of an atomic site within unit cell."@en ;
    rdfs:domain cryst:AtomicSite ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasGamma a owl:DatatypeProperty ;
    rdfs:label "has lattice angle gamma"@en ;
    rdfs:comment "Unit cell inter-axial angle gamma in degrees."@en ;
    rdfs:domain cryst:UnitCell ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasLatticea a owl:DatatypeProperty ;
    rdfs:label "has lattice parameter a"@en ;
    rdfs:comment "Unit cell lattice vector length a in Angstroms."@en ;
    rdfs:domain cryst:UnitCell ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasLatticeb a owl:DatatypeProperty ;
    rdfs:label "has lattice parameter b"@en ;
    rdfs:comment "Unit cell lattice vector length b in Angstroms."@en ;
    rdfs:domain cryst:UnitCell ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasLatticec a owl:DatatypeProperty ;
    rdfs:label "has lattice parameter c"@en ;
    rdfs:comment "Unit cell lattice vector length c in Angstroms."@en ;
    rdfs:domain cryst:UnitCell ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:double .

battgpt:hasMaterialProjectId a owl:DatatypeProperty ;
    rdfs:label "has Materials Project ID"@en ;
    rdfs:comment "Unique identifier string from Materials Project (e.g. mp-19017)."@en ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:string .

battgpt:hasOxidationState a owl:DatatypeProperty ;
    rdfs:label "has oxidation state"@en ;
    rdfs:comment "Formal chemical oxidation state number."@en ;
    rdfs:domain chsub:AtomicSpecies ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:integer .

battgpt:hasSmactValidity a owl:DatatypeProperty ;
    rdfs:label "has SMACT validity"@en ;
    rdfs:comment "Boolean flag indicating whether chemical stoichiometry passes SMACT charge neutrality rules."@en ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:boolean .

battgpt:hasSpaceGroup a owl:ObjectProperty ;
    rdfs:label "has space group"@en ;
    rdfs:comment "Relates a crystal structure to its space group symmetry classification."@en ;
    rdfs:domain cryst:Crystal ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range cryst:SpaceGroup .

battgpt:hasSpaceGroupNumber a owl:DatatypeProperty ;
    rdfs:label "has space group number"@en ;
    rdfs:comment "International space group number (1..230)."@en ;
    rdfs:domain cryst:SpaceGroup ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:integer .

battgpt:hasStructure a owl:ObjectProperty ;
    rdfs:label "has structure"@en ;
    rdfs:comment "Relates a bulk battery material or compound to its crystallographic structure representation."@en ;
    rdfs:domain emmo:EMMO_4207e895_8bfe_4b08_8e2d_dd53af54e10b ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range cryst:Crystal .

battgpt:hasSymmetrySymbol a owl:DatatypeProperty ;
    rdfs:label "has symmetry symbol"@en ;
    rdfs:comment "Hermann-Mauguin space group symmetry symbol (e.g. R-3m, Fd-3m)."@en ;
    rdfs:domain cryst:SpaceGroup ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:string .

battgpt:hasUnitCell a owl:ObjectProperty ;
    rdfs:label "has unit cell"@en ;
    rdfs:comment "Relates a crystal structure to its repeating unit cell geometric model."@en ;
    rdfs:domain cryst:Crystal ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range cryst:UnitCell .

battgpt:isStable a owl:DatatypeProperty ;
    rdfs:label "is stable"@en ;
    rdfs:comment "Boolean flag indicating whether material is thermodynamically stable on convex hull."@en ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range xsd:boolean .

emmo:EMMO_faf79f53_749d_40b2_807c_d34244c192f4 a owl:DatatypeProperty ;
    rdfs:label "has number value"@en ;
    rdfs:comment "EMMO Core datatype property attaching a scalar numerical value to a property."@en .

battgpt:usesMaterial a owl:ObjectProperty ;
    rdfs:label "uses material"@en ;
    rdfs:comment "Relates a battery cell component (Electrode, Electrolyte) to its active constituent material."@en ;
    rdfs:domain battery:battery_179f82fb_3b5e_41a6_8586_bf2f9f170cf8 ;
    rdfs:isDefinedBy battgpt: ;
    rdfs:range emmo:EMMO_4207e895_8bfe_4b08_8e2d_dd53af54e10b .

