        </mxCell>
        <mxCell id="lg49" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br/&gt;&amp;#9723; grey = imported (EMMO / EMMO-domain)&amp;#160;&amp;#160;&amp;#9723; white = BattGPT core&amp;#160;&amp;#160;&amp;#9723; cyan = BattGPT classification vocabulary&lt;br/&gt;&amp;#9670;&amp;#8212; composition (subPropertyOf emmo:hasPart) &amp;#183; part is per-material and owned by one whole&lt;br/&gt;&amp;#9671;&amp;#8212; aggregation (subPropertyOf emmo:hasConstituent) &amp;#183; constituent is shared across materials&lt;br/&gt;&amp;#9651; generalization (rdfs:subClassOf)&amp;#160;&amp;#160;&amp;#8594; association&amp;#160;&amp;#160;- - &amp;#8594; derived (owl:propertyChainAxiom) / &amp;#171;instanceOf&amp;#187;&lt;br/&gt;{1..*} = owl:someValuesFrom restriction asserted on the owning class" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=#FBFBFB;strokeColor=#999999;dashed=1;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
          <mxGeometry x="1080" y="560" width="480" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
