        <mxCell id="t48" value="&lt;i&gt;Quantitative properties (band gap, formation&lt;br/&gt;energy, moduli, cell-level electrochemistry):&lt;br/&gt;see Fig. 2&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" parent="1" vertex="1">
