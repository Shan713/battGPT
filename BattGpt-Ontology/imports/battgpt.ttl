@prefix : <https://w3id.org/battgpt/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix emmo: <https://w3id.org/emmo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix chsub: <https://w3id.org/emmo/domain/chemical-substance#> .
@prefix battery: <https://w3id.org/emmo/domain/battery#> .
@prefix battgpt: <https://w3id.org/battgpt/kg#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix battinfo: <https://w3id.org/battinfo#> .
@base <https://w3id.org/battgpt/kg#> .

<https://w3id.org/battgpt/kg#> rdf:type owl:Ontology ;
                                owl:versionIRI <https://w3id.org/battgpt/kg/0.2.2/battgpt> ;
                                owl:imports <https://w3id.org/battinfo> ,
                                            <https://w3id.org/emmo> ,
                                            <https://w3id.org/emmo/domain/battery> ,
                                            <https://w3id.org/emmo/domain/chemical-substance> ;
                                dcterms:created "2026-08-05T00:00:00Z"^^xsd:dateTime ;
                                dcterms:creator "BattGPT Team"@en ;
                                dcterms:description "Custom predicates, standards-compliant domain classes, and named role individuals for battery materials, crystallography, DFT properties, crystal connectivity, reified bond entities, and battery components."@en ;
                                dcterms:isVersionOf <https://w3id.org/battgpt/kg#> ;
                                dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                dcterms:title "BattGPT Battery Materials Knowledge Graph Predicate & Extension Ontology"@en ;
                                vann:preferredNamespacePrefix "battgpt" ;
                                vann:preferredNamespaceUri "https://w3id.org/battgpt/kg#" ;
                                rdfs:comment "Contains ObjectProperty, DatatypeProperty, SubClass, and NamedIndividual definitions extending EMMO and BattINFO."@en ;
                                owl:priorVersion <https://w3id.org/battgpt/kg/0.2.1/battgpt> ;
                                owl:versionInfo "0.2.2" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/isVersionOf
dcterms:isVersionOf rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/battgpt/kg#belongsToElectrode
battgpt:belongsToElectrode rdf:type owl:ObjectProperty ;
                           owl:inverseOf battgpt:usesMaterial ;
                           rdfs:domain emmo:EMMO_df96cbb6_b5ee_4222_8eab_b3675df24bea ;
                           rdfs:range battgpt:BatteryRole ;
                           rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                           rdfs:label "belongsToElectrode"@en ;
                           skos:prefLabel "belongsToElectrode"@en .


###  https://w3id.org/battgpt/kg#hasSite
battgpt:hasSite rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f ;
                     rdfs:domain battgpt:UnitCell ;
                     rdfs:range battgpt:Site ;
                     rdfs:comment "Relates a unit cell to an atomic coordinate site located within its bounds."@en ;
                     rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                     rdfs:label "hasSite"@en ;
                     skos:prefLabel "hasSite"@en .


###  https://w3id.org/battgpt/kg#hasSpecies
battgpt:hasSpecies rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf emmo:EMMO_dba27ca1_33c9_4443_a912_1519ce4c39ec ;
                        rdfs:domain battgpt:Site ;
                        rdfs:range battgpt:Species ;
                        rdfs:comment "Relates an atomic site to the chemical atomic species occupying that site."@en ;
                        rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                        rdfs:label "hasSpecies"@en ;
                        skos:prefLabel "hasSpecies"@en .


###  https://w3id.org/battgpt/kg#hasBandGap
battgpt:hasBandGap rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                   rdfs:domain emmo:EMMO_df96cbb6_b5ee_4222_8eab_b3675df24bea ;
                   rdfs:range battgpt:BandGapProperty ;
                   rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                   rdfs:label "hasBandGap"@en ;
                   skos:prefLabel "hasBandGap"@en .


###  https://w3id.org/battgpt/kg#hasBond
battgpt:hasBond rdf:type owl:ObjectProperty ;
                rdfs:domain battgpt:Site ;
                rdfs:range battgpt:CrystalBond ;
                rdfs:comment "Relates an atomic site to a reified crystal bond entity."@en ;
                rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                rdfs:label "hasBond"@en ;
                skos:prefLabel "hasBond"@en .


###  https://w3id.org/battgpt/kg#hasBondTo
battgpt:hasBondTo rdf:type owl:ObjectProperty ;
                  rdfs:domain battgpt:Site ;
                  rdfs:range battgpt:Site ;
                  rdfs:comment "Directed crystal-connectivity edge from one atomic site to a bonded neighbour site."@en ;
                  rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                  rdfs:label "hasBondTo"@en ;
                  skos:prefLabel "hasBondTo"@en .


###  https://w3id.org/battgpt/kg#hasBulkModulus
battgpt:hasBulkModulus rdf:type owl:ObjectProperty ;
