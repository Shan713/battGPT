                         rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                         rdfs:domain battgpt:CrystalStructure ;
                         rdfs:range battgpt:CrystalSystem ;
                         owl:propertyChainAxiom ( battgpt:hasSpaceGroup
                                                  battgpt:belongsToCrystalSystem
                                                ) ;
                         rdfs:comment "Relates a crystal structure to its crystal system family. Formally derived via the property chain hasSpaceGroup o belongsToCrystalSystem, mirroring how hasBondTo is derived from hasBond o hasTargetSite: a crystal structure's crystal system is entailed from its space group rather than being an independently asserted fact that could drift out of agreement with it (space group and crystal system were previously unrelated in this ontology, so nothing prevented a structure's hasCrystalSystem and hasSpaceGroup values from being crystallographically inconsistent with each other)."@en ;
                         rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                         rdfs:label "hasCrystalSystem"@en ;
                         skos:prefLabel "hasCrystalSystem"@en .


