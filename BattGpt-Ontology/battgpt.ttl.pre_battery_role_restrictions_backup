###  https://w3id.org/battgpt/kg#Site
battgpt:Site rdf:type owl:Class ;
             rdfs:subClassOf owl:Thing ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty battgpt:hasSpecies ;
                               owl:someValuesFrom battgpt:Species
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty battgpt:hasBond ;
                               owl:someValuesFrom battgpt:CrystalBond
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty battgpt:hasBondTo ;
                               owl:someValuesFrom battgpt:Site
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty battgpt:hasCoordinationGeometry ;
                               owl:someValuesFrom battgpt:CoordinationGeometry
                             ] ;
             rdfs:comment "Occupied atomic site within a unit cell: the crystallographic position together with the atomic species residing at it, not a bare geometric coordinate. This reading is what the formal axioms assert (v0.3.2 wording clarification): hasSpecies is a subproperty of emmo:hasConstituent, whose domain is emmo:Object, so every Site is entailed to be an emmo:Object with its species as a constituent — coherent for an occupied site, but not for an empty coordinate triple. Vacancies are therefore not modelled as Site individuals. Requires (v0.3.0) at least one hasSpecies value, mirroring the pattern already used by CrystalBond and Species. Also requires at least one hasBond, one hasBondTo, and one hasCoordinationGeometry value: every occupied site in a real crystal has neighbouring atoms and therefore a classifiable local coordination environment, so a Site individual populated without any resolved bonding/geometry data does not yet satisfy this class's definition. hasBondTo is itself derived via the property chain hasBond o hasTargetSite (see its own definition), so it is non-simple; someValuesFrom is used here rather than a cardinality restriction because OWL 2 DL forbids cardinality restrictions on non-simple (chain-derived) properties, while someValuesFrom remains legal on them."@en ;
             rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
             rdfs:label "Site"@en ;
             skos:prefLabel "Site"@en .


