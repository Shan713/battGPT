###  https://w3id.org/battgpt/kg#hasStructure
battgpt:hasStructure rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f ;
                     rdfs:domain emmo:EMMO_df96cbb6_b5ee_4222_8eab_b3675df24bea ;
                     rdfs:range battgpt:CrystalStructure ;
                     rdfs:comment "Relates a bulk battery material or compound to its crystallographic structure representation."@en ;
                     rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                     rdfs:label "hasStructure"@en ;
                     skos:prefLabel "hasStructure"@en .


###  https://w3id.org/battgpt/kg#hasStructureFamily
battgpt:hasStructureFamily rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                           rdfs:domain battgpt:CrystalStructure ;
                           rdfs:range battgpt:StructureFamily ;
                           rdfs:comment "Relates a crystal structure to its structural-prototype family (e.g. layered oxide, olivine, spinel, garnet, sulfide superionic conductor). New in v0.3.0 — no equivalent classification exists in the EMMO/BattINFO ontologies imported by this ontology as of this version; see battgpt:StructureFamily."@en ;
                           rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                           rdfs:label "hasStructureFamily"@en ;
                           skos:prefLabel "hasStructureFamily"@en .


