                    rdfs:domain battgpt:CrystalStructure ;
                    rdfs:range battgpt:UnitCell ;
                    rdfs:comment "Relates a crystal structure to its repeating unit cell geometric model."@en ;
                    rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                    rdfs:label "hasUnitCell"@en ;
                    skos:prefLabel "hasUnitCell"@en .


