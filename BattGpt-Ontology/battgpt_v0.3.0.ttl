###  https://w3id.org/battgpt/kg#hasCapacity
battgpt:hasCapacity rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                    rdfs:domain battery:battery_68ed592a_7924_45d0_a108_94d6275d57f0 ;
                    rdfs:range electro:electrochemistry_791c1915_a791_4450_acd8_7f94764743b5 ;
                    rdfs:comment "Relates a battery cell to its (rated or measured) capacity. New in v0.3.0, reusing EMMO domain-electrochemistry's Capacity class as range rather than redefining it locally."@en ;
                    rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                    rdfs:label "hasCapacity"@en ;
                    skos:prefLabel "hasCapacity"@en .


