                             rdfs:comment "Represents the shear elastic modulus of a material. Re-anchored (v0.3.0) under emmo:Pressure for the same reason as BulkModulusProperty."@en ;
                             rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                             rdfs:label "ShearModulusProperty"@en ;
                             skos:prefLabel "ShearModulusProperty"@en .


###  https://w3id.org/battgpt/kg#BatteryRole
battgpt:BatteryRole rdf:type owl:Class ;
                    rdfs:subClassOf emmo:EMMO_4f226cf3_6d02_4d35_8566_a9e641bc6ff3 ;
                    rdfs:comment "Functional role played by a material within an electrochemical battery system."@en ;
                    rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                    rdfs:label "BatteryRole"@en ;
                    skos:definition "Functional role played by a material within an electrochemical battery system."@en ;
                    skos:prefLabel "BatteryRole"@en .


###  https://w3id.org/battgpt/kg#CoordinationGeometry
battgpt:CoordinationGeometry rdf:type owl:Class ;
                             rdfs:subClassOf emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
                             rdfs:comment "Local coordination-geometry classification of an atomic site (e.g. octahedral, tetrahedral, square-planar). New in v0.3.0, so coordination-geometry individuals are no longer typed directly under the same generic emmo:Property ancestor shared by CrystalSystem and SpaceGroup."@en ;
                             rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                             rdfs:label "CoordinationGeometry"@en ;
                             skos:prefLabel "CoordinationGeometry"@en .


###  https://w3id.org/battgpt/kg#CrystalStructure
battgpt:CrystalStructure rdf:type owl:Class ;
                         rdfs:subClassOf owl:Thing ;
                         rdfs:comment "Crystallographic structural representation describing the periodic arrangement, unit cell, symmetry, and atomic sites of a material. Explicitly anchored under owl:Thing (v0.3.0) for consistency with its sibling local classes (Site, UnitCell, Species, CrystalBond); no single class in EMMO core, EMMO domain-battery, EMMO domain-electrochemistry, or EMMO domain-chemical-substance cleanly captures 'the crystallographic structure of a substance', and EMMO's own domain-crystallography ontology remains an explicitly work-in-progress v0.1.0 draft not imported here, so this is left as a standalone local root rather than force-fit under an unstable upstream branch."@en ;
                         rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                         rdfs:label "CrystalStructure"@en ;
                         skos:prefLabel "CrystalStructure"@en .


###  https://w3id.org/battgpt/kg#CrystalBond
battgpt:CrystalBond rdf:type owl:Class ;
                    rdfs:subClassOf owl:Thing ,
                                    [ a owl:Restriction ;
                                      owl:onProperty battgpt:hasSourceSite ;
                                      owl:someValuesFrom battgpt:Site
                                    ] ,
                                    [ a owl:Restriction ;
                                      owl:onProperty battgpt:hasTargetSite ;
                                      owl:someValuesFrom battgpt:Site
                                    ] ;
                    rdfs:comment "Explicit reified bond entity connecting source site, target site, inter-atomic distance, and coordination method."@en ;
                    rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                    rdfs:label "CrystalBond"@en ;
                    skos:definition "Explicit reified bond entity connecting source site, target site, inter-atomic distance, and coordination method."@en ;
                    skos:prefLabel "CrystalBond"@en .


###  https://w3id.org/battgpt/kg#CrystalSystem
battgpt:CrystalSystem rdf:type owl:Class ;
                      rdfs:subClassOf emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
                      rdfs:comment "Crystallographic crystal system family classification property."@en ;
                      rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                      rdfs:label "CrystalSystem"@en ;
                      skos:prefLabel "CrystalSystem"@en .


###  https://w3id.org/battgpt/kg#ElectrolyteRole
battgpt:ElectrolyteRole rdf:type owl:Class ;
                        rdfs:subClassOf battgpt:BatteryRole ;
                        rdfs:comment "Liquid, polymer, or solid-state ion-conducting electrolyte functional role."@en ;
                        rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                        skos:closeMatch electro:electrochemistry_fb0d9eef_92af_4628_8814_e065ca255d59 ;
                        rdfs:label "ElectrolyteRole"@en ;
                        skos:definition "Liquid, polymer, or solid-state ion-conducting electrolyte functional role."@en ;
                        skos:prefLabel "ElectrolyteRole"@en .


###  https://w3id.org/battgpt/kg#NegativeElectrodeRole
battgpt:NegativeElectrodeRole rdf:type owl:Class ;
                              rdfs:subClassOf battgpt:BatteryRole ;
                              rdfs:comment "Anode / negative electrode functional component role. skos:closeMatch targets EMMO domain-electrochemistry's NegativeElectrode class specifically, not its sibling Anode class: NegativeElectrode is polarity-based and stable across charge/discharge, whereas Anode is defined by current direction and, strictly, swaps with Cathode when a secondary cell is charged versus discharged. BatteryRole's role individuals are meant to be stable per-material assignments, so the polarity-based classes are the correct alignment target."@en ;
                              rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                              skos:closeMatch electro:electrochemistry_c94c041b_8ea6_43e7_85cc_d2bce7785b4c ;
                              rdfs:label "NegativeElectrodeRole"@en ;
                              skos:definition "Anode / negative electrode functional component role."@en ;
                               skos:prefLabel "NegativeElectrodeRole"@en .


###  https://w3id.org/battgpt/kg#PositiveElectrodeRole
battgpt:PositiveElectrodeRole rdf:type owl:Class ;
                              rdfs:subClassOf battgpt:BatteryRole ;
                              rdfs:comment "Cathode / positive electrode functional component role. skos:closeMatch targets EMMO domain-electrochemistry's PositiveElectrode class specifically, not its sibling Cathode class, for the same polarity-vs-current-direction reason documented on NegativeElectrodeRole."@en ;
                              rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                              skos:closeMatch electro:electrochemistry_aff732a9_238a_4734_977c_b2ba202af126 ;
                              rdfs:label "PositiveElectrodeRole"@en ;
                              skos:definition "Cathode / positive electrode functional component role."@en ;
                               skos:prefLabel "PositiveElectrodeRole"@en .


###  https://w3id.org/battgpt/kg#SeparatorRole
battgpt:SeparatorRole rdf:type owl:Class ;
                      rdfs:subClassOf battgpt:BatteryRole ;
                      rdfs:comment "Porous separator or solid electrolyte interface barrier role."@en ;
                      rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                      skos:closeMatch electro:electrochemistry_331e6cca_f260_4bf8_af55_35304fe1bbe0 ;
                      rdfs:label "SeparatorRole"@en ;
                      skos:definition "Porous separator or solid electrolyte interface barrier role."@en ;
                      skos:prefLabel "SeparatorRole"@en .


###  https://w3id.org/battgpt/kg#Site
battgpt:Site rdf:type owl:Class ;
             rdfs:subClassOf owl:Thing ,
                             [ a owl:Restriction ;
                               owl:onProperty battgpt:hasSpecies ;
                               owl:someValuesFrom battgpt:Species
                             ] ;
             rdfs:comment "Atomic coordinate site located within a unit cell. Requires (v0.3.0) at least one hasSpecies value, mirroring the pattern already used by CrystalBond and Species."@en ;
             rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
             rdfs:label "Site"@en ;
             skos:prefLabel "Site"@en .


###  https://w3id.org/battgpt/kg#SpaceGroup
battgpt:SpaceGroup rdf:type owl:Class ;
                   rdfs:subClassOf emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
                   rdfs:comment "Crystallographic space group symmetry classification property."@en ;
                   rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                   rdfs:label "SpaceGroup"@en ;
                   skos:prefLabel "SpaceGroup"@en .


###  https://w3id.org/battgpt/kg#Species
