battgpt:hasIonicConductivity rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                             rdfs:domain battery:battery_68ed592a_7924_45d0_a108_94d6275d57f0 ;
                             rdfs:range electro:electrochemistry_25dabdc2_68bf_4a38_8cbe_11be017358bc ;
                             rdfs:comment "Relates a battery cell (or, by extension, an electrolyte material within it) to its ionic conductivity. New in v0.3.0, reusing EMMO domain-electrochemistry's IonicConductivity class."@en ;
                             rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                             rdfs:label "hasIonicConductivity"@en ;
                             skos:prefLabel "hasIonicConductivity"@en .


