                         rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                         rdfs:domain battery:battery_68ed592a_7924_45d0_a108_94d6275d57f0 ;
                         rdfs:range electro:electrochemistry_8b2aaa50_bbe1_45da_8778_8898326246a2 ;
                         rdfs:comment "Relates a battery cell to its state of charge. New in v0.3.0. Uses EMMO domain-electrochemistry's StateOfCharge class rather than EMMO domain-battery's class of the same name, because the domain-battery one is owl:deprecated."@en ;
                         rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                         rdfs:label "hasStateOfCharge"@en ;
                         skos:prefLabel "hasStateOfCharge"@en .


###  https://w3id.org/battgpt/kg#hasVoltage
battgpt:hasVoltage rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                   rdfs:domain battery:battery_68ed592a_7924_45d0_a108_94d6275d57f0 ;
                   rdfs:range emmo:EMMO_17b031fb_4695_49b6_bb69_189ec63df3ee ;
                   rdfs:comment "Relates a battery cell to a measured voltage, reusing EMMO core's generic Voltage class. New in v0.3.0. Prefer hasOpenCircuitVoltage when the value is specifically the open-circuit voltage."@en ;
                   rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                   rdfs:label "hasVoltage"@en ;
                   skos:prefLabel "hasVoltage"@en .


#################################################################
#    Data properties
#
#    NOTE on the two attachment patterns used below and above:
#    computed/DFT material properties (band gap, formation
#    energy, moduli, ...) are reified as their own Property
#    subclasses reached via emmo:hasProperty subproperties, so
#    each value can carry unit/provenance/uncertainty metadata
#    later without a breaking change. Static periodic-table
#    constants (atomic mass, electronegativity, covalent radius,
#    group, period, valence electrons) are instead flat
#    xsd:double/xsd:integer datatype properties directly on
#    emmo:ChemicalElement below, since they are fixed lookup
#    constants rather than per-material computed results and do
#    not need that reification. This is a deliberate two-tier
#    design, not an inconsistency.
#################################################################

###  https://w3id.org/battgpt/kg#hasAlpha
battgpt:hasAlpha rdf:type owl:DatatypeProperty ;
                 rdfs:domain battgpt:UnitCell ;
                 rdfs:range xsd:double ;
                 rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                 rdfs:label "hasAlpha"@en ;
                 skos:prefLabel "hasAlpha"@en .


