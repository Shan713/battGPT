                            rdfs:range electro:electrochemistry_1e3dc60d_dd6b_47d6_8161_70004fc5ee30 ;
                            rdfs:comment "Relates a battery cell to its specific capacity (capacity per unit mass). New in v0.3.0, reusing EMMO domain-electrochemistry's SpecificCapacity class."@en ;
                            rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                            rdfs:label "hasSpecificCapacity"@en ;
                            skos:prefLabel "hasSpecificCapacity"@en .


