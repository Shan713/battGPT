@prefix : <https://w3id.org/battgpt/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix emmo: <https://w3id.org/emmo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix chsub: <https://w3id.org/emmo/domain/chemical-substance#> .
@prefix battery: <https://w3id.org/emmo/domain/battery#> .
@prefix electro: <https://w3id.org/emmo/domain/electrochemistry#> .
@prefix battgpt: <https://w3id.org/battgpt/kg#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix battinfo: <https://w3id.org/battinfo#> .
@base <https://w3id.org/battgpt/kg#> .

<https://w3id.org/battgpt/kg#> rdf:type owl:Ontology ;
                                owl:versionIRI <https://w3id.org/battgpt/kg/0.3.0/battgpt> ;
                                owl:imports <https://w3id.org/battinfo> ,
                                            <https://w3id.org/emmo> ,
                                            <https://w3id.org/emmo/domain/battery> ,
                                            <https://w3id.org/emmo/domain/chemical-substance> ,
                                            <https://w3id.org/emmo/domain/electrochemistry> ;
                                dcterms:created "2026-08-05T00:00:00Z"^^xsd:dateTime ;
                                dcterms:creator "BattGPT Team"@en ;
                                dcterms:description "Custom predicates, standards-compliant domain classes, and named role individuals for battery materials, crystallography, DFT properties, crystal connectivity, reified bond entities, battery components, and a locally-defined cathode/electrolyte crystal-structure-family taxonomy (verified to have no equivalent upstream in EMMO core, EMMO domain-battery, EMMO domain-electrochemistry, EMMO domain-chemical-substance, or EMMO's work-in-progress domain-crystallography). v0.3.0 additionally imports EMMO domain-electrochemistry explicitly (previously only reachable transitively through domain-battery) and aligns BattGPT's battery-role classes to it via skos:closeMatch."@en ;
                                dcterms:isVersionOf <https://w3id.org/battgpt/kg#> ;
                                dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                dcterms:title "BattGPT Battery Materials Knowledge Graph Predicate & Extension Ontology"@en ;
                                vann:preferredNamespacePrefix "battgpt" ;
                                vann:preferredNamespaceUri "https://w3id.org/battgpt/kg#" ;
                                rdfs:comment "Contains ObjectProperty, DatatypeProperty, SubClass, and NamedIndividual definitions extending EMMO and BattINFO. Changes in v0.3.0 relative to v0.2.2: (1) explicit owl:imports of EMMO domain-electrochemistry, plus skos:closeMatch from PositiveElectrodeRole/NegativeElectrodeRole/ElectrolyteRole/SeparatorRole to the matching electrochemistry: classes; (2) battery-cell-level electrochemical-quantity properties (hasCapacity, hasSpecificCapacity, hasIonicConductivity, hasOpenCircuitVoltage, hasCRate, hasCoulombicEfficiency, hasStateOfCharge, hasVoltage), all reusing existing EMMO domain-electrochemistry/EMMO-core range classes rather than redefining them; (3) a new StructureFamily taxonomy (StructureFamily / OxideStructureFamily / PolyanionStructureFamily / SulfideStructureFamily and their leaf structure-type classes) plus hasStructureFamily, filling the one gap confirmed absent from the whole imported EMMO/BattINFO closure; (4) a dedicated CoordinationGeometry class so hasCoordinationGeometry no longer shares its range with CrystalSystem/SpaceGroup's generic emmo:Property ancestor; (5) hasBondTo is now formally derived via an owl:propertyChainAxiom (hasBond o hasTargetSite) instead of being a second, independently-asserted fact that could drift from the reified CrystalBond; (6) belongsToElectrode's range is tightened to the union of PositiveElectrodeRole/NegativeElectrodeRole (usesMaterial, its inverse, is left general over all BatteryRole subclasses); (7) BulkModulusProperty/ShearModulusProperty are re-anchored under emmo:Pressure instead of the generic emmo:PhysicalQuantity; (8) CrystalStructure, Site, and UnitCell get explicit grounding (CrystalStructure under owl:Thing like its siblings; Site requires hasSpecies some Species; UnitCell requires hasSite some Site)."@en ;
                                owl:priorVersion <https://w3id.org/battgpt/kg/0.2.2/battgpt> ;
                                owl:versionInfo "0.3.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/isVersionOf
dcterms:isVersionOf rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


#################################################################
#    NOTE for pipeline authors: properties reused directly from
#    EMMO domain-electrochemistry (not redefined locally — use
#    these exact IRIs when populating battery-cell composition):
#
#      electro:electrochemistry_860aa941_5ff9_4452_8a16_7856fad07bee  (hasActiveMaterial)
#      electro:electrochemistry_8e9cf965_9f92_46e8_b678_b50410ce3616  (hasPositiveElectrode)
#      electro:electrochemistry_5d299271_3f68_494f_ab96_3db9acdd3138  (hasNegativeElectrode)
#      electro:electrochemistry_3bd08946_4e81_455d_9fca_dc7a5ead9315  (hasElectrolyte)
#      electro:electrochemistry_9317be62_e602_4343_a72d_02c87201b9f6  (hasSeparator)
#
#    battery:battery_68ed592a_7924_45d0_a108_94d6275d57f0 is
#    EMMO domain-battery's BatteryCell class, reused below as the
#    domain of the new hasCapacity/hasVoltage/etc. properties
#    instead of introducing a local battgpt:BatteryCell.
#################################################################

#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/battgpt/kg#belongsToElectrode
battgpt:belongsToElectrode rdf:type owl:ObjectProperty ;
                           owl:inverseOf battgpt:usesMaterial ;
                           rdfs:domain emmo:EMMO_df96cbb6_b5ee_4222_8eab_b3675df24bea ;
                           rdfs:range [ rdf:type owl:Class ;
                                        owl:unionOf ( battgpt:PositiveElectrodeRole battgpt:NegativeElectrodeRole )
                                      ] ;
                           rdfs:comment "Relates a material to the specific electrode role (positive or negative) it plays. Range tightened (v0.3.0) to the union of the two electrode-role classes so it can no longer point at ElectrolyteRoleIndividual/SeparatorRoleIndividual, which the property's name never intended. usesMaterial, its inverse, is left general over all four BatteryRole subclasses."@en ;
                           rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                           rdfs:label "belongsToElectrode"@en ;
                           skos:prefLabel "belongsToElectrode"@en .


###  https://w3id.org/battgpt/kg#hasSite
battgpt:hasSite rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f ;
                     rdfs:domain battgpt:UnitCell ;
                     rdfs:range battgpt:Site ;
                     rdfs:comment "Relates a unit cell to an atomic coordinate site located within its bounds."@en ;
                     rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                     rdfs:label "hasSite"@en ;
                     skos:prefLabel "hasSite"@en .


###  https://w3id.org/battgpt/kg#hasSpecies
battgpt:hasSpecies rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf emmo:EMMO_dba27ca1_33c9_4443_a912_1519ce4c39ec ;
                        rdfs:domain battgpt:Site ;
                        rdfs:range battgpt:Species ;
                        rdfs:comment "Relates an atomic site to the chemical atomic species occupying that site."@en ;
                        rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                        rdfs:label "hasSpecies"@en ;
                        skos:prefLabel "hasSpecies"@en .


###  https://w3id.org/battgpt/kg#hasBandGap
battgpt:hasBandGap rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                   rdfs:domain emmo:EMMO_df96cbb6_b5ee_4222_8eab_b3675df24bea ;
                   rdfs:range battgpt:BandGapProperty ;
                   rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                   rdfs:label "hasBandGap"@en ;
                   skos:prefLabel "hasBandGap"@en .


###  https://w3id.org/battgpt/kg#hasBond
battgpt:hasBond rdf:type owl:ObjectProperty ;
                rdfs:domain battgpt:Site ;
                rdfs:range battgpt:CrystalBond ;
                rdfs:comment "Relates an atomic site to a reified crystal bond entity."@en ;
                rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                rdfs:label "hasBond"@en ;
                skos:prefLabel "hasBond"@en .


###  https://w3id.org/battgpt/kg#hasBondTo
battgpt:hasBondTo rdf:type owl:ObjectProperty ;
                  rdfs:domain battgpt:Site ;
                  rdfs:range battgpt:Site ;
                  owl:propertyChainAxiom ( battgpt:hasBond battgpt:hasTargetSite ) ;
                  rdfs:comment "Directed crystal-connectivity edge from one atomic site to a bonded neighbour site. As of v0.3.0 this is formally derived via the property chain hasBond o hasTargetSite, so a reasoner infers it from the reified CrystalBond rather than it needing to be separately asserted and kept in sync during graph population."@en ;
                  rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                  rdfs:label "hasBondTo"@en ;
                  skos:prefLabel "hasBondTo"@en .


###  https://w3id.org/battgpt/kg#hasBulkModulus
battgpt:hasBulkModulus rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                       rdfs:domain emmo:EMMO_df96cbb6_b5ee_4222_8eab_b3675df24bea ;
                       rdfs:range battgpt:BulkModulusProperty ;
                       rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                       rdfs:label "hasBulkModulus"@en ;
                       skos:prefLabel "hasBulkModulus"@en .


###  https://w3id.org/battgpt/kg#hasCoordinationGeometry
battgpt:hasCoordinationGeometry rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                                rdfs:domain battgpt:Site ;
                                rdfs:range battgpt:CoordinationGeometry ;
                                rdfs:comment "Relates an atomic site to its local coordination-geometry classification (e.g. octahedral, tetrahedral, square-planar). Range changed (v0.3.0) from the generic emmo:Property class to the new battgpt:CoordinationGeometry class."@en ;
                                rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                                rdfs:label "hasCoordinationGeometry"@en ;
                                skos:prefLabel "hasCoordinationGeometry"@en .


###  https://w3id.org/battgpt/kg#hasCrystalSystem
battgpt:hasCrystalSystem rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf emmo:EMMO_e1097637_70d2_4895_973f_2396f04fa204 ;
                         rdfs:domain battgpt:CrystalStructure ;
                         rdfs:range battgpt:CrystalSystem ;
                         rdfs:comment "Relates a crystal structure to its crystal system family."@en ;
                         rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                         rdfs:label "hasCrystalSystem"@en ;
                         skos:prefLabel "hasCrystalSystem"@en .


