#################################################################

###  https://w3id.org/battgpt/kg#BandGapProperty
battgpt:BandGapProperty rdf:type owl:Class ;
                        rdfs:subClassOf emmo:EMMO_31ec09ba_1713_42cb_83c7_b38bf6f9ced2 ;
                        rdfs:comment "Represents the electronic band gap associated with a material, typically obtained from an electronic-structure calculation or experimental determination."@en ;
                        rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                        rdfs:label "BandGapProperty"@en ;
                        skos:prefLabel "BandGapProperty"@en .


###  https://w3id.org/battgpt/kg#BulkModulusProperty
battgpt:BulkModulusProperty rdf:type owl:Class ;
                            rdfs:subClassOf emmo:EMMO_50a44256_9dc5_434b_bad4_74a4d9a29989 ;
                            rdfs:comment "Represents the bulk elastic modulus of a material under pressure. Re-anchored (v0.3.0) under emmo:Pressure rather than the generic emmo:PhysicalQuantity used previously, since EMMO defines a dedicated Pressure class and bulk modulus is pressure-dimensioned."@en ;
                            rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                            rdfs:label "BulkModulusProperty"@en ;
                            skos:prefLabel "BulkModulusProperty"@en .


###  https://w3id.org/battgpt/kg#EnergyAboveHullProperty
battgpt:EnergyAboveHullProperty rdf:type owl:Class ;
                                rdfs:subClassOf emmo:EMMO_31ec09ba_1713_42cb_83c7_b38bf6f9ced2 ;
                                rdfs:comment "Represents the energy above the thermodynamic convex hull associated with a material and computational dataset."@en ;
                                rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                                rdfs:label "EnergyAboveHullProperty"@en ;
                                skos:prefLabel "EnergyAboveHullProperty"@en .


###  https://w3id.org/battgpt/kg#FormationEnergyProperty
