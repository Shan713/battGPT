                                rdfs:subClassOf emmo:EMMO_31ec09ba_1713_42cb_83c7_b38bf6f9ced2 ;
                                rdfs:comment "Represents the calculated formation energy associated with a material under a specified computational methodology."@en ;
                                rdfs:isDefinedBy <https://w3id.org/battgpt/kg#> ;
                                rdfs:label "FormationEnergyProperty"@en ;
                                skos:prefLabel "FormationEnergyProperty"@en .


